hd Настройка VLAN-интерфейсов
hd Создание VLAN-интерфейса                                                                 
ne Создание каталога VLAN-интерфейса                                                        
ce mkdir -p /etc/net/ifaces/ens32.100                                                       
ct Формат: физический_интерфейс.номер_VLAN                                                  

ne Настройка параметров в /etc/net/ifaces/ens32.100/options                                 
ce TYPE=vlan                                                                                
CONFIG_IPV4=yes                                                                             
BOOTPROTO=static                                                                            
VID=100                                                                                     
HOST=ens32                                                                                  
ct TYPE=vlan(тип интерфейса VLAN); VID(идентификатор VLAN); HOST(физический интерфейс);     
BOOTPROTO(протокол получения IP) {static, dhcp}; HOST(для нескольких интерфейсов) 'ens32    
ens33'                                                                                      

ne Настройка IP-адреса в /etc/net/ifaces/ens32.100/ipv4address                              
ce 192.168.11.67/24

ne Применение изменений                                                                     
ce systemctl restart network                                                                

hd Ручное управление VLAN                                                                   
ne Запуск VLAN-интерфейса                                                                   
ce ifup ens32.100                                                                           

ne Остановка VLAN-интерфейса                                                                
ce ifdown ens32.100                                                                         

hd Проверка VLAN                                                                            
ne Просмотр интерфейсов                                                                     
ce ip a                                                                                     
