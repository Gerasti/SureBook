hd Установка                                                                         
  ne Создание RAID-массива                                                             
  ce mdadm --create --verbose /dev/md0 --level=5 --raid-devices=3 /dev/sdb /dev/sdc    
  /dev/sdd                                                                             
  ct /dev/md0 (имя массива); --level=5 (уровень RAID {0, 1, 4, 5, 6, 10});             
  --raid-devices=3 (количество дисков); /dev/sdb /dev/sdc /dev/sdd (список дисков)     
  ne Создание файловой системы
  ce mkfs.ext4 /dev/md0                                                                
  ct Форматирование массива в ext4 {xfs, btrfs}                                        
  ne Создание точки монтирования                                                       
  ce mkdir /mnt/raid5                                                                  
  ne Монтирование массива                                                              
  ce mount /dev/md0 /mnt/raid5                                                         
                                                                                       
  hd Настройка                                                                         
  ne В /etc/fstab добавить строку                                                      
  ce /dev/md0   /mnt/raid5   ext4   defaults   0 0                                     
  ct Автоматическое монтирование при загрузке                                          
  ne Сохранение конфигурации mdadm                                                     
  ce mdadm --detail --scan >> /etc/mdadm.conf                                          
  ct Сохраняет информацию о массиве для автосборки                                     
                                                                                       
  hd Проверка                                                                          
  ne Проверка состояния RAID                                                           
  ce cat /proc/mdstat                                                                  
  ct Краткая информация о всех массивах                                                
  ne Детальная информация о массиве                                                    
  ce mdadm --detail /dev/md0                                                           
  ct Показывает состояние дисков, уровень RAID, размер
