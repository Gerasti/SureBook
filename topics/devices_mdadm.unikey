hd Основные уровни RAID                                                                     
ne Сравнение уровней RAID
ct RAID 0(striping, высокая скорость, нет отказоустойчивости, минимум 2 диска, объём = сумма
дисков); RAID 1(mirroring, отказ 1 диска, минимум 2 диска, объём = размер 1 диска); RAID   
5(striping+parity, отказ 1 диска, минимум 3 диска, объём = (N-1)×диск); RAID 6(double
parity, отказ 2 диска, минимум 4 диска, объём = (N-2)×диск); RAID 10(mirror+stripe, высокая 
отказоустойчивость, минимум 4 диска, объём = 50%)
ct Программный RAID(реализован на уровне ОС, использует CPU) vs Аппаратный RAID(реализован
контроллером, имеет собственный процессор)                                                  

hd Установка mdadm                                                                          
ne Установка утилиты mdadm
ce apt-get install -y mdadm                                                                 
ct mdadm(Multiple Device Administration, утилита для управления программными RAID-массивами 
в Linux); -y(автоматическое подтверждение установки)                                        

hd Создание RAID массивов                                                                   
ne Создание RAID 0 массива
ce mdadm --create --verbose /dev/md0 --level=0 --raid-devices=2 /dev/sdb /dev/sdc           
ct --create(создать новый массив); --verbose(подробный вывод); /dev/md0(имя создаваемого    
RAID-устройства); --level(уровень RAID: {0, 1, 4, 5, 6, 10}); --raid-devices(количество     
активных дисков в массиве); /dev/sdb /dev/sdc(список физических дисков)                     

ne Создание RAID 1 массива                                                                  
ce mdadm --create --verbose /dev/md0 --level=1 --raid-devices=2 /dev/sdb /dev/sdc

ne Создание RAID 4 массива                                                                  
ce mdadm --create --verbose /dev/md0 --level=4 --raid-devices=3 /dev/sdb /dev/sdc /dev/sdd
ct RAID 2(bit-level striping with Hamming code) и RAID 3(byte-level striping) устарели и не 
поддерживаются mdadm                                                                        

ne Создание RAID 5 массива                                                                  
ce mdadm --create --verbose /dev/md0 --level=5 --raid-devices=3 /dev/sdb /dev/sdc /dev/sdd

ne Создание RAID 6 массива
ce mdadm --create --verbose /dev/md0 --level=6 --raid-devices=4 /dev/sdb /dev/sdc /dev/sdd
/dev/sde                                                                                    

ne Создание RAID 10 массива                                                                 
ce mdadm --create --verbose /dev/md0 --level=10 --raid-devices=4 /dev/sdb /dev/sdc /dev/sdd
/dev/sde                                                                                    

ne Создание массива с spare диском                                                          
ce mdadm --create --verbose /dev/md0 --level=5 --raid-devices=3 --spare-devices=1 /dev/sdb
/dev/sdc /dev/sdd /dev/sde                                                                  
ct --spare-devices(количество резервных дисков); spare(горячий резерв) - диск автоматически
заменит отказавший и начнёт процесс rebuild                                                 

hd Настройка массива                                                                        
ne Создание файловой системы на массиве
ce mkfs.ext4 /dev/md0                                                                       
ct mkfs(make filesystem, создание файловой системы); форматы: {ext4, xfs, btrfs}            

ne Создание точки монтирования                                                              
ce mkdir /mnt/raid                                                                          

ne Монтирование массива                                                                     
ce mount /dev/md0 /mnt/raid                                                                 

ne Добавление в /etc/fstab для автомонтирования                                             
ce /dev/md0   /mnt/raid   ext4   defaults   0 0                                             
ct /dev/md0(устройство); /mnt/raid(точка монтирования); ext4(тип ФС); defaults(опции по     
умолчанию: rw,suid,dev,exec,auto,nouser,async); первый 0(dump, не создавать резервные       
копии); второй 0(fsck, не проверять ФС при загрузке)                                        

hd Настройка mdadm.conf                                                                     
ne Сохранение конфигурации массива
ce mdadm --detail --scan >> /etc/mdadm.conf                                                 
ct --detail(детальная информация о массиве); --scan(сканировать все массивы); >>(добавить в 
конец файла); создаёт строку ARRAY с UUID, уровнем и метаданными массива                    

ne Пример строки ARRAY в mdadm.conf                                                         
ce ARRAY /dev/md0 metadata=1.2 name=hostname:0 UUID=12345678:abcdefgh:12345678:abcdefgh     
ct ARRAY(определение массива); /dev/md0(имя устройства); metadata(версия метаданных: {0.90, 
1.0, 1.1, 1.2}); name(имя массива hostname:номер); UUID(уникальный идентификатор массива)   

ne Добавление параметров устройств в mdadm.conf                                             
ce DEVICE /dev/sdb /dev/sdc /dev/sdd /dev/sde
ct DEVICE(список физических дисков для поиска массивов); можно использовать wildcards:      
/dev/sd*                                                                                    

ne Настройка email-уведомлений в mdadm.conf                                                 
ce MAILADDR admin@example.com
MAILFROM mdadm@server.local                                                                 
ct MAILADDR(адрес для отправки уведомлений о проблемах с массивом); MAILFROM(адрес          
отправителя)                                                                                

ne Настройка программы мониторинга в mdadm.conf                                             
ce PROGRAM /usr/local/bin/raid-notify.sh
ct PROGRAM(скрипт, который будет выполнен при событии с массивом); получает параметры:      
событие и устройство                                                                        

ne Ручное редактирование mdadm.conf                                                         
ce nano /etc/mdadm.conf
ct Файл можно редактировать вручную для тонкой настройки параметров                         

ne Применение изменений из mdadm.conf                                                       
ce mdadm --assemble --scan                                                                  
ct --assemble(собрать массивы); --scan(использовать конфигурацию из /etc/mdadm.conf)        

ne Обновление конфигурации после изменения массива                                          
ce mdadm --detail --scan > /etc/mdadm.conf.new                                              
mv /etc/mdadm.conf.new /etc/mdadm.conf                                                      
ct Перезапись файла с актуальной конфигурацией всех массивов                                

ne Резервное копирование mdadm.conf                                                         
ce cp /etc/mdadm.conf /etc/mdadm.conf.backup                                                
ct Сохранение копии перед внесением изменений                                               

ne Добавление spare диска в существующий массив                                             
ce mdadm --add /dev/md0 /dev/sde                                                            
ct --add(добавить диск в массив как горячий резерв)                                         

hd Управление массивом                                                                      
ne Остановка массива                                                                        
ce mdadm --stop /dev/md0                                                                    
ct --stop(остановить массив); необходимо размонтировать перед остановкой                    

ne Запуск массива                                                                           
ce mdadm --assemble /dev/md0 /dev/sdb /dev/sdc /dev/sdd                                     
ct --assemble(собрать массив из указанных дисков)

ne Автоматическая сборка всех массивов из mdadm.conf
ce mdadm --assemble --scan
ct Собирает все массивы, описанные в /etc/mdadm.conf

ne Пометка диска как отказавшего                                                            
ce mdadm --fail /dev/md0 /dev/sdc                                                           
ct --fail(пометить диск как failed); для имитации отказа при тестировании                   

ne Удаление диска из массива                                                                
ce mdadm --remove /dev/md0 /dev/sdc                                                         
ct --remove(удалить диск из массива); диск должен быть помечен как failed                   

ne Добавление нового диска взамен отказавшего                                               
ce mdadm --add /dev/md0 /dev/sde                                                            
ct Автоматически начнётся процесс rebuild (восстановление данных на новом диске)            

ne Увеличение количества дисков в массиве                                                   
ce mdadm --grow /dev/md0 --raid-devices=4 --add /dev/sde                                    
ct --grow(изменить параметры массива); расширение с пересчётом данных                       

ne Изменение уровня RAID                                                                    
ce mdadm --grow /dev/md0 --level=6                                                          
ct Преобразование массива (например RAID 5 в RAID 6), требует времени на пересчёт           

hd Проверка состояния                                                                       
ne Проверка состояния всех RAID массивов                                                    
ce cat /proc/mdstat                                                                         
ct Краткая информация: состояние, прогресс rebuild/resync, активные/отказавшие диски

ne Детальная информация о массиве                                                           
ce mdadm --detail /dev/md0                                                                  
ct Показывает уровень RAID, состояние дисков, размер, UUID                                  

ne Проверка информации о диске в массиве                                                    
ce mdadm --examine /dev/sdb                                                                 
ct --examine(прочитать метаданные RAID на диске); показывает UUID массива, уровень RAID,    
роль диска                                                                                  

ne Мониторинг состояния массива                                                             
ce mdadm --monitor --scan --daemonise
ct --monitor(режим мониторинга); --daemonise(запустить как демон); отправляет уведомления об
ошибках                                                                                    

ne Проверка скорости rebuild                                                                
ce cat /proc/sys/dev/raid/speed_limit_min
cat /proc/sys/dev/raid/speed_limit_max                                                      
ct Показывает минимальную и максимальную скорость восстановления в KB/s                     

ne Изменение скорости rebuild                                                               
ce echo 50000 > /proc/sys/dev/raid/speed_limit_min                                          
echo 200000 > /proc/sys/dev/raid/speed_limit_max                                            
ct Значения в KB/s; низкая скорость снижает нагрузку, высокая ускоряет восстановление       

ne Проверка целостности массива                                                             
ce echo check > /sys/block/md0/md/sync_action                                               
ct Запуск проверки целостности без исправления ошибок                                       

ne Восстановление с исправлением ошибок                                                     
ce echo repair > /sys/block/md0/md/sync_action                                              
ct Проверка и автоматическое исправление несоответствий в данных                            

ne Просмотр прогресса проверки                                                              
ce cat /proc/mdstat                                                                         
ct Показывает прогресс операций check/repair/rebuild в процентах                            

hd Удаление массива                                                                         
ne Размонтирование массива                                                                  
ce umount /mnt/raid                                                                         

ne Остановка массива                                                                        
ce mdadm --stop /dev/md0                                                                    

ne Удаление метаданных RAID с дисков                                                        
ce mdadm --zero-superblock /dev/sdb /dev/sdc /dev/sdd                                       
ct --zero-superblock(обнулить суперблок RAID); полное удаление информации о RAID с дисков   

ne Удаление записи из /etc/fstab                                                            
ce sed -i '/\/dev\/md0/d' /etc/fstab                                                        
ct sed -i(редактировать файл на месте); /d(удалить строку)                                  

ne Удаление записи из /etc/mdadm.conf                                                       
ce sed -i '/\/dev\/md0/d' /etc/mdadm.conf                                                   
ct Удаление конфигурации массива из файла   
