hd Установка                                                                                

ne Установка sudo                                                                           
ce apt-get install sudo
ct sudo(выполнение команд от имени другого пользователя, обычно root)

hd Создание пользователя                                                                    

ne Создание пользователя с параметрами                                                      
ce useradd -m -g users -G wheel -s /bin/bash username
ct -m(создать домашний каталог); -g(основная группа); -G(дополнительные группы); -s(оболочка
по умолчанию /bin/bash)                                                                    

ne Создание пользователя с указанным UID                                                    
ce useradd -u 2026 -m -g users -G wheel username
ct -u(указать конкретный UID)                                                               

ne Установка пароля пользователю                                                            
ce passwd username                                                                          

ne Создание пользователя интерактивно                                                       
ce adduser username                                                                         
ct Либо интерактивный режим с запросом всех параметров                                           

hd Настройка sudo                                                                           

ne Основной конфигурационный файл                                                           
ce /etc/sudoers 

ne Редактирование конфигурации sudo                                                         
ce visudo                                                                                   
ct Безопасное редактирование /etc/sudoers с проверкой синтаксиса                            

ne Предоставление sudo группе wheel                                                         
ce %wheel ALL=(ALL:ALL) ALL                                                                 
ct Пользователи группы wheel могут выполнять любые команды через sudo с вводом пароля       

ne Предоставление sudo без пароля группе wheel                                              
ce %wheel ALL=(ALL:ALL) NOPASSWD: ALL                                                       
ct Пользователи группы wheel могут выполнять sudo без ввода пароля                          

ne Предоставление sudo конкретному пользователю                                             
ce username ALL=(ALL:ALL) ALL                                                               
ct Конкретный пользователь может выполнять любые команды через sudo                         

ne Предоставление sudo для конкретных команд                                                
ce username ALL=(ALL) /usr/bin/systemctl, /usr/bin/apt-get                                  
ct Пользователь может выполнять только указанные команды через sudo                         

ne Добавление пользователя в группу wheel                                                   
ce usermod -aG wheel username                                                               
ct -aG(добавить в дополнительные группы, не удаляя из существующих)                         

hd Управление пользователями                                                                

ne Изменение оболочки пользователя                                                          
ce usermod -s /bin/bash username
ct -s(изменить оболочку по умолчанию)                                                       

ne Изменение домашнего каталога                                                             
ce usermod -d /home/newdir username                                                         
ct -d(изменить домашний каталог)                                                            

ne Блокировка пользователя                                                                  
ce usermod -L username                                                                      
ct -L(заблокировать учётную запись, запретить вход)                                         

ne Разблокировка пользователя                                                               
ce usermod -U username                                                                      
ct -U(разблокировать учётную запись)                                                        

ne Удаление пользователя                                                                    
ce userdel username                                                                         
ct Удаляет пользователя, но сохраняет домашний каталог                                      

ne Удаление пользователя с домашним каталогом                                               
ce userdel -r username                                                                      
ct -r(удалить вместе с домашним каталогом)                                                  

ne Просмотр групп пользователя                                                              
ce groups username                                                                          
ct Показывает все группы пользователя                                                       

ne Просмотр информации о пользователе                                                       
ce id username                                                                              
ct Показывает UID, GID и группы пользователя                                                

hd Проверка                                                                                 

ne Проверка sudo                                                                            
ce sudo whoami  
ct Результат: root                                                                          

ne Проверка выполнения команды от другого пользователя                                      
ce sudo -u username whoami                                                                  
ct -u(выполнить от имени указанного пользователя), результат: username                      

ne Просмотр прав sudo текущего пользователя                                                 
ce sudo -l                                                                                  
ct Показывает какие команды может выполнять пользователь через sudo                         

ne Просмотр истории sudo                                                                    
ce journalctl -u sudo                                                                       
ct Показывает логи выполнения команд через sudo                                             

ne Просмотр всех пользователей системы                                                      
ce cat /etc/passwd                                                                          
ct Список всех пользователей с их параметрами                                               

ne Просмотр всех групп системы                                                              
ce cat /etc/group                                                                           
ct Список всех групп и их членов
