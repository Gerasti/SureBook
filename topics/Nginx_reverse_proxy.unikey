hd Установка                                                                                
  ne Установка nginx                                                                          
  ce apt-get install nginx                                                                    
  ne Включение автозапуска
  ce systemctl enable --now nginx                                                             
                                                                                              
  hd Настройка обратного прокси
  ct Для настройки необходима ip-адресация и работа DNS(или hosts)
  ne Создание файла конфигурации                                                              
  ce nano /etc/nginx/sites-available.d/some.domain.conf                                       
                                                                                              
  ne Базовая конфигурация обратного прокси                                                    
  ce server {                                                                                 
      listen 80;                                                                              
      server_name some.domain;                                                                
                                                                                              
  location / {                                                                                
      proxy_pass http://10.0.0.10:8080;                                                       
      proxy_http_version 1.1;                                                                 
                                                                                              
      proxy_set_header Host $host;                                                            
      proxy_set_header X-Real-IP $remote_addr;                                                
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;                            
      proxy_set_header X-Forwarded-Proto $scheme;                                             
      proxy_set_header Connection "";                                                         
  }                                                                                           
  }                                                                                           
  ct listen(порт прослушивания); server_name(имя виртуального хоста); location(обработка      
  запросов к корню)                                                                           
  ct proxy_pass(адрес внутреннего веб-приложения); proxy_http_version(версия HTTP-протокола)  
  ct proxy_set_header Host(передача оригинального заголовка Host); X-Real-IP(реальный IP    
  клиента)                                                                                    
  ct X-Forwarded-For(цепочка IP-адресов); X-Forwarded-Proto(протокол http или https);         
  Connection(управление соединением)                                                          
                                                                                              
  ne Конфигурация для нескольких приложений
  ce server {                                                                                 
      listen 80;  
      server_name app1.some.domain;                                                           
                                                                                              
  location / {                                                                                
      proxy_pass http://10.0.0.10:8080;                                                       
      proxy_http_version 1.1;                                                                 
                                                                                              
      proxy_set_header Host $host;                                                            
      proxy_set_header X-Real-IP $remote_addr;                                                
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;                            
      proxy_set_header X-Forwarded-Proto $scheme;                                             
  }                                                                                           
  }                                                                                           
                                                                                              
  server {        
      listen 80;                                                                              
      server_name app2.some.domain;                                                           
                                                                                              
  location / {                                                                                
      proxy_pass http://10.0.0.20:8080;                                                       
      proxy_http_version 1.1;                                                                 
                                                                                              
      proxy_set_header Host $host;                                                            
      proxy_set_header X-Real-IP $remote_addr;                                                
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;                            
      proxy_set_header X-Forwarded-Proto $scheme;                                             
  }                                                                                           
  }                                                                                           
  ct app1.some.domain перенаправляет на 10.0.0.10:8080; app2.some.domain перенаправляет на    
  10.0.0.20:8080                                                                              
                                                                                              
  ne Конфигурация с SSL-сертификатом
  ce server {                                                                                 
      listen 443 ssl;
      server_name some.domain;                                                                
                                                                                              
  ssl_certificate /etc/letsencrypt/some.domain/cert.cer;                                      
  ssl_certificate_key /etc/letsencrypt/some.domain/cert.key;                                  
  ssl_protocols TLSv1.2 TLSv1.3;                                                              
  ssl_prefer_server_ciphers on;                                                               
                                                                                              
  location / {                                                                                
      proxy_pass http://10.0.0.10:8080;                                                       
      proxy_set_header Host $host;                                                            
      proxy_set_header X-Real-IP $remote_addr;                                                
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;                            
      proxy_set_header X-Forwarded-Proto $scheme;                                             
  }                                                                                           
  }                                                                                           
  ct listen 443 ssl(прослушивание порта 443 с поддержкой SSL/TLS)                             
  ct ssl_certificate(путь к SSL-сертификату); ssl_certificate_key(путь к приватному ключу)
  ct ssl_protocols(разрешенные версии TLS); ssl_prefer_server_ciphers(приоритет шифров        
  сервера)                                                                                    
                                                                                              
  ne Конфигурация с таймаутами                                                                
  ce server {                                                                                 
      listen 80;  
      server_name some.domain;                                                                
                                                                                              
  location / {                                                                                
      proxy_pass http://10.0.0.10:8080;                                                       
      proxy_http_version 1.1;                                                                 
                                                                                              
      proxy_set_header Host $host;                                                            
      proxy_set_header X-Real-IP $remote_addr;                                                
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;                            
      proxy_set_header X-Forwarded-Proto $scheme;                                             
                                                                                              
      proxy_connect_timeout 5s;                                                               
      proxy_send_timeout 30s;                                                                 
      proxy_read_timeout 30s;                                                                 
  }                                                                                           
  }                                                                                           
  ct proxy_connect_timeout(время ожидания подключения к backend); proxy_send_timeout(время    
  отправки запроса)                                                                       
  ct proxy_read_timeout(время ожидания ответа от backend)                                     
                                                         
  ne Создание символической ссылки                                                            
  ce ln -s /etc/nginx/sites-available.d/some.domain.conf /etc/nginx/sites-enabled.d/          
  hd Проверка                                                                                 
  ne Проверка синтаксиса конфигурации                                                         
  ce nginx -t                                                                                 
                                                                                              
  ne Применение настроек                                                                      
  ce systemctl restart nginx                                                                  
  ct можно использовать systemctl reload nginx                                                
                                                                                              
  ne Проверка открытых портов                                                                 
  ce ss -tulpn | grep nginx                                                                   
                                                                                              
  ne Проверка доступности backend-сервера                                                     
  ce curl -I http://10.0.0.10:8080                                                            
                                                                                              
  ne Просмотр логов nginx                                                                     
  ce journalctl -u nginx --no-pager
