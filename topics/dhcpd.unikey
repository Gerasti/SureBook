hd Установка DHCP-сервера
  ne Установка пакета
  ce apt-get install dhcp-server                                                              
                                                                                              
  ne Определение сетевого интерфейса                                                          
  ce ip a -c                                                                                  
                                                                                              
  ne Настройка интерфейса в /etc/sysconfig/dhcpd                                              
  ce DHCPDARGS=ens34                                                                          
  ct Указывает интерфейс, который будет раздавать IP-адреса                                   
                                                                                              
  hd Настройка DHCP-сервера                                                                   
  ne Основная конфигурация в /etc/dhcp/dhcpd.conf                                             
  ce ddns-update-style none;                                                                  
                                                                                              
  subnet 192.168.11.0 netmask 255.255.255.192 {                                               
          option routers                  192.168.11.1;                                       
          option domain-name              "bind.domain";                                      
          option domain-name-servers      77.88.8.8,192.168.11.1;                             
                                                                                              
          range dynamic-bootp 192.168.11.2 192.168.11.63;                                     
          default-lease-time 21600;                                                           
          max-lease-time 43200;                                                               
                                                                                              
  host R-HQ {                                                                                 
          hardware ethernet 00:0c:29:41:f2:9f;                                                
          fixed-address 192.168.11.1;                                                         
  }                                                                                           
  }                                                                                           
  ct subnet(определение подсети); range(диапазон выдаваемых адресов); option routers(шлюз по  
  умолчанию); option domain-name-servers(DNS-серверы); default-lease-time(время аренды по     
  умолчанию в секундах); max-lease-time(максимальное время аренды); host(резервирование IP по
  MAC-адресу)                                                                                 
                  
  ne Проверка конфигурации                                                                    
  ce dhcpd -t -cf /etc/dhcp/dhcpd.conf
                                                                                              
  ne Запуск и включение службы                                                                
  ce systemctl enable --now dhcpd                                                             
                                                                                              
  hd Проверка DHCP-сервера                                                                    
  ne Проверка статуса службы                                                                  
  ce systemctl status dhcpd                                                                   
                                                                                              
  hd Настройка DHCP-клиента                                                                   
  ne Получение IP-адреса от DHCP-сервера                                                      
  ce dhcpcd                                                                                   
  ct Клиент получит IP-адрес, шлюз и DNS-серверы из конфигурации сервера
