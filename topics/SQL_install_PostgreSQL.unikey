 hd Установка                                                                                
  ne Установка пакетов
  ce apt-get install -y postgresql16 postgresql16-server postgresql16-contrib                 
  ct postgresql16-contrib(дополнительные модули и утилиты)

  ne Создание системных БД
  ce /etc/init.d/postgresql initdb
                                                                                              
  ne Запуск службы                                                                            
  ce systemctl enable --now postgresql                                                        
                                                                                              
  ne Установка пароля для пользователя postgres                                               
  ce psql -U postgres                                                                         
  ALTER USER postgres WITH PASSWORD 'P@ssw0rd';                                               
  \q                                                                                          
                                                                                              
  hd Настройка                                                                                
  ne Разрешение доступа из сети в /var/lib/pgsql/data/postgresql.conf                         
  ce listen_addresses = '*'                                                                   
  ct Найти listen_addresses = 'localhost' и заменить на '*'                                   
  ct listen_addresses(адреса для прослушивания) {'*', 'localhost', '192.168.1.1'}             
                                                                                              
  ne Перезапуск службы после изменения postgresql.conf                                        
  ce systemctl restart postgresql                                                             
                                                                                              
  ne Настройка парольной аутентификации в /var/lib/pgsql/data/pg_hba.conf                     
  ce host    all             all             0.0.0.0/0               md5                      
  host    replication     all             0.0.0.0/0               md5                         
  ct Добавить строки в конец файла перед секцией IPv6                                         
  ct host(тип подключения) {host, local, hostssl}                                             
  ct all(база данных) {all, имя_БД}                                                           
  ct all(пользователь) {all, имя_пользователя}                                                
  ct 0.0.0.0/0(IP-адреса клиентов) {0.0.0.0/0, 192.168.1.0/24, конкретный_IP}                 
  ct md5(метод аутентификации) {md5, trust, reject, scram-sha-256}                            
  ct Первая строка для обычных подключений, вторая для репликации                             
                                                                                              
  ne Перезапуск службы после изменения pg_hba.conf                                            
  ce systemctl restart postgresql                                                             
                                                                                              
  ne Создание базы данных и пользователя                                                      
  ce psql -U postgres                                                                         
  CREATE DATABASE db01;                                                                       
  CREATE USER user01 WITH PASSWORD 'P@ssw0rd';
  GRANT ALL PRIVILEGES ON DATABASE db01 TO user01;                                            
  \q                                                                                          
  ct db01(имя создаваемой БД); user01(имя пользователя)                                       
                                                                                              
  ne Создание нескольких баз данных и пользователей                                           
  ce psql -U postgres                                                                         
  CREATE DATABASE one;                                                                        
  CREATE DATABASE two;                                                                        
  CREATE USER oneuser WITH PASSWORD 'P@ssw0rd';                                               
  CREATE USER twouser WITH PASSWORD 'P@ssw0rd';                                               
  GRANT ALL PRIVILEGES ON DATABASE one TO oneuser;                                            
  GRANT ALL PRIVILEGES ON DATABASE two TO twouser;                                            
  \q                                                                                          
                                                                                              
  ne Заполнение базы данных тестовыми данными                                                 
  ce pgbench -U postgres -i one                                                               
  pgbench -U postgres -i two                                                                  
  ct Опционально, для тестирования производительности                                         
                                                                                              
  hd Проверка                                                                                 
  ne Проверка открытого порта PostgreSQL                                                      
  ce ss -tlpn | grep postgres                                                                 
  ct Показывает открытый порт 5432                                                            
                                                                                              
  ne Проверка БД и пользователей на сервере                                                   
  ce psql -U postgres                                                                         
  SELECT datname FROM pg_database;                                                            
  SELECT usename, usesuper, usecreatedb FROM pg_catalog.pg_user;                              
  \q                                                                                          
  ct Показывает список баз данных и пользователей                                             
                                                                                              
  ne Проверка таблиц в базе данных                                                            
  ce psql -U postgres                                                                         
  \c one                                                                                      
  \dt+                                                                                        
  \c two                                                                                      
  \dt+                                                                                        
  \q              
  ct \c(подключение к БД); \dt+(список таблиц с размерами)                                    
                                                                                              
  ne Локальное подключение на клиенте                                                         
  ce psql -U user01 db01                                                                      
  ct Подключение к БД db01 от имени user01                                                    
                                                                                              
  ne Удалённое подключение на клиенте                                                         
  ce psql -U user01 -h IP_сервера -d db01                                                     
  ct -h(хост сервера); -d(имя базы данных)
