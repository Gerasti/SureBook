
[SIZE=4]Настройка VLAN-интерфейсов[/SIZE]

[SIZE=4]Создание VLAN-интерфейса[/SIZE]

[SIZE=3]Создание каталога VLAN-интерфейса[/SIZE]

[CODE]
mkdir -p /etc/net/ifaces/ens32.100                                                       
 
[/CODE]

[QUOTE]
Формат: физический_интерфейс.номер_VLAN
[/QUOTE]

[SIZE=3]Настройка параметров в /etc/net/ifaces/ens32.100/options[/SIZE]

[CODE]
TYPE=vlan                                                                                
  CONFIG_IPV4=yes                                                                             
  BOOTPROTO=static                                                                            
  VID=100                                                                                     
  HOST=ens32                                                                                  
 
[/CODE]

[QUOTE]
TYPE=vlan(тип интерфейса VLAN); VID(идентификатор VLAN); HOST(физический интерфейс); BOOTPROTO(протокол получения IP) {static, dhcp}; HOST(для нескольких интерфейсов) 'ens32 ens33'
[/QUOTE]

[SIZE=3]Настройка IP-адреса в /etc/net/ifaces/ens32.100/ipv4address[/SIZE]

[CODE]
192.168.11.67/24
                                                                                              
 
[/CODE]

[SIZE=3]Применение изменений[/SIZE]

[CODE]
systemctl restart network                                                                
                                                                                              
 
[/CODE]

[SIZE=4]Ручное управление VLAN[/SIZE]

[SIZE=3]Запуск VLAN-интерфейса[/SIZE]

[CODE]
ifup ens32.100                                                                           
                                                                                              
 
[/CODE]

[SIZE=3]Остановка VLAN-интерфейса[/SIZE]

[CODE]
ifdown ens32.100                                                                         
                                                                                              
 
[/CODE]

[SIZE=4]Проверка VLAN[/SIZE]

[SIZE=3]Просмотр интерфейсов[/SIZE]

[CODE]
ip a                                                                                     
[/CODE]
