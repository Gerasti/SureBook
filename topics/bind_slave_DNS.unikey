hd Настройка slave DNS-сервера                                                              
ne Установка пакетов                                                                        
ce apt-get update && apt-get install -y bind bind-utils                                     

ne Базовые параметры в /etc/bind/options.conf                                               
ce listen-on { any; };                                                                      
allow-query { any; };                                                                       
allow-transfer { none; };                                                                   

ne Настройка slave-зон в /etc/bind/local.conf                                               
ce zone "bind.domain" {                                                                     
type slave;                                                                             
file "slave/bind.domain";                                                               
masters { 192.168.11.67; };                                                             
};                                                                                          

zone "11.168.192.in-addr.arpa" {                                                            
type slave; 
file "slave/11.168.192.in-addr.arpa.db";                                                
masters { 192.168.11.67; };                                                             
};                                                                                          

zone "33.168.192.in-addr.arpa" {                                                            
type slave;                                                                             
file "slave/33.168.192.in-addr.arpa.db";                                                
masters { 192.168.11.67; };                                                             
};                                                                                          
ct type slave(вторичный сервер); masters(IP master-сервера для синхронизации)               

ne Содержимое /etc/net/ifaces/ens33/resolv.conf                                             
ce search bind.domain                                                                       
nameserver 192.168.11.67                                                                    
nameserver 192.168.33.67                                                                    
nameserver 8.8.8.8                                                                          

ne Перезапуск сети и запуск BIND                                                            
ce systemctl restart network                                                                
systemctl enable --now bind                                                                 

ne Включение slave-режима                                                                   
ce control bind-slave enabled                                                               

hd Проверка slave-режима                                                                    
ne Проверка синхронизированных зон                                                          
ce ls -l /etc/bind/zone/slave/                                                              
ct Должны появиться файлы зон, скопированные с master-сервера
