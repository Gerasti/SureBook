hd Установка LVM
  ne Определение диска для LVM
  ce lsblk
  ct Определить диск для использования (в примере sdb - диск по iSCSI)
  ne Пометка диска для LVM                                                             
  ce pvcreate /dev/sdb                                                                 
  ct Инициализирует физический том для использования в LVM                             
  ne Создание группы логических томов                                                  
  ce vgcreate VG /dev/sdb                                                              
  ct VG - имя группы томов; /dev/sdb - физический том                                  
                                                                                       
  hd Настройка                                                                         
  ne Создание логического тома                                                         
  ce lvcreate -l 100%FREE -n DATA VG                                                   
  ct -l 100%FREE (использовать всё свободное место); -n DATA (имя тома); VG (группа    
  томов)                                                                               
  ne Форматирование в XFS                                                              
  ce mkfs.xfs /dev/VG/DATA                                                             
  ct Создание файловой системы XFS на логическом томе                                  
  ne Создание точки монтирования                                                       
  ce mkdir /opt/data                                                                   
  ne В /etc/fstab добавить строку                                                      
  ce /dev/VG/DATA /opt/data xfs defaults 0 0                                           
  ct Альтернатива: UUID=<uuid> /opt/data xfs defaults 0 0                              
  ne Монтирование тома                                                                 
  ce mount -av                                                                         
  ct -a (монтировать всё из fstab); -v (подробный вывод)                               
                                                                                       
  hd Проверка     
  ne Проверка логических томов                                                         
  ce lvdisplay                                                                         
  ct Показывает информацию о логических томах                                          
  ne Проверка монтирования                                                             
  ce lsblk                                                                             
  ct Или команда df -h для просмотра смонтированных файловых систем
