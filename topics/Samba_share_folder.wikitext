
=== Настройка Samba для анонимного доступа ===

==== Создание общей директории ====

<syntaxhighlight lang="bash">
mkdir /opt/data                                                                          
chmod 777 /opt/data                                                                         
</syntaxhighlight>

<blockquote>
777(полные права для всех пользователей)
</blockquote>

==== В /etc/samba/smb.conf добавить секцию ====

<syntaxhighlight lang="bash">
[samba]                                                                                  
path = /opt/data                                                                            
browseable = yes                                                                            
writable = yes                                                                              
guest ok = yes                                                                              
read only = no                                                                              
force user = nobody                                                                         
</syntaxhighlight>

<blockquote>
guest ok = yes(анонимный доступ); force user(все действия от имени nobody)
</blockquote>

==== Перезапуск службы ====

<syntaxhighlight lang="bash">
systemctl restart smbd                                                                   

</syntaxhighlight>

=== Настройка Samba для пользователей домена ===

==== Создание общей директории ====

<syntaxhighlight lang="bash">
mkdir /opt/data
chmod 770 /opt/data                                                                         
chown root:domain_users /opt/data                                                           
</syntaxhighlight>

<blockquote>
770(доступ только владельцу и группе); domain_users(группа домена)
</blockquote>

==== В /etc/samba/smb.conf добавить секцию ====

<syntaxhighlight lang="bash">
[samba]                                                                                  
path = /opt/data                                                                            
browseable = yes                                                                            
writable = yes                                                                              
valid users = @domain_users                                                                 
read only = no                                                                              
create mask = 0660                                                                          
directory mask = 0770                                                                       
</syntaxhighlight>

<blockquote>
valid users = @domain_users(доступ только группе домена); create mask(права на новые файлы); directory mask(права на новые каталоги)
</blockquote>

==== Добавление пользователя Samba ====

<syntaxhighlight lang="bash">
smbpasswd -a username
</syntaxhighlight>

<blockquote>
создает пароль Samba для существующего системного пользователя
</blockquote>

=== Настройка Samba для конкретных пользователей ===

==== В /etc/samba/smb.conf добавить секцию ====

<syntaxhighlight lang="bash">
[samba]      
path = /opt/data                                                                            
browseable = yes                                                                            
writable = yes                                                                              
valid users = user1, user2, user3                                                           
read only = no                                                                              
write list = user1, user2                                                                   
</syntaxhighlight>

<blockquote>
valid users(список разрешенных пользователей); write list(пользователи с правом записи)
</blockquote>

=== Описание основных опций Samba ===

==== Опции доступа ====

<syntaxhighlight lang="bash">
browseable = yes
guest ok = yes                                                                              
valid users = user1, @group1                                                                
invalid users = user2                                                                       
read only = no                                                                              
writable = yes                                                                              
write list = user1, @group1                                                                 
read list = user2                                                                           
</syntaxhighlight>

<blockquote>
browseable(видимость в сети); guest ok(гостевой доступ); valid users(разрешенные пользователи/группы); invalid users(запрещенные); write list(право записи); read list(только чтение)
</blockquote>

==== Опции прав доступа ====

<syntaxhighlight lang="bash">
create mask = 0660
directory mask = 0770                                                                       
force user = nobody                                                                         
force group = nogroup                                                                       
inherit permissions = yes                                                                   
</syntaxhighlight>

<blockquote>
create mask(права на файлы); directory mask(права на каталоги); force user/group(принудительный владелец); inherit permissions(наследование прав)
</blockquote>

==== Опции безопасности ====

<syntaxhighlight lang="bash">
hosts allow = 192.168.1.0/24
hosts deny = 192.168.2.0/24                                                                 
max connections = 10                                                                        
</syntaxhighlight>

<blockquote>
hosts allow(разрешенные сети); hosts deny(запрещенные сети); max connections(лимит подключений)
</blockquote>

=== Проверка ===

==== Проверка конфигурации ====

<syntaxhighlight lang="bash">
testparm     
</syntaxhighlight>

<blockquote>
проверяет синтаксис smb.conf
</blockquote>

==== Просмотр активных подключений ====

<syntaxhighlight lang="bash">
smbstatus                                                                                
</syntaxhighlight>

<blockquote>
показывает подключенных пользователей и открытые файлы
</blockquote>

==== Подключение с клиента Windows ====

<syntaxhighlight lang="bash">
\\192.168.1.1\samba                                                                      
</syntaxhighlight>

<blockquote>
в проводнике Windows
</blockquote>

==== Подключение с клиента Linux ====

<syntaxhighlight lang="bash">
smb://192.168.1.1/samba                                                                  
</syntaxhighlight>

<blockquote>
в файловом менеджере или через smbclient
</blockquote>
