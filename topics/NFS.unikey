hd Установка NFS на сервере                                                                 
ne Установка NFS-сервера                                                                    
ce apt-get install nfs-server                                                               
ct Устанавливает сервер NFS для экспорта каталогов по сети                                  

ne Создание каталога для экспорта
ce mkdir /nfs
chmod 777 /nfs
ct mkdir(создать каталог); chmod 777(права rwxrwxrwx для всех пользователей)                

ne Настройка экспортов в /etc/exports                                                       
ce /nfs 192.168.20.0/26(rw,sync,no_subtree_check)                                           
ct /nfs(экспортируемый каталог); 192.168.20.0/26(разрешенная подсеть); rw(read-write, чтение
и запись); sync(синхронная запись на диск перед ответом клиенту);                          
no_subtree_check(отключить проверку подкаталогов, повышает производительность)              
ct Опции маппинга пользователей: root_squash(по умолчанию, root клиента мапится на          
nobody:nogroup, UID 65534); no_root_squash(root клиента = root сервера, небезопасно);       
all_squash(все пользователи клиента мапятся на анонимного); anonuid=1000(указать конкретный
UID для анонимных пользователей); anongid=1000(указать конкретный GID для анонимных         
пользователей)  
ct Другие опции экспорта: ro(только чтение); async(асинхронная запись, быстрее но риск
потери данных); subtree_check(проверка подкаталогов, безопаснее но медленнее)               

ne Применение изменений                                                                     
ce exportfs -ra 
ct exportfs(управление таблицей экспортируемых NFS-каталогов); -r(re-export, перечитать     
/etc/exports); -a(all, применить ко всем каталогам)                                         

hd Установка NFS на клиенте                                                                 
ne Установка NFS-клиента
ce apt-get install nfs-clients                                                              
ct Устанавливает утилиты для монтирования NFS-каталогов                                     

ne Добавление записи в /etc/fstab                                                           
ce 192.168.30.3:/nfs /mnt/nfs nfs defaults 0 0                                              
ct 192.168.30.3:/nfs(удаленный каталог в формате IP:путь); /mnt/nfs(точка монтирования);    
nfs(тип файловой системы); defaults(опции по умолчанию: rw,suid,dev,exec,auto,nouser,async);
первый 0(dump, не создавать резервные копии); второй 0(fsck, не проверять ФС при загрузке) 

ne Монтирование всех файловых систем из fstab                                               
ce mount -a
ct -a(all, смонтировать все файловые системы из /etc/fstab)                                 

hd Проверка подключения                                                                     
ne Просмотр NFS-монтов                                                                      
ce mount | grep nfs                                                                         
ct mount(показать все смонтированные файловые системы); grep nfs(фильтр по типу nfs)        

ne Проверка доступных экспортов на сервере                                                  
ce showmount -e 192.168.30.3                                                                
ct showmount(показать информацию о NFS-экспортах); -e(exports, список экспортируемых        
каталогов с указанием разрешенных клиентов)                                                 

hd Проверка работы NFS                                                                      
ne Создание тестового файла на клиенте
ce cd /mnt/nfs                                                                              
touch txt                                                                                   
ls                                                                                          
ct touch(создать пустой файл); ls(список файлов в каталоге)                                 

ne Проверка на сервере                                                                      
ce ls -l /nfs                                                                               
