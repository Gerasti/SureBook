hd Настройка базовой HTTP-аутентификации                                                    
  ct Для ограничения доступа к веб-приложению через встроенную HTTP-аутентификацию nginx      
                                                                                              
  ne Установка утилиты для создания файла паролей                                             
  ce apt-get install apache2-utils                                                            
                                                                                              
  ne Создание файла с учётными записями                                                       
  ce htpasswd -c /etc/nginx/.htpasswd WEB                                                     
  ct Потребуется ввести пароль: P@ssw0rd                                                      
  ct WEB(имя пользователя); P@ssw0rd(пароль); /etc/nginx/.htpasswd(файл хранения учётных      
  записей)                                                                                    
                                                                                              
  ne В блок location добавить параметры аутентификации                                        
  ce location / { 
      auth_basic "Restricted Area";                                                           
      auth_basic_user_file /etc/nginx/.htpasswd;                                              
                                                                                              
      proxy_pass http://10.0.0.10:8080;                                                       
                                                                                              
      proxy_http_version 1.1;                                                                 
                  
      proxy_set_header Host $host;                                                            
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;                            
      proxy_set_header X-Forwarded-Proto $scheme;                                             
  }                                                                                           
                                                                                              
  hd Проверка                                                                                 
  ne Проверка корректности настроек                                                           
  ce nginx -t                                                                                 
                                                                                              
  ne Применение изменений                                                                     
  ce systemctl reload nginx 
