
[H3]Установка и настройка CUPS[/H3]

[H4]Установка пакетов на сервере[/H4]

[CODE]
apt-get install cups cups-pdf                                                            
   
 
[/CODE]

[H3]Настройка CUPS-сервера[/H3]

[H4]Изменение конфигурации в /etc/cups/cupsd.conf[/H4]

[CODE]
Listen *:631                                                                             
                                                                                              
  <Location />                                                                                
  Order allow,deny                                                                            
  Allow all                                                                                   
  </Location>                                                                                 
   
  <Location /admin>                                                                           
  Order allow,deny
  Allow all                                                                                   
  </Location>     
 
[/CODE]

[QUOTE]
Listen *:631(слушать порт 631 на всех интерфейсах); <Location />(доступ к основной странице); <Location /admin>(доступ к панели администратора); Allow all(разрешить всем клиентам)
[/QUOTE]

[QUOTE]
Для ограничения доступа по подсетям замените Allow all на Allow from 192.168.1.0/24
[/QUOTE]

[H4]Запуск и включение службы[/H4]

[CODE]
systemctl enable cups                                                                    
  systemctl restart cups                                                                      
                                                                                              
 
[/CODE]

[H4]Проверка доступных принтеров[/H4]

[CODE]
lpstat -p                                                                                
 
[/CODE]

[QUOTE]
Показывает список принтеров и их статус
[/QUOTE]

[H3]Подключение клиента к CUPS[/H3]

[H4]Установка пакетов на клиенте[/H4]

[CODE]
apt-get install cups                                                                     
                  
 
[/CODE]

[H4]Подключение сетевого принтера[/H4]

[CODE]
lpadmin -p PDF -E -v ipp://192.168.1.10:631/printers/PDF -m everywhere
 
[/CODE]

[QUOTE]
-p(имя принтера); -E(включить принтер); -v(URI принтера); -m everywhere(автоматический драйвер)
[/QUOTE]

[QUOTE]
Формат URI: ipp://IP_СЕРВЕРА:631/printers/ИМЯ_ПРИНТЕРА
[/QUOTE]

[H4]Назначение принтера по умолчанию[/H4]

[CODE]
lpoptions -d PDF                                                                         
                                                                                              
 
[/CODE]

[H4]Проверка подключения[/H4]

[CODE]
lpstat -t                                                                                
 
[/CODE]

[QUOTE]
Показывает список принтеров, очередь печати, принтер по умолчанию, состояние службы
[/QUOTE]

[H3]Работа с CUPS[/H3]

[H4]Печать документа[/H4]

[CODE]
echo "Тест печати" | lp -t "Example"                                                     
 
[/CODE]

[QUOTE]
lp(команда печати); -t(название задания)
[/QUOTE]

[H4]Проверка PDF-файлов на сервере[/H4]

[CODE]
ls -l /home/USERNAME/                                                                    
 
[/CODE]

[QUOTE]
При использовании cups-pdf документы сохраняются в домашнем каталоге пользователя клиента
[/QUOTE]

[H4]Web-интерфейс[/H4]

[CODE]
http://IP_СЕРВЕРА:631                                                                    
 
[/CODE]

[QUOTE]
Управление принтерами, очередью и заданиями
[/QUOTE]

[H3]Полезные команды[/H3]

[H4]Просмотр очереди печати[/H4]

[CODE]
lpq                                                                                      
                                                                                              
 
[/CODE]

[H4]Отмена задания[/H4]

[CODE]
cancel ID_ЗАДАНИЯ                                                                        
                                                                                              
 
[/CODE]

[H4]Список устройств[/H4]

[CODE]
lpinfo -v
[/CODE]
