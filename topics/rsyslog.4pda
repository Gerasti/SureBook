
[SIZE=4]Установка[/SIZE]

[SIZE=3]Установка пакетов на всех устройствах[/SIZE]

[CODE]
apt-get install rsyslog logrotate                                                        
 
[/CODE]

[QUOTE]
rsyslog(сбор и пересылка логов); logrotate(ротация и сжатие логов)
[/QUOTE]

[QUOTE]
Обычно работают в связке
[/QUOTE]

[SIZE=4]Настройка сервера сбора логов[/SIZE]

[SIZE=3]В /etc/rsyslog.conf[/SIZE]

[CODE]
module(load="imuxsock")                                                                  
  module(load="imklog")                                                                       
  module(load="imudp")                                                                        
  input(type="imudp" port="514")                                                              
  module(load="imtcp")                                                                        
  input(type="imtcp" port="514")                                                              
                                                                                              
  $template RemoteLogs, "/opt/%HOSTNAME%/%PROGRAMNAME%.log"                                   
                  
  if ($fromhost-ip != "127.0.0.1" and $syslogseverity <= 4) then ?RemoteLogs                  
  & stop          
 
[/CODE]

[QUOTE]
imuxsock(локальные сообщения); imklog(логи ядра); imudp/imtcp(приём по UDP/TCP); $syslogseverity <= 4(warning и выше); & stop(остановка обработки)
[/QUOTE]

[SIZE=3]Создание каталогов для логов[/SIZE]

[CODE]
mkdir -p /opt/client1
  mkdir -p /opt/client2                                                                       
  mkdir -p /opt/client3                                                                       
 
[/CODE]

[QUOTE]
создаются каталоги для каждого клиента
[/QUOTE]

[SIZE=3]Установка прав на каталоги[/SIZE]

[CODE]
chown -R root:root /opt                                                                  
  chmod -R 755 /opt                                                                           
 
[/CODE]

[QUOTE]
права для записи логов службой rsyslog
[/QUOTE]

[SIZE=3]Перезапуск службы на сервере[/SIZE]

[CODE]
systemctl restart rsyslog                                                                
                                                                                              
 
[/CODE]

[SIZE=4]Настройка клиента[/SIZE]

[SIZE=3]В /etc/rsyslog.conf на клиенте[/SIZE]

[CODE]
*.warning action(type="omfwd"                                                            
      target="<HQ-SRV_IP>"                                                                    
      port="514"                                                                              
      protocol="tcp"                                                                          
      action.resumeRetryCount="-1"                                                            
      queue.type="linkedList"                                                                 
      queue.size="10000")                                                                     
 
[/CODE]

[QUOTE]
*.warning(уровень warning и выше); target(IP сервера логов); protocol(tcp для надежности); resumeRetryCount=-1(бесконечные попытки); queue.size(размер очереди сообщений)
[/QUOTE]

[SIZE=3]Перезапуск службы на клиенте[/SIZE]

[CODE]
systemctl restart rsyslog
                                                                                              
 
[/CODE]

[SIZE=4]Проверка[/SIZE]

[SIZE=3]Проверка открытого порта на сервере[/SIZE]

[CODE]
ss -tulpn | grep 514                                                                     
 
[/CODE]

[QUOTE]
должен показать порты 514 TCP и UDP
[/QUOTE]

[SIZE=3]Проверка каталогов логов на сервере[/SIZE]

[CODE]
ls -la /opt/                                                                             
 
[/CODE]

[QUOTE]
должны появиться каталоги с именами клиентов
[/QUOTE]

[SIZE=3]Проверка содержимого логов[/SIZE]

[CODE]
ls -la /opt/client1/                                                                     
 
[/CODE]

[QUOTE]
должны появиться файлы логов от клиента
[/QUOTE]

[SIZE=3]Тестовая отправка сообщения с клиента[/SIZE]

[CODE]
logger -p user.warning "Test message from client"                                        
 
[/CODE]

[QUOTE]
отправляет тестовое сообщение уровня warning
[/QUOTE]

[SIZE=3]Проверка получения на сервере[/SIZE]

[CODE]
tail -f /opt/client1/*.log                                                               
 
[/CODE]

[QUOTE]
должно появиться тестовое сообщение
[/QUOTE]
