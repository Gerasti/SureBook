
=== Установка ===

==== Установка пакета ====

<syntaxhighlight lang="bash">
apt-get install -y MySQL-server                                                          

</syntaxhighlight>

==== Включение и запуск службы ====

<syntaxhighlight lang="bash">
systemctl enable --now mysqld

</syntaxhighlight>

=== Настройка MySQL ===

==== Установка пароля root ====

<syntaxhighlight lang="bash">
mysql -u root
ALTER USER 'root'@'localhost' IDENTIFIED BY 'P@ssw0rd';
EXIT;

</syntaxhighlight>

==== Разрешение доступа из сети в /etc/my.cnf.d/server.cnf ====

<syntaxhighlight lang="bash">
sed -i "s/skip-networking/#skip-networking/g" /etc/my.cnf.d/server.cnf

</syntaxhighlight>

==== Перезапуск службы ====

<syntaxhighlight lang="bash">
systemctl restart mysqld                                                                 

</syntaxhighlight>

==== Разрешение доступа для root по сети ====

<syntaxhighlight lang="bash">
mysql -u root -p                                                                         
GRANT ALL PRIVILEGES ON *.* TO 'root'@'localhost';                                          
UPDATE mysql.user SET host='%' WHERE user='root';                                           
FLUSH PRIVILEGES;                                                                           
EXIT;                                                                                       
</syntaxhighlight>

<blockquote>
host='%' разрешает подключение с любого узла
</blockquote>

==== Перезапуск службы ====

<syntaxhighlight lang="bash">
systemctl restart mysqld                                                                 

</syntaxhighlight>

=== Проверка MySQL ===

==== Проверка пользователей на сервере ====

<syntaxhighlight lang="bash">
mysql -u root -p                                                                         
SELECT user, HOST FROM mysql.user;                                                          
EXIT;                                                                                       

</syntaxhighlight>

==== Удаленное подключение с клиента ====

<syntaxhighlight lang="bash">
mysql -h IP_СЕРВЕРА -u root -p                                                           

</syntaxhighlight>

=== Создание БД и пользователей ===

==== Создание базы данных ====

<syntaxhighlight lang="bash">
mysql -u root -p                                                                         
CREATE DATABASE db01;                                                                       
</syntaxhighlight>

<blockquote>
db01 - имя создаваемой БД
</blockquote>

==== Создание пользователя ====

<syntaxhighlight lang="bash">
CREATE USER 'user01'@'%' IDENTIFIED BY 'P@ssw0rd';                                       
</syntaxhighlight>

<blockquote>
'%' означает подключение с любого хоста
</blockquote>

==== Предоставление прав пользователю ====

<syntaxhighlight lang="bash">
GRANT ALL PRIVILEGES ON db01.* TO 'user01'@'%';                                          
FLUSH PRIVILEGES;                                                                           

</syntaxhighlight>

==== Проверка существования БД и пользователей ====

<syntaxhighlight lang="bash">
SHOW DATABASES;                                                                          
SELECT user, HOST FROM mysql.user;                                                          
EXIT;          
</syntaxhighlight>
