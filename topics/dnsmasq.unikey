hd Установка и настройка dnsmasq
ne Установка пакета
ce apt-get install dnsmasq

ne Включение автозапуска
ce systemctl enable --now dnsmasq

hd Настройка DNS в dnsmasq
ne Конфигурация DNS в /etc/dnsmasq.conf
ce domain=domain.example

server=/domain.example/192.168.5.2
server=77.88.8.8

interface=*

address=/hq-rtr.domain.example/192.168.1.1
ptr-record=1.1.168.192.in-addr.arpa,hq-rtr.domain.example

address=/docker.domain.example/172.16.1.1
address=/web.domain.example/172.16.2.1

address=/br-rtr.domain.example/192.168.5.1

address=/hq-srv.domain.example/192.168.1.2
ptr-record=2.1.168.192.in-addr.arpa,hq-srv.domain.example

address=/hq-cli.domain.example/192.168.5.3
ptr-record=3.5.168.192.in-addr.arpa,hq-cli.domain.example

address=/br-srv.domain.example/192.168.5.2 

ct listen-address(IP-адреса для приёма DNS-запросов); domain(локальный домен сети);
local(запрет пересылки локальной зоны во внешний DNS); cache-size(размер DNS-кэша);
server(внешний DNS-сервер для пересылки); expand-hosts(использовать /etc/hosts);
log-queries(логирование DNS-запросов); log-facility(файл логов)

hd Типы DNS-записей в dnsmasq
ne A-запись в /etc/dnsmasq.conf
ce address=/host.example.com/192.168.0.10
ct Соответствие доменного имени IPv4-адресу

ne AAAA-запись в /etc/dnsmasq.conf
ce address=/host.example.com/2001:db8::1
ct Соответствие доменного имени IPv6-адресу

ne CNAME-запись в /etc/dnsmasq.conf
ce cname=alias.example.com,host.example.com
ct Псевдоним для существующего доменного имени

ne MX-запись в /etc/dnsmasq.conf
ce mx-host=example.com,mail.example.com,10
ct Почтовый сервер для домена, цифра указывает приоритет

ne TXT-запись в /etc/dnsmasq.conf
ce txt-record=example.com,"v=spf1 mx a -all"
ct Текстовые записи для SPF, DMARC, верификации

ne SRV-запись в /etc/dnsmasq.conf
ce srv-host=_service._tcp.example.com,target.example.com,443,10,10
ct Указание сервиса, порта и приоритета

ne PTR-запись в /etc/dnsmasq.conf
ce ptr-record=10.0.168.192.in-addr.arpa,host.example.com
ct Обратное преобразование IP-адреса в доменное имя

hd Настройка DHCP в dnsmasq
ne Конфигурация DHCP в /etc/dnsmasq.conf
ce interface=ens3
bind-interfaces
no-resolv
dhcp-range=192.168.0.50,192.168.0.150,12h

dhcp-host=aa:bb:cc:dd:ee:ff,192.168.1.51
dhcp-host=myhost,ignore 
dhcp-host=192.168.1.50,ignore

dhcp-option=3,192.168.0.1
dhcp-option=6,192.168.0.1
dhcp-option=15,no.do
ct interface(интерфейс для работы DHCP); bind-interfaces(работать только на указанном
интерфейсе); dhcp-range(диапазон IP-адресов и время аренды); dhcp-option=3(шлюз по
умолчанию); dhcp-option=6(DNS-сервер); dhcp-option=15(доменное имя сети)

ne Дополнительные параметры в /etc/dnsmasq.conf
ce user=nobody
group=nogroup
ct user(пользователь процесса); group(группа процесса); except-interface(исключить интерфейс
из работы dnsmasq); no-resolv(запрещает использовать /etc/resolv.conf); dhcp-host(исключить адрес из выдачи)

ne Применение конфигурации
ce systemctl restart dnsmasq

hd Проверка dnsmasq
ne Проверка статуса службы
ce systemctl status dnsmasq
