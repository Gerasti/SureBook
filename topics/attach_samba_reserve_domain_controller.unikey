hd Установка Samba DC
  ne Установка пакета task-samba-dc
  ce apt-get install -y task-samba-dc                                                                      
                                                                                                           
  hd Настройка DNS                                                                                         
  ne В /etc/resolv.conf                                                                                    
  ce search ad.team                                                                                        
  nameserver 192.168.11.67                                                                                 
  nameserver 192.168.33.67                                                                                 
  nameserver 8.8.8.8                                                                                       
  ct search(домен поиска); nameserver(DNS серверы)                                                         
                                                                                                           
  hd Настройка Kerberos                                                                                    
  ne В /etc/krb5.conf                                                                                      
  ce [libdefaults]                                                                                         
  default_realm = AD.TEAM                                                                                  
  dns_lookup_kdc = true                                                                                    
  dns_lookup_realm = false                                                                                 
                                                                                                           
  [realms]                                                                                                 
  AD.TEAM = {                                                                                              
  kdc = srv-hq.ad.team                                                                                     
  default_domain = ad.team                                                                                 
  }                                                                                                        
                                                                                                           
  [domain_realm]                                                                                           
  .ad.team = AD.TEAM
  ad.team = AD.TEAM                                                                                        
  ct default_realm(область по умолчанию); dns_lookup_kdc(поиск KDC через DNS); kdc(контроллер домена);     
  domain_realm(сопоставление доменов)                                                                      
                                                                                                           
  hd Регистрация вторичного DC в DNS                                                                       
  ne Добавление A-записи в BIND9_DLZ
  ce samba-tool dns add srv-hq ad.team srv-dt A 192.168.33.67 -Uadministrator                              
  ct samba-tool dns add(добавление DNS записи); A(тип записи); -U(пользователь)                            
                                                                                                           
  hd Проверка подключения                                                                                  
  ne Проверка разрешения имени                                                                             
  ce host srv-hq                                                                                           
  ct должен вернуть srv-hq.ad.team has address 192.168.11.67                                               
                                                                                                           
  ne Получение Kerberos билета                                                                             
  ce kinit administrator                                                                                   
  ct вводится пароль administrator@AD.TEAM                                                                 
                                                                                                           
  ne Проверка полученных билетов                                                                           
  ce klist                                                                                                 
  ct показывает кэш билетов и срок действия                                                                
                                                                                                           
  hd Присоединение к домену                                                                                
  ne Подключение как контроллер домена                                                                     
  ce samba-tool domain join ad.team DC -Uadministrator --realm=ad.team --workgroup=ad                      
  ct domain join(присоединение к домену); DC(режим контроллера домена); --realm(область Kerberos);         
  --workgroup(рабочая группа)                                                                              
                                                                                                           
  ne Запуск службы Samba                                                                                   
  ce systemctl enable --now samba
