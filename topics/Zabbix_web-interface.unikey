ne Установка пакетов                                                                        
ce apt-get install zabbix-phpfrontend-apache2 zabbix-phpfrontend-php8.2                     
ct zabbix-phpfrontend-apache2(веб-интерфейс для Apache2);
zabbix-phpfrontend-php8.2(поддержка PHP 8.2)                                                

ne Включение конфигурации Apache2                                                           
ce ln -s /etc/httpd2/conf/addon.d/A.zabbix.conf /etc/httpd2/conf/extra-enabled/
ct создает символическую ссылку для активации конфигурации Zabbix                           

ne Перезапуск Apache2                                                                       
ce systemctl restart httpd2                                                                 

ne Изменение владельца для веб-установщика                                                  
ce chown apache2:apache2 /var/www/webapps/zabbix/ui/conf                                    
ct необходимо для записи конфигурации при установке                                         

hd Настройка через веб-интерфейс                                                            

ne Открытие веб-установщика                                                                 
ce http://<ip сервера>/zabbix
ct открыть в браузере                                                                       

lt Параметры подключения к базе данных                                                      
- type database: PostgreSQL{MySQL}                                                  
- host: localhost                                                                           
- port: 0                                                                                   
- name: zabbix                                                                              
- scheme: public                                                                            
- user: zabbix                                                                              
- password: zabbixpwd                                                                       
ct port 0(автоматически использует порт по умолчанию: PostgreSQL 5432, MySQL 3306);         
scheme(схема базы данных)                                                                   

hd Проверка                                                                                 

ne Вход в веб-интерфейс                                                                     
ce http://<ip сервера>/zabbix

ct открыть страницу входа                                                                   

ne Учетные данные по умолчанию                                                              
ce username: Admin                                                                          
password: zabbix                                                                            
ct Admin с заглавной буквы; рекомендуется сменить пароль после первого входа                

ne Проверка статуса Apache2                                                                 
ce systemctl status httpd2                                                                  
ct служба должна быть active (running)                                                      

ne Проверка прав на каталог конфигурации                                                    
ce ls -la /var/www/webapps/zabbix/ui/conf
