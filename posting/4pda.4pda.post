[CODE]
ansible-playbook -i inventory playbook.yml
[/CODE]

[SIZE=4]apt[/SIZE]

[SIZE=3]Настройка[/SIZE]

[SIZE=3]Раскомментировать строки в /etc/apt/sources.list.d/yandex.list[/SIZE]

[CODE]
rpm [alt] http://mirror.yandex.ru/altlinux Sisyphus/x86_64 classic
rpm [alt] http://mirror.yandex.ru/altlinux Sisyphus/i586 classic
rpm [alt] http://mirror.yandex.ru/altlinux Sisyphus/noarch classic
[/CODE]

[QUOTE]
alt.list желательно весь закомментировать
[/QUOTE]

[SIZE=3]Обновление[/SIZE]

[CODE]
apt-get update
[/CODE]

[QUOTE]
Должен работать DNS и возможно Интернет, NAT
[/QUOTE]

[SIZE=4]attach_samba_reserve_domain_controller[/SIZE]

[SIZE=3]Установка Samba DC[/SIZE]

[SIZE=3]Установка пакета task-samba-dc[/SIZE]

[CODE]
apt-get install -y task-samba-dc                                                                      
                                                                                                           
 
[/CODE]

[SIZE=3]Настройка DNS[/SIZE]

[SIZE=3]В /etc/resolv.conf[/SIZE]

[CODE]
search ad.team                                                                                        
  nameserver 192.168.11.67                                                                                 
  nameserver 192.168.33.67                                                                                 
  nameserver 8.8.8.8                                                                                       
 
[/CODE]

[QUOTE]
search(домен поиска); nameserver(DNS серверы)
[/QUOTE]

[SIZE=3]Настройка Kerberos[/SIZE]

[SIZE=3]В /etc/krb5.conf[/SIZE]

[CODE]
[libdefaults]                                                                                         
  default_realm = AD.TEAM                                                                                  
  dns_lookup_kdc = true                                                                                    
  dns_lookup_realm = false                                                                                 
                                                                                                           
  [realms]                                                                                                 
  AD.TEAM = {                                                                                              
  kdc = srv-hq.ad.team                                                                                     
  default_domain = ad.team                                                                                 
  }                                                                                                        
                                                                                                           
  [domain_realm]                                                                                           
  .ad.team = AD.TEAM
  ad.team = AD.TEAM                                                                                        
 
[/CODE]

[QUOTE]
default_realm(область по умолчанию); dns_lookup_kdc(поиск KDC через DNS); kdc(контроллер домена); domain_realm(сопоставление доменов)
[/QUOTE]

[SIZE=3]Регистрация вторичного DC в DNS[/SIZE]

[SIZE=3]Добавление A-записи в BIND9_DLZ[/SIZE]

[CODE]
samba-tool dns add srv-hq ad.team srv-dt A 192.168.33.67 -Uadministrator                              
 
[/CODE]

[QUOTE]
samba-tool dns add(добавление DNS записи); A(тип записи); -U(пользователь)
[/QUOTE]

[SIZE=3]Проверка подключения[/SIZE]

[SIZE=3]Проверка разрешения имени[/SIZE]

[CODE]
host srv-hq                                                                                           
 
[/CODE]

[QUOTE]
должен вернуть srv-hq.ad.team has address 192.168.11.67
[/QUOTE]

[SIZE=3]Получение Kerberos билета[/SIZE]

[CODE]
kinit administrator                                                                                   
 
[/CODE]

[QUOTE]
вводится пароль administrator@AD.TEAM
[/QUOTE]

[SIZE=3]Проверка полученных билетов[/SIZE]

[CODE]
klist                                                                                                 
 
[/CODE]

[QUOTE]
показывает кэш билетов и срок действия
[/QUOTE]

[SIZE=3]Присоединение к домену[/SIZE]

[SIZE=3]Подключение как контроллер домена[/SIZE]

[CODE]
samba-tool domain join ad.team DC -Uadministrator --realm=ad.team --workgroup=ad                      
 
[/CODE]

[QUOTE]
domain join(присоединение к домену); DC(режим контроллера домена); --realm(область Kerberos); --workgroup(рабочая группа)
[/QUOTE]

[SIZE=3]Запуск службы Samba[/SIZE]

[CODE]
systemctl enable --now samba
[/CODE]

[SIZE=4]auto_mounting_devices[/SIZE]

[SIZE=3]Форматирование диска[/SIZE]

[SIZE=3]Создание файловой системы ext4[/SIZE]

[CODE]
mkfs.ext4 /dev/sda                                                                                    
 
[/CODE]

[QUOTE]
создает файловую систему ext4 на устройстве /dev/sda
[/QUOTE]

[SIZE=3]Подготовка точки монтирования[/SIZE]

[SIZE=3]Создание директории[/SIZE]

[CODE]
mkdir -p /opt/data                                                                                    
 
[/CODE]

[QUOTE]
-p(создание родительских директорий)
[/QUOTE]

[SIZE=3]Монтирование[/SIZE]

[SIZE=3]Монтирование диска[/SIZE]

[CODE]
mount /dev/sda /opt/data                                                                              
 
[/CODE]

[QUOTE]
временное монтирование до перезагрузки
[/QUOTE]

[SIZE=3]Автоматическое монтирование[/SIZE]

[SIZE=3]Добавление записи в /etc/fstab[/SIZE]

[CODE]
/dev/sda /opt/data ext4 defaults 0 2                                                                  
 
[/CODE]

[QUOTE]
/dev/sda(устройство); /opt/data(точка монтирования); ext4(тип ФС); defaults(опции монтирования); 0(резервное копирование dump); 2(порядок проверки fsck)
[/QUOTE]

[SIZE=3]Параметры /etc/fstab[/SIZE]

[SIZE=4]Структура записи[/SIZE]
[LIST][*]/dev/sda: устройство[/LIST]
[LIST][*]/opt/data: точка монтирования[/LIST]
[LIST][*]ext4: тип файловой системы[/LIST]
[LIST][*]defaults: обобщенные опции[/LIST]
[LIST][LIST][*]rw(чтение-запись), suid(SUID биты), dev(файлы устройств), exec(выполнение), auto(автомонтирование), nouser(только root), async(асинхронная запись)[/LIST][/LIST]
[LIST][*]0: управление резервным копированием (dump-flag)[/LIST]
[LIST][LIST][*]0(не создавать резервные копии), 1(обычно root /), 2(другие разделы /home, /opt, /var)[/LIST][/LIST]
[LIST][*]2: порядок проверки файловой системы (fsck)[/LIST]
[LIST][LIST][*]0(не проверять), 1(первым, обычно root), 2(после root для /home, /opt, /var)[/LIST][/LIST]

[SIZE=3]Применение[/SIZE]

[CODE]
mount -a
[/CODE]

[QUOTE]
-a(монтирование всего из fstab)
[/QUOTE]

[SIZE=3]Проверка монтирования[/SIZE]

[SIZE=3]Просмотр смонтированных разделов[/SIZE]

[CODE]
df -h                                                                                                 
 
[/CODE]

[QUOTE]
-h(человекочитаемый формат)
[/QUOTE]

[SIZE=4]base_samba-command[/SIZE]

[SIZE=3]Управление пользователями и группами[/SIZE]

[SIZE=3]Создание группы[/SIZE]

[CODE]
samba-tool group add <имя_группы>                                                                     
                                                                                                           
 
[/CODE]

[SIZE=3]Создание пользователя[/SIZE]

[CODE]
samba-tool user create <имя_пользователя>                                                             
                                                                                                           
 
[/CODE]

[SIZE=3]Добавление пользователя в группу[/SIZE]

[CODE]
samba-tool group addmembers <имя_группы> <имя_пользователя>                                           
                                                                                                           
 
[/CODE]

[SIZE=3]Список пользователей[/SIZE]

[CODE]
samba-tool user list                                                                                  
                                                                                                           
 
[/CODE]

[SIZE=3]Список участников группы[/SIZE]

[CODE]
samba-tool group listmembers <имя_группы>                                                             
                                                                                                           
 
[/CODE]

[SIZE=3]Политика паролей[/SIZE]

[SIZE=3]Настройка сложности и длины пароля[/SIZE]

[CODE]
samba-tool domain passwordsettings set --complexity=off                                               
  samba-tool domain passwordsettings set --min-pwd-length=1                                                
  samba-tool domain passwordsettings set --max-pwd-age=0                                                   
  samba-tool domain passwordsettings set --min-pwd-age=0                                                   
  samba-tool domain passwordsettings set --pwd-history-length=0                                            
 
[/CODE]

[QUOTE]
--complexity(сложность паролей); --min-pwd-length(минимальная длина); --max-pwd-age(срок действия пароля); --min-pwd-age(минимальный возраст пароля); --pwd-history-length(история паролей)
[/QUOTE]

[SIZE=3]Политика блокировки[/SIZE]

[SIZE=3]Настройка блокировки учетных записей[/SIZE]

[CODE]
samba-tool domain passwordsettings set --lockout-threshold=0                                          
  samba-tool domain passwordsettings set --lockout-duration=30                                             
  samba-tool domain passwordsettings set --reset-count=30                                                  
 
[/CODE]

[QUOTE]
--lockout-threshold(порог блокировки); --lockout-duration(длительность блокировки); --reset-count(интервал сброса счетчика)
[/QUOTE]

[SIZE=3]Kerberos-политика[/SIZE]

[SIZE=3]Настройка времени жизни билетов[/SIZE]

[CODE]
samba-tool domain passwordsettings set --krb-ticket-lifetime=24                                       
  samba-tool domain passwordsettings set --krb-renewal-lifetime=168                                        
 
[/CODE]

[QUOTE]
--krb-ticket-lifetime(срок жизни билета в часах); --krb-renewal-lifetime(срок обновления билета)
[/QUOTE]

[SIZE=3]Параметры учетных записей[/SIZE]

[SIZE=3]Хранение паролей в открытом виде[/SIZE]

[CODE]
samba-tool domain passwordsettings set --store-plaintext-password=yes                                 
  samba-tool domain passwordsettings set --allow-plaintext-password=yes                                    
 
[/CODE]

[QUOTE]
только для тестовых стендов; не рекомендуется в продакшене
[/QUOTE]

[SIZE=3]Параметры безопасности домена[/SIZE]

[SIZE=3]Настройка криптографии[/SIZE]

[CODE]
samba-tool domain passwordsettings set --allow-microsecond-timestamps=yes                             
  samba-tool domain passwordsettings set --allow-weak-crypto=yes                                           
 
[/CODE]

[QUOTE]
снижает безопасность; для совместимости со старыми устройствами
[/QUOTE]

[SIZE=3]Политика времени Kerberos[/SIZE]

[SIZE=3]Настройка флагов политики[/SIZE]

[CODE]
samba-tool domain passwordsettings set --krb-policy-flags=0x00000000                                  
                                                                                                           
 
[/CODE]

[SIZE=3]Аудит и логирование[/SIZE]

[SIZE=3]Просмотр уровня домена[/SIZE]

[CODE]
samba-tool domain level show                                                                          
                                                                                                           
 
[/CODE]

[SIZE=3]Увеличение детализации логов[/SIZE]

[CODE]
smbcontrol all debug 3                                                                                
  smbcontrol all debug 10                                                                                  
 
[/CODE]

[QUOTE]
debug 3(средний уровень); debug 10(максимальная детализация)
[/QUOTE]

[SIZE=3]Уровень функциональности домена[/SIZE]

[SIZE=3]Просмотр уровня домена[/SIZE]

[CODE]
samba-tool domain level show                                                                          
                                                                                                           
 
[/CODE]

[SIZE=3]Повышение уровня домена и леса[/SIZE]

[CODE]
samba-tool domain level raise --domain-level=2008_R2                                                  
  samba-tool domain level raise --forest-level=2008_R2                                                     
 
[/CODE]

[QUOTE]
2008_R2(Windows Server 2008 R2)
[/QUOTE]

[SIZE=3]Проверка политики[/SIZE]

[SIZE=3]Просмотр всех настроек политики паролей[/SIZE]

[CODE]
samba-tool domain passwordsettings show                                                               
                                                                                                           
 
[/CODE]

[SIZE=3]Управление DNS[/SIZE]

[SIZE=3]Добавление A-записи в DNS[/SIZE]

[CODE]
samba-tool dns add 127.0.0.1 <домен> <имя_устройства> A <ip_адрес> -U administrator                   
 
[/CODE]

[QUOTE]
пример: samba-tool dns add 127.0.0.1 office.ssa2026.region rtr-a A 172.20.10.254 -U administrator
[/QUOTE]

[SIZE=3]Создание организационных единиц[/SIZE]

[SIZE=3]Создание OU[/SIZE]

[CODE]
samba-tool ou create "OU=CLI,DC=ad-team,DC=info"                                                      
                                                                                                           
 
[/CODE]

[SIZE=3]Массовое создание пользователей[/SIZE]

[SIZE=3]Создание нескольких пользователей циклом[/SIZE]

[CODE]
for i in {1..5}; do samba-tool user create "hq$i" "P@ssw0rd"; done                                    
                                                                                                           
 
[/CODE]

[SIZE=3]Создание группы[/SIZE]

[CODE]
samba-tool group add hq                                                                               
                                                                                                           
 
[/CODE]

[SIZE=3]Массовое добавление пользователей в группу[/SIZE]

[CODE]
for i in {1..5}; do samba-tool group addmembers hq "hq$i"; done                                       
 
[/CODE]

[QUOTE]
цикл for создает пользователей hq1, hq2, hq3, hq4, hq5 и добавляет их в группу hq
[/QUOTE]

[SIZE=4]bash_script_for_samba[/SIZE]

[SIZE=3]Массовый импорт пользователей в Samba AD[/SIZE]

[SIZE=3]Подготовка CSV-файла[/SIZE]

[CODE]
First Name;Last Name;Role;Phone;OU;Street;ZIP;City;Country;Password                      
  Ivan;Ivanov;Administrator;+79990000001;IT;Lenina 1;101000;Moscow;RU;P@ssw0rd1               
  Petr;Petrov;Manager;+79990000002;Sales;Mira 10;101001;Moscow;RU;P@ssw0rd1                   
 
[/CODE]

[QUOTE]
Разделитель - точка с запятой; First Name(имя); Last Name(фамилия); Role(должность); Phone(телефон); OU(подразделение); Street(улица); ZIP(индекс); City(город); Country(страна); Password(пароль)
[/QUOTE]

[SIZE=3]Создание скрипта импорта[/SIZE]

[CODE]
vim import_user.sh
                                                                                              
 
[/CODE]

[SIZE=3]Содержимое /root/import_user.sh[/SIZE]

[CODE]
#!/bin/bash                                                                              
                                                                                              
  csv_file="$1"                                                                               
                                                                                              
  # Create OU                                                                                 
  awk -F ';' 'NR>1 {print $5}' "$csv_file" | sort | uniq | while read ou;
  do                                                                                          
      samba-tool ou add OU="$ou",DC=domain,DC=example;                                          
  done                                                                                        
                                                                                              
  # Create Users                                                                              
  while IFS=";" read -r firstName lastName role phone ou street zip city country password;
  do                                                                                          
      if [ "$firstName" == "First Name" ];
      then                                                                                    
          continue
      fi                                                                                      
                  
      username=$(echo $firstName | tr '[:upper:]' '[:lower:]' | tr -d ' '),$(echo $lastName | 
  tr '[:upper:]' '[:lower:]' | tr -d ' ')
                                                                                              
      samba-tool user add "$username" P@ssw0rd1 \                                             
      --given-name="$firstName" \
      --surname="$lastName" \                                                                 
      --telephone-number="$phone" \                                                           
      --job-title="$role" \                                                                   
      --ou="OU=$ou" \                                                                         
      --userou="OU=$ou" --noexpiry                                                            
  done < "$csv_file"                                                                          
 
[/CODE]

[QUOTE]
Скрипт автоматически создаёт OU и пользователей; username формируется как ivan,ivanov; --noexpiry(пароль не истекает)
[/QUOTE]

[SIZE=3]Выдача прав на запуск[/SIZE]

[CODE]
chmod +x import_user.sh
                                                                                              
 
[/CODE]

[SIZE=3]Запуск импорта[/SIZE]

[SIZE=3]Импорт пользователей из CSV[/SIZE]

[CODE]
./import_user.sh /mnt/Users.csv                                                          
 
[/CODE]

[QUOTE]
Запускать от root или администратора домена
[/QUOTE]

[SIZE=3]Проверка[/SIZE]

[SIZE=3]Проверка созданных OU[/SIZE]

[CODE]
samba-tool ou list                                                                       
                                                                                              
 
[/CODE]

[SIZE=3]Проверка объектов внутри OU[/SIZE]

[CODE]
samba-tool ou listobjects OU=IT                                                          
 
[/CODE]

[QUOTE]
Можно проверять любые подразделения {OU=Sales, OU=IT}
[/QUOTE]

[SIZE=4]BIND9_DLZ_samba[/SIZE]

[SIZE=3]Установка Samba AD DC с BIND9_DLZ[/SIZE]

[SIZE=3]Установка пакетов[/SIZE]

[CODE]
apt-get install -y task-samba-dc bind                                                    
                                                                                              
 
[/CODE]

[SIZE=3]Отключение chroot для BIND[/SIZE]

[CODE]
control bind-chroot disabled                                                             
                                                                                              
 
[/CODE]

[SIZE=3]Подключение конфигурации BIND9_DLZ[/SIZE]

[CODE]
grep -q 'bind-dns' /etc/bind/named.conf || echo 'include                                 
  "/var/lib/samba/bind-dns/named.conf";' >> /etc/bind/named.conf                              
                  
 
[/CODE]

[SIZE=3]В /etc/bind/options.conf добавить[/SIZE]

[CODE]
tkey-gssapi-keytab "/var/lib/samba/bind-dns/dns.keytab";
  minimal-responses yes;                                                                      
 
[/CODE]

[QUOTE]
tkey-gssapi-keytab(путь к keytab для GSSAPI); minimal-responses(минимальные ответы DNS)
[/QUOTE]

[SIZE=3]Остановка BIND перед настройкой[/SIZE]

[CODE]
systemctl stop bind                                                                      
                                                                                              
 
[/CODE]

[SIZE=3]В /etc/sysconfig/network[/SIZE]

[CODE]
NETWORKING=yes                                                                           
  CONFMETHOD=etcnet                                                                           
  HOSTNAME=srv-hq.ad.team                                                                     
  RESOLV_MODS=yes                                                                             
 
[/CODE]

[QUOTE]
HOSTNAME(полное имя сервера с доменом); RESOLV_MODS(разрешить изменение resolv.conf)
[/QUOTE]

[SIZE=3]Установка hostname[/SIZE]

[CODE]
hostnamectl set-hostname srv-hq.ad.team;exec bash                                        
  domainname ad.team                                                                          
 
[/CODE]

[QUOTE]
exec bash перезагружает оболочку для применения изменений
[/QUOTE]

[SIZE=3]Очистка старых конфигураций[/SIZE]

[SIZE=3]Удаление старых файлов Samba[/SIZE]

[CODE]
rm -f /etc/samba/smb.conf                                                                
  rm -rf /var/lib/samba                                                                       
  rm -rf /var/cache/samba                                                                     
  mkdir -p /var/lib/samba/sysvol                                                              
 
[/CODE]

[QUOTE]
Конфликты зон возникают при одинаковых доменах в BIND и SAMBA BIND9_DLZ
[/QUOTE]

[SIZE=3]В /etc/resolv.conf указать локальный DNS[/SIZE]

[CODE]
nameserver 127.0.0.1                                                                     
 
[/CODE]

[QUOTE]
Контроллер домена должен использовать себя как DNS-сервер
[/QUOTE]

[SIZE=3]Создание домена[/SIZE]

[SIZE=3]Провижининг домена Samba AD[/SIZE]

[CODE]
samba-tool domain provision --realm=ad.team --domain=ad --adminpass='P@ssw0rd'           
  --dns-backend=BIND9_DLZ --server-role=dc --use-rfc2307                                      
 
[/CODE]

[QUOTE]
--realm(полное имя домена); --domain(NetBIOS имя); --dns-backend(BIND9_DLZ или SAMBA_INTERNAL); --server-role(dc - контроллер домена); --use-rfc2307(поддержка POSIX атрибутов)
[/QUOTE]

[SIZE=3]Запуск служб[/SIZE]

[CODE]
systemctl enable --now samba
  systemctl enable --now bind                                                                 
                                                                                              
 
[/CODE]

[SIZE=3]Копирование конфигурации Kerberos[/SIZE]

[CODE]
cp /var/lib/samba/private/krb5.conf /etc/krb5.conf                                       
                                                                                              
 
[/CODE]

[SIZE=3]Проверка контроллера домена[/SIZE]

[SIZE=3]Проверка информации о домене[/SIZE]

[CODE]
samba-tool domain info 127.0.0.1                                                         
                                                                                              
 
[/CODE]

[SIZE=3]Проверка DNS SRV-записей[/SIZE]

[CODE]
host -t SRV _kerberos._udp.ad.team                                                       
  host -t SRV _ldap._tcp.ad.team                                                              
  host -t A srv-hq.ad.team                                                                    
 
[/CODE]

[QUOTE]
SRV-записи должны указывать на контроллер домена
[/QUOTE]

[SIZE=3]Проверка Kerberos[/SIZE]

[CODE]
kinit administrator@AD.TEAM                                                              
  klist                                                                                       
 
[/CODE]

[QUOTE]
kinit(получение билета); klist(просмотр билетов); realm указывать ЗАГЛАВНЫМИ буквами
[/QUOTE]

[SIZE=3]Присоединение клиента к домену[/SIZE]

[SIZE=3]Установка пакетов на клиенте[/SIZE]

[CODE]
apt-get update && apt-get install -y task-auth-ad-sssd                                   
                                                                                              
 
[/CODE]

[SIZE=3]Запуск служб на клиенте[/SIZE]

[CODE]
systemctl enable --now smb winbind sssd                                                  
                                                                                              
 
[/CODE]

[SIZE=3]Содержимое /etc/krb5.conf на клиенте[/SIZE]

[CODE]
[libdefaults]                                                                            
  default_realm = AD.TEAM                                                                     
  dns_lookup_kdc = true
  dns_lookup_realm = false                                                                    
  ticket_lifetime = 24h                                                                       
  renew_lifetime = 7d                                                                         
  forwardable = true                                                                          
  rdns = false                                                                                
  default_ccache_name = KEYRING:persistent:%{uid}                                             
                                                                                              
  [realms]                                                                                    
  AD.TEAM={                                                                                   
          kdc = 192.168.11.67                                                                 
          default_domain = ad.team                                                            
          admin_server = 192.168.11.67                                                        
  }                                                                                           
                                                                                              
  [domain_realm]                                                                              
  .ad.team = AD.TEAM
  ad.team = AD.TEAM                                                                           
 
[/CODE]

[QUOTE]
kdc(IP контроллера домена); ticket_lifetime(время жизни билета); renew_lifetime(время обновления); forwardable(передача билета)
[/QUOTE]

[SIZE=3]В /etc/resolv.conf на клиенте[/SIZE]

[CODE]
domain ad.team
  nameserver 192.168.11.67                                                                    
  nameserver 192.168.33.67                                                                    
  nameserver 8.8.8.8                                                                          
 
[/CODE]

[QUOTE]
Первым указывать IP контроллера домена
[/QUOTE]

[SIZE=3]Проверка Kerberos на клиенте[/SIZE]

[CODE]
kinit administrator                                                                      
  klist                                                                                       
                                                                                              
 
[/CODE]

[SIZE=3]Присоединение к домену[/SIZE]

[CODE]
net ads join -U administrator@AD.TEAM -S 192.168.11.67                                   
 
[/CODE]

[QUOTE]
-U(пользователь); -S(IP сервера)
[/QUOTE]

[SIZE=3]Проверка DNS на клиенте[/SIZE]

[CODE]
host srv-hq                                                                              
  host $(hostname)                                                                            
                                                                                              
 
[/CODE]

[SIZE=3]Перезагрузка клиента[/SIZE]

[CODE]
reboot                                                                                   
                                                                                              
 
[/CODE]

[SIZE=3]Вход под доменным пользователем[/SIZE]

[CODE]
su -
  id
[/CODE]

[SIZE=4]bind_DNS[/SIZE]

[SIZE=3]Установка DNS-сервера[/SIZE]

[SIZE=3]Установка пакетов[/SIZE]

[CODE]
apt-get install bind bind-utils


[/CODE]

[SIZE=3]Настройка options.conf[/SIZE]

[SIZE=3]Базовые параметры в /etc/bind/options.conf[/SIZE]

[CODE]
listen-on { any; };
 allow-query { any; };
 allow-recursion { any; };
 forwarders { 77.88.8.8; };
 recursion yes;

[/CODE]

[QUOTE]
listen-on(интерфейсы); allow-query(разрешение запросов); allow-recursion(рекурсивные запросы); forwarders(DNS для пересылки); recursion(включение рекурсии)
[/QUOTE]

[SIZE=3]Опциональная настройка slave-сервера в /etc/bind/options.conf[/SIZE]

[CODE]
allow-transfer { 192.168.33.67; };

[/CODE]

[QUOTE]
allow-transfer(разрешение передачи зон на slave-сервер) - опционально, только если используется slave
[/QUOTE]

[SIZE=3]Отключение логирования lame-servers в /etc/bind/options.conf[/SIZE]

[CODE]
logging {
     category lame-servers {null;};
 };


[/CODE]

[SIZE=3]Настройка local.conf[/SIZE]

[SIZE=3]Шаблон зоны[/SIZE]

[CODE]
zone "ZONE_NAME" {
     type TYPE;
     file "ZONE_FILE_PATH";
 };

[/CODE]

[QUOTE]
ZONE_NAME(имя DNS-зоны); TYPE(тип зоны) {master, slave}; ZONE_FILE_PATH(путь к файлу зоны относительно /etc/bind/)
[/QUOTE]

[QUOTE]
slave опционален - используется только для вторичных DNS-серверов
[/QUOTE]

[SIZE=3]Пример прямой зоны в /etc/bind/local.conf[/SIZE]

[CODE]
zone "bind.domain" {
     type master;
     file "bind.domain.db";
 };


[/CODE]

[SIZE=3]Пример обратных зон в /etc/bind/local.conf[/SIZE]

[CODE]
zone "11.168.192.in-addr.arpa" {
     type master;
     file "11.168.192.in-addr.arpa.db";
 };


[/CODE]

[SIZE=3]Создание файлов зон[/SIZE]

[SIZE=3]Копирование шаблонов[/SIZE]

[CODE]
cp /etc/bind/zone/{localhost,bind.domain.db}
 cp /etc/bind/zone/127.in-addr.arpa /etc/bind/zone/11.168.192.in-addr.arpa.db
 cp /etc/bind/zone/127.in-addr.arpa /etc/bind/zone/33.168.192.in-addr.arpa.db


[/CODE]

[SIZE=3]Назначение прав[/SIZE]

[CODE]
chown named:named /etc/bind/zone/bind.domain.db
 chown named:named /etc/bind/zone/11.168.192.in-addr.arpa.db
 chown named:named /etc/bind/zone/33.168.192.in-addr.arpa.db


[/CODE]

[SIZE=3]Настройка зон[/SIZE]

[SIZE=3]Содержимое прямой зоны /etc/bind/zone/bind.domain.db[/SIZE]

[CODE]
$TTL 1d

 @       IN SOA  bind.domain. root.bind.domain. (
                 2021102900
                 12h
                 1h
                 1w
                 1h
 )

         IN NS   srv-hq.bind.domain.
         IN NS   srv-dt.bind.domain.

         IN A    192.168.11.67
 srv  IN A    192.168.11.67
 rtr  IN A    192.168.11.81
 sw   IN A    192.168.11.82

[/CODE]

[QUOTE]
SOA(главная запись зоны); NS(DNS-сервер зоны); A(соответствие домена IPv4); MX(почтовый сервер); CNAME(псевдоним); TXT(текстовые записи)
[/QUOTE]

[SIZE=3]Содержимое обратной зоны /etc/bind/zone/11.168.192.in-addr.arpa.db[/SIZE]

[CODE]
$TTL 1d

 @       IN SOA  bind.domain. root.bind.domain. (
                 2021102900
                 12h
                 1h
                 1w
                 1h
 )

         IN NS   bind.domain.

 81      IN PTR  rtr.bind.domain.
 67      IN PTR  srv.bind.domain.
 82      IN PTR  sw.bind.domain.


[/CODE]

[SIZE=3]Настройка resolv.conf[/SIZE]

[SIZE=3]Содержимое /etc/net/ifaces/ens33/resolv.conf[/SIZE]

[CODE]
search bind.domain
 nameserver 192.168.11.67
 nameserver 192.168.33.67
 nameserver 8.8.8.8

[/CODE]

[QUOTE]
nameserver(DNS-сервер); search(домен поиска по умолчанию)
[/QUOTE]

[SIZE=3]Перезапуск сети[/SIZE]

[CODE]
systemctl restart network


[/CODE]

[SIZE=3]Проверка конфигурации[/SIZE]

[SIZE=3]Проверка всех зон[/SIZE]

[CODE]
named-checkconf -z


[/CODE]

[SIZE=3]Проверка отдельной прямой зоны[/SIZE]

[CODE]
named-checkzone bind.domain /etc/bind/zone/bind.domain.db


[/CODE]

[SIZE=3]Проверка отдельной обратной зоны[/SIZE]

[CODE]
named-checkzone 11.168.192.in-addr.arpa /etc/bind/zone/11.168.192.in-addr.arpa.db


[/CODE]

[SIZE=3]Запуск BIND[/SIZE]

[SIZE=3]Включение и запуск сервиса[/SIZE]

[CODE]
systemctl enable --now bind
[/CODE]

[SIZE=4]bind_slave_DNS[/SIZE]

[SIZE=3]Настройка slave DNS-сервера[/SIZE]

[SIZE=3]Установка пакетов[/SIZE]

[CODE]
apt-get update && apt-get install -y bind bind-utils                                     
                                                                                              
 
[/CODE]

[SIZE=3]Базовые параметры в /etc/bind/options.conf[/SIZE]

[CODE]
listen-on { any; };                                                                      
  allow-query { any; };                                                                       
  allow-transfer { none; };                                                                   
                                                                                              
 
[/CODE]

[SIZE=3]Настройка slave-зон в /etc/bind/local.conf[/SIZE]

[CODE]
zone "bind.domain" {                                                                     
      type slave;                                                                             
      file "slave/bind.domain";                                                               
      masters { 192.168.11.67; };                                                             
  };                                                                                          
                                                                                              
  zone "11.168.192.in-addr.arpa" {                                                            
      type slave; 
      file "slave/11.168.192.in-addr.arpa.db";                                                
      masters { 192.168.11.67; };                                                             
  };                                                                                          
                                                                                              
  zone "33.168.192.in-addr.arpa" {                                                            
      type slave;                                                                             
      file "slave/33.168.192.in-addr.arpa.db";                                                
      masters { 192.168.11.67; };                                                             
  };                                                                                          
 
[/CODE]

[QUOTE]
type slave(вторичный сервер); masters(IP master-сервера для синхронизации)
[/QUOTE]

[SIZE=3]Содержимое /etc/net/ifaces/ens33/resolv.conf[/SIZE]

[CODE]
search bind.domain                                                                       
  nameserver 192.168.11.67                                                                    
  nameserver 192.168.33.67                                                                    
  nameserver 8.8.8.8                                                                          
                                                                                              
 
[/CODE]

[SIZE=3]Перезапуск сети и запуск BIND[/SIZE]

[CODE]
systemctl restart network                                                                
  systemctl enable --now bind                                                                 
                                                                                              
 
[/CODE]

[SIZE=3]Включение slave-режима[/SIZE]

[CODE]
control bind-slave enabled                                                               
                                                                                              
 
[/CODE]

[SIZE=3]Проверка slave-режима[/SIZE]

[SIZE=3]Проверка синхронизированных зон[/SIZE]

[CODE]
ls -l /etc/bind/zone/slave/                                                              
 
[/CODE]

[QUOTE]
Должны появиться файлы зон, скопированные с master-сервера
[/QUOTE]

[SIZE=4]chrony[/SIZE]

[SIZE=3]Установка и настройка Chrony NTP-сервера[/SIZE]

[SIZE=3]Установка пакета[/SIZE]

[CODE]
apt-get install -y chrony

 
[/CODE]

[SIZE=3]Запуск службы[/SIZE]

[CODE]
systemctl enable --now chronyd

 
[/CODE]

[SIZE=3]Настройка NTP-сервера[/SIZE]

[QUOTE]
Сервер получает время от внешнего NTP и раздаёт время клиентам
[/QUOTE]

[SIZE=3]Отключение стандартных pool в /etc/chrony.conf[/SIZE]

[CODE]
sed -i 's/^pool/#pool/' /etc/chrony.conf                                                 
                                                                                              
 
[/CODE]

[SIZE=3]Добавление внешнего NTP-сервера в /etc/chrony.conf[/SIZE]

[CODE]
server ntp2.vniiftri.ru iburst prefer minstratum 4                                       
  local stratum 5                                                                             
  allow 192.168.11.0/26                                                                       
  allow 192.168.11.64/28                                                                      
  allow 192.168.11.80/29                                                                      
  makestep 1.0 3                                                                              
 
[/CODE]

[QUOTE]
server(внешний NTP-сервер); iburst(быстрая синхронизация); prefer(предпочтительный сервер); minstratum 4(минимальный уровень источника); local stratum 5(локальный уровень сервера); allow(разрешить клиентам подключаться); makestep 1.0 3(корректировать время скачком, если расхождение больше 1 секунды, в первые 3 обновления)
[/QUOTE]

[SIZE=3]Перезапуск службы[/SIZE]

[CODE]
systemctl restart chronyd
                                                                                              
 
[/CODE]

[SIZE=3]Разрешение NTP в firewall[/SIZE]

[SIZE=3]Разрешение UDP 123 в iptables[/SIZE]

[CODE]
iptables -A INPUT -p udp --dport 123 -j ACCEPT
  iptables -A OUTPUT -p udp --sport 123 -j ACCEPT                                             
 
[/CODE]

[QUOTE]
UDP порт 123 используется для NTP
[/QUOTE]

[SIZE=3]Разрешение UDP 123 в nftables[/SIZE]

[CODE]
nft add rule inet filter input udp dport 123 accept                                      
  nft add rule inet filter output udp sport 123 accept                                        
                                                                                              
 
[/CODE]

[SIZE=3]Проверка NTP-сервера[/SIZE]

[SIZE=3]Проверка синхронизации[/SIZE]

[CODE]
chronyc tracking
 
[/CODE]

[QUOTE]
Показывает текущий источник времени, stratum, смещение, стабильность
[/QUOTE]

[SIZE=3]Проверка источников[/SIZE]

[CODE]
chronyc sources                                                                          
 
[/CODE]

[QUOTE]
Показывает список NTP-серверов и их статус
[/QUOTE]

[SIZE=3]Проверка статуса службы[/SIZE]

[CODE]
systemctl status chronyd                                                                 
                                                                                              
 
[/CODE]

[SIZE=3]Проверка открытого UDP-порта 123[/SIZE]

[CODE]
ss -ulnp | grep 123
                                                                                              
 
[/CODE]

[SIZE=3]Настройка NTP-клиента[/SIZE]

[QUOTE]
Клиент синхронизирует время с локальным NTP-сервером
[/QUOTE]

[SIZE=3]Установка пакета[/SIZE]

[CODE]
apt-get install -y chrony                                                                
                                                                                              
 
[/CODE]

[SIZE=3]Отключение стандартных pool[/SIZE]

[CODE]
sed -i 's/^pool/#pool/' /etc/chrony.conf                                                 
                                                                                              
 
[/CODE]

[SIZE=3]Добавление локального NTP-сервера в /etc/chrony.conf[/SIZE]

[CODE]
echo "server 192.168.11.67 iburst" >> /etc/chrony.conf                                   
                                                                                              
 
[/CODE]

[SIZE=3]Перезапуск службы[/SIZE]

[CODE]
systemctl restart chronyd                                                                
                                                                                              
 
[/CODE]

[SIZE=3]Проверка NTP-клиента[/SIZE]

[SIZE=3]Проверка источников синхронизации[/SIZE]

[CODE]
chronyc sources
 
[/CODE]

[QUOTE]
^* означает текущий активный сервер
[/QUOTE]

[SIZE=3]Проверка текущего времени[/SIZE]

[CODE]
timedatectl                                                                              
                                                                                              
 
[/CODE]

[SIZE=3]Принудительная синхронизация[/SIZE]

[CODE]
chronyc makestep                                                                         
                                                                                              
 
[/CODE]

[SIZE=3]Подробная статистика[/SIZE]

[CODE]
chronyc sourcestats
[/CODE]

[SIZE=4]cups-pdf[/SIZE]

[SIZE=3]Установка и настройка CUPS[/SIZE]

[SIZE=3]Установка пакетов на сервере[/SIZE]

[CODE]
apt-get install cups cups-pdf                                                            
   
 
[/CODE]

[SIZE=3]Настройка CUPS-сервера[/SIZE]

[SIZE=3]Изменение конфигурации в /etc/cups/cupsd.conf[/SIZE]

[CODE]
Listen *:631                                                                             
                                                                                              
  <Location />                                                                                
  Order allow,deny                                                                            
  Allow all                                                                                   
  </Location>                                                                                 
   
  <Location /admin>                                                                           
  Order allow,deny
  Allow all                                                                                   
  </Location>     
 
[/CODE]

[QUOTE]
Listen *:631(слушать порт 631 на всех интерфейсах); <Location />(доступ к основной странице); <Location /admin>(доступ к панели администратора); Allow all(разрешить всем клиентам)
[/QUOTE]

[QUOTE]
Для ограничения доступа по подсетям замените Allow all на Allow from 192.168.1.0/24
[/QUOTE]

[SIZE=3]Запуск и включение службы[/SIZE]

[CODE]
systemctl enable cups                                                                    
  systemctl restart cups                                                                      
                                                                                              
 
[/CODE]

[SIZE=3]Проверка доступных принтеров[/SIZE]

[CODE]
lpstat -p                                                                                
 
[/CODE]

[QUOTE]
Показывает список принтеров и их статус
[/QUOTE]

[SIZE=3]Подключение клиента к CUPS[/SIZE]

[SIZE=3]Установка пакетов на клиенте[/SIZE]

[CODE]
apt-get install cups                                                                     
                  
 
[/CODE]

[SIZE=3]Подключение сетевого принтера[/SIZE]

[CODE]
lpadmin -p PDF -E -v ipp://192.168.1.10:631/printers/PDF -m everywhere
 
[/CODE]

[QUOTE]
-p(имя принтера); -E(включить принтер); -v(URI принтера); -m everywhere(автоматический драйвер)
[/QUOTE]

[QUOTE]
Формат URI: ipp://IP_СЕРВЕРА:631/printers/ИМЯ_ПРИНТЕРА
[/QUOTE]

[SIZE=3]Назначение принтера по умолчанию[/SIZE]

[CODE]
lpoptions -d PDF                                                                         
                                                                                              
 
[/CODE]

[SIZE=3]Проверка подключения[/SIZE]

[CODE]
lpstat -t                                                                                
 
[/CODE]

[QUOTE]
Показывает список принтеров, очередь печати, принтер по умолчанию, состояние службы
[/QUOTE]

[SIZE=3]Работа с CUPS[/SIZE]

[SIZE=3]Печать документа[/SIZE]

[CODE]
echo "Тест печати" | lp -t "Example"                                                     
 
[/CODE]

[QUOTE]
lp(команда печати); -t(название задания)
[/QUOTE]

[SIZE=3]Проверка PDF-файлов на сервере[/SIZE]

[CODE]
ls -l /home/USERNAME/                                                                    
 
[/CODE]

[QUOTE]
При использовании cups-pdf документы сохраняются в домашнем каталоге пользователя клиента
[/QUOTE]

[SIZE=3]Web-интерфейс[/SIZE]

[CODE]
http://IP_СЕРВЕРА:631                                                                    
 
[/CODE]

[QUOTE]
Управление принтерами, очередью и заданиями
[/QUOTE]

[SIZE=3]Полезные команды[/SIZE]

[SIZE=3]Просмотр очереди печати[/SIZE]

[CODE]
lpq                                                                                      
                                                                                              
 
[/CODE]

[SIZE=3]Отмена задания[/SIZE]

[CODE]
cancel ID_ЗАДАНИЯ                                                                        
                                                                                              
 
[/CODE]

[SIZE=3]Список устройств[/SIZE]

[CODE]
lpinfo -v
[/CODE]

[SIZE=4]dhcpd[/SIZE]

[SIZE=3]Установка DHCP-сервера[/SIZE]

[SIZE=3]Установка пакета[/SIZE]

[CODE]
apt-get install dhcp-server                                                              
                                                                                              
 
[/CODE]

[SIZE=3]Определение сетевого интерфейса[/SIZE]

[CODE]
ip a -c                                                                                  
                                                                                              
 
[/CODE]

[SIZE=3]Настройка интерфейса в /etc/sysconfig/dhcpd[/SIZE]

[CODE]
DHCPDARGS=ens34                                                                          
 
[/CODE]

[QUOTE]
Указывает интерфейс, который будет раздавать IP-адреса
[/QUOTE]

[SIZE=3]Настройка DHCP-сервера[/SIZE]

[SIZE=3]Основная конфигурация в /etc/dhcp/dhcpd.conf[/SIZE]

[CODE]
ddns-update-style none;                                                                  
                                                                                              
  subnet 192.168.11.0 netmask 255.255.255.192 {                                               
          option routers                  192.168.11.1;                                       
          option domain-name              "bind.domain";                                      
          option domain-name-servers      77.88.8.8,192.168.11.1;                             
                                                                                              
          range dynamic-bootp 192.168.11.2 192.168.11.63;                                     
          default-lease-time 21600;                                                           
          max-lease-time 43200;                                                               
                                                                                              
  host R-HQ {                                                                                 
          hardware ethernet 00:0c:29:41:f2:9f;                                                
          fixed-address 192.168.11.1;                                                         
  }                                                                                           
  }                                                                                           
 
[/CODE]

[QUOTE]
subnet(определение подсети); range(диапазон выдаваемых адресов); option routers(шлюз по умолчанию); option domain-name-servers(DNS-серверы); default-lease-time(время аренды по умолчанию в секундах); max-lease-time(максимальное время аренды); host(резервирование IP по MAC-адресу)
[/QUOTE]

[SIZE=3]Проверка конфигурации[/SIZE]

[CODE]
dhcpd -t -cf /etc/dhcp/dhcpd.conf
                                                                                              
 
[/CODE]

[SIZE=3]Запуск и включение службы[/SIZE]

[CODE]
systemctl enable --now dhcpd                                                             
                                                                                              
 
[/CODE]

[SIZE=3]Проверка DHCP-сервера[/SIZE]

[SIZE=3]Проверка статуса службы[/SIZE]

[CODE]
systemctl status dhcpd                                                                   
                                                                                              
 
[/CODE]

[SIZE=3]Настройка DHCP-клиента[/SIZE]

[SIZE=3]Получение IP-адреса от DHCP-сервера[/SIZE]

[CODE]
dhcpcd                                                                                   
 
[/CODE]

[QUOTE]
Клиент получит IP-адрес, шлюз и DNS-серверы из конфигурации сервера
[/QUOTE]

[SIZE=4]dhcpd_failover[/SIZE]

[SIZE=3]Настройка DHCP failover[/SIZE]

[QUOTE]
Failover обеспечивает отказоустойчивость DHCP: если один сервер выходит из строя, второй продолжает выдавать IP-адреса
[/QUOTE]

[QUOTE]
Общие настройки (subnets, options) выносятся в отдельные файлы и копируются на оба сервера, специфичные настройки (primary/secondary) остаются в основном файле dhcpd.conf
[/QUOTE]

[SIZE=3]Создание директории для конфигураций на primary[/SIZE]

[CODE]
mkdir /etc/dhcp/dhcpd.conf.d
  cat /etc/dhcp/dhcpd.conf > /etc/dhcp/dhcpd.conf.d/subnets.conf                              
                                                                                              
 
[/CODE]

[SIZE=3]Настройка include в /etc/dhcp/dhcpd.conf на primary[/SIZE]

[CODE]
echo include \"/etc/dhcp/dhcpd.conf.d/subnets.conf\"\; > /etc/dhcp/dhcpd.conf            
                                                                                              
 
[/CODE]

[SIZE=3]Настройка failover primary в /etc/dhcp/dhcpd.conf[/SIZE]

[CODE]
failover peer "dhcp-failover" {                                                          
       primary;                                                                               
       address 10.10.10.101;                                                                  
       port 519;                                                                              
       peer address 10.10.10.102;                                                             
       peer port 520;                                                                         
       max-response-delay 60;                                                                 
       max-unacked-updates 10;                                                                
       mclt 3600;                                                                             
       split 128;                                                                             
       load balance max seconds 3;                                                            
  }                                                                                           
                                                                                              
  include "/etc/dhcp/dhcpd.conf.d/subnets.conf";                                              
 
[/CODE]

[QUOTE]
primary(основной сервер); address(адрес текущего сервера); port(порт текущего сервера); peer address(адрес secondary); peer port(порт secondary); max-response-delay(секунд до признания второго сервера недоступным); max-unacked-updates(максимум пакетов bind-update); mclt(максимальное время lease без уведомления второго сервера, только на primary); split 128(распределение адресов 50/50%, только на primary); load balance max seconds(секунд ожидания ответа второго сервера)
[/QUOTE]

[SIZE=3]Добавление failover peer в /etc/dhcp/dhcpd.conf.d/subnets.conf[/SIZE]

[CODE]
subnet 10.10.20.0 netmask 255.255.255.0 {
    option routers 10.10.20.1;                                                                
    pool {                                                                                    
      failover peer "dhcp-failover";                                                          
      range 10.10.20.50 10.10.20.200;                                                         
    }                                                                                         
  }                                                                                           
 
[/CODE]

[QUOTE]
pool(пул адресов с failover); failover peer(указание пира для отказоустойчивости)
[/QUOTE]

[SIZE=3]Проверка и перезапуск на primary[/SIZE]

[CODE]
dhcpd -t -cf /etc/dhcp/dhcpd.conf                                                        
  systemctl restart dhcpd                                                                     
                                                                                              
 
[/CODE]

[SIZE=3]Копирование конфигурации на secondary[/SIZE]

[CODE]
scp -r /etc/dhcp/dhcpd.conf /etc/dhcp/dhcpd.conf.d root@10.10.10.102:/etc/dhcp/          
 
[/CODE]

[QUOTE]
При изменении конфигурации необходимо копировать файлы на второй сервер
[/QUOTE]

[SIZE=3]Настройка failover secondary в /etc/dhcp/dhcpd.conf[/SIZE]

[CODE]
failover peer "dhcp-failover" {                                                          
      secondary;                                                                              
      address 10.10.10.102;                                                                   
      port 520;                                                                               
      peer address 10.10.10.101;                                                              
      peer port 519;                                                                          
      max-response-delay 60;                                                                  
      max-unacked-updates 10;                                                                 
      load balance max seconds 3;                                                             
  }                                                                                           
                                                                                              
  include "/etc/dhcp/dhcpd.conf.d/subnets.conf";                                              
 
[/CODE]

[QUOTE]
secondary(вторичный сервер); без параметров mclt и split так как они только на primary
[/QUOTE]

[SIZE=3]Проверка и перезапуск на secondary[/SIZE]

[CODE]
dhcpd -t -cf /etc/dhcp/dhcpd.conf                                                        
  systemctl restart dhcpd
[/CODE]

[SIZE=4]dnsmasq[/SIZE]

[SIZE=3]Установка и настройка dnsmasq[/SIZE]

[SIZE=3]Установка пакета[/SIZE]

[CODE]
apt-get install dnsmasq

 
[/CODE]

[SIZE=3]Включение автозапуска[/SIZE]

[CODE]
systemctl enable --now dnsmasq

 
[/CODE]

[SIZE=3]Настройка DNS в dnsmasq[/SIZE]

[SIZE=3]Конфигурация DNS в /etc/dnsmasq.conf[/SIZE]

[CODE]
domain=domain.example

server=/domain.example/192.168.5.2
server=77.88.8.8

interface=*

address=/hq-rtr.domain.example/192.168.1.1
ptr-record=1.1.168.192.in-addr.arpa,hq-rtr.domain.example

address=/docker.domain.example/172.16.1.1
address=/web.domain.example/172.16.2.1

address=/br-rtr.domain.example/192.168.5.1

address=/hq-srv.domain.example/192.168.1.2
ptr-record=2.1.168.192.in-addr.arpa,hq-srv.domain.example

address=/hq-cli.domain.example/192.168.5.3
ptr-record=3.5.168.192.in-addr.arpa,hq-cli.domain.example

address=/br-srv.domain.example/192.168.5.2 
 
 
[/CODE]

[QUOTE]
listen-address(IP-адреса для приёма DNS-запросов); domain(локальный домен сети); local(запрет пересылки локальной зоны во внешний DNS); cache-size(размер DNS-кэша); server(внешний DNS-сервер для пересылки); expand-hosts(использовать /etc/hosts); log-queries(логирование DNS-запросов); log-facility(файл логов)
[/QUOTE]

[SIZE=3]Типы DNS-записей в dnsmasq[/SIZE]

[SIZE=3]A-запись в /etc/dnsmasq.conf[/SIZE]

[CODE]
address=/host.example.com/192.168.0.10
 
[/CODE]

[QUOTE]
Соответствие доменного имени IPv4-адресу
[/QUOTE]

[SIZE=3]AAAA-запись в /etc/dnsmasq.conf[/SIZE]

[CODE]
address=/host.example.com/2001:db8::1
 
[/CODE]

[QUOTE]
Соответствие доменного имени IPv6-адресу
[/QUOTE]

[SIZE=3]CNAME-запись в /etc/dnsmasq.conf[/SIZE]

[CODE]
cname=alias.example.com,host.example.com
 
[/CODE]

[QUOTE]
Псевдоним для существующего доменного имени
[/QUOTE]

[SIZE=3]MX-запись в /etc/dnsmasq.conf[/SIZE]

[CODE]
mx-host=example.com,mail.example.com,10
 
[/CODE]

[QUOTE]
Почтовый сервер для домена, цифра указывает приоритет
[/QUOTE]

[SIZE=3]TXT-запись в /etc/dnsmasq.conf[/SIZE]

[CODE]
txt-record=example.com,"v=spf1 mx a -all"
 
[/CODE]

[QUOTE]
Текстовые записи для SPF, DMARC, верификации
[/QUOTE]

[SIZE=3]SRV-запись в /etc/dnsmasq.conf[/SIZE]

[CODE]
srv-host=_service._tcp.example.com,target.example.com,443,10,10
 
[/CODE]

[QUOTE]
Указание сервиса, порта и приоритета
[/QUOTE]

[SIZE=3]PTR-запись в /etc/dnsmasq.conf[/SIZE]

[CODE]
ptr-record=10.0.168.192.in-addr.arpa,host.example.com
 
[/CODE]

[QUOTE]
Обратное преобразование IP-адреса в доменное имя
[/QUOTE]

[SIZE=3]Настройка DHCP в dnsmasq[/SIZE]

[SIZE=3]Конфигурация DHCP в /etc/dnsmasq.conf[/SIZE]

[CODE]
interface=ens3
  bind-interfaces
  no-resolv
  dhcp-range=192.168.0.50,192.168.0.150,12h
  dhcp-host=ignored,192.168.1.50,ignore
  dhcp-host=aa:bb:cc:dd:ee:ff,192.168.1.51

  dhcp-option=3,192.168.0.1
  dhcp-option=6,192.168.0.1
  dhcp-option=15,no.do
 
[/CODE]

[QUOTE]
interface(интерфейс для работы DHCP); bind-interfaces(работать только на указанном интерфейсе); dhcp-range(диапазон IP-адресов и время аренды); dhcp-option=3(шлюз по умолчанию); dhcp-option=6(DNS-сервер); dhcp-option=15(доменное имя сети)
[/QUOTE]

[SIZE=3]Дополнительные параметры в /etc/dnsmasq.conf[/SIZE]

[CODE]
user=nobody
  group=nogroup
 
[/CODE]

[QUOTE]
user(пользователь процесса); group(группа процесса); except-interface(исключить интерфейс из работы dnsmasq); no-resolv(запрещает использовать /etc/resolv.conf); dhcp-host(исключить адрес из выдачи)
[/QUOTE]

[SIZE=3]Применение конфигурации[/SIZE]

[CODE]
systemctl restart dnsmasq

 
[/CODE]

[SIZE=3]Проверка dnsmasq[/SIZE]

[SIZE=3]Проверка статуса службы[/SIZE]

[CODE]
systemctl status dnsmasq
[/CODE]

[SIZE=4]encryption_devices[/SIZE]

[SIZE=3]Шифрование раздела с LUKS[/SIZE]

[SIZE=3]Создание ключа шифрования[/SIZE]

[CODE]
dd if=/dev/urandom of=/root/ext4.key bs=1024 count=4                                     
 
[/CODE]

[QUOTE]
Генерация случайного ключа размером 4 КБ
[/QUOTE]

[SIZE=3]Шифрование раздела с указанным ключом[/SIZE]

[CODE]
cryptsetup luksFormat /dev/data_striped/lv_data /root/ext4.key                           
 
[/CODE]

[QUOTE]
Инициализация LUKS-шифрования на разделе
[/QUOTE]

[SIZE=3]Открытие зашифрованного раздела[/SIZE]

[CODE]
cryptsetup luksOpen /dev/data_striped/lv_data data_crypt --key-file /root/ext4.key       
 
[/CODE]

[QUOTE]
Открывает зашифрованный раздел как /dev/mapper/data_crypt
[/QUOTE]

[SIZE=3]Форматирование раздела[/SIZE]

[CODE]
mkfs.ext4 /dev/mapper/data_crypt                                                         
                                                                                              
 
[/CODE]

[SIZE=3]Автоматическая разблокировка при загрузке[/SIZE]

[SIZE=3]Настройка автоматической разблокировки в /etc/crypttab[/SIZE]

[CODE]
data_crypt /dev/data_striped/lv_data /root/ext4.key luks                                 
 
[/CODE]

[QUOTE]
Формат: имя устройство ключ тип
[/QUOTE]

[SIZE=3]Проверка синтаксиса[/SIZE]

[CODE]
systemctl daemon-reexec                                                                  
  systemctl restart systemd-cryptsetup@data_crypt                                             
                                                                                              
 
[/CODE]

[SIZE=3]Монтирование раздела[/SIZE]

[SIZE=3]Настройка автомонтирования в /etc/fstab[/SIZE]

[CODE]
/dev/mapper/data_crypt /opt/data ext4 defaults 0 2                                       
 
[/CODE]

[QUOTE]
Формат: устройство точка_монтирования файловая_система опции dump fsck
[/QUOTE]

[SIZE=3]Защита ключа шифрования[/SIZE]

[SIZE=3]Установка прав доступа на ключ[/SIZE]

[CODE]
chmod 600 /root/ext4.key                                                                 
  chown root:root /root/ext4.key                                                              
 
[/CODE]

[QUOTE]
Только root может читать и записывать ключ
[/QUOTE]

[SIZE=3]Применение настроек[/SIZE]

[SIZE=3]Перезагрузка системы[/SIZE]

[CODE]
reboot                                                                                   
                                                                                              
 
[/CODE]

[SIZE=3]Проверка монтирования[/SIZE]

[CODE]
df -h                                                                                    
 
[/CODE]

[QUOTE]
Проверка, что зашифрованный раздел смонтирован
[/QUOTE]

[SIZE=4]etcnet_gre_tunnel[/SIZE]

[SIZE=3]Настройка GRE-туннеля[/SIZE]

[SIZE=3]Включение IP-forwarding в /etc/net/sysctl.conf[/SIZE]

[CODE]
net.ipv4.ip_forward=1                                                                    
 
[/CODE]

[QUOTE]
Разрешает маршрутизацию пакетов между интерфейсами
[/QUOTE]

[SIZE=3]Применение настроек sysctl[/SIZE]

[CODE]
sysctl -p                                                                                
                                                                                              
 
[/CODE]

[SIZE=3]Создание каталога для туннельного интерфейса[/SIZE]

[CODE]
mkdir -p /etc/net/ifaces/tun                                                             
                                                                                              
 
[/CODE]

[SIZE=3]Настройка параметров туннеля в /etc/net/ifaces/tun/options[/SIZE]

[CODE]
TYPE=iptun                                                                               
  TUNTYPE=gre                                                                                 
  TUNLOCAL=172.16.4.1
  TUNREMOTE=172.16.5.1                                                                        
  TUNOPTIONS='ttl 64'                                                                         
  TUNTTL=64                                                                                   
  TUNMTU=1476                                                                                 
 
[/CODE]

[QUOTE]
TYPE=iptun(тип интерфейса - IP-туннель); TUNTYPE=gre(протокол туннелирования GRE); TUNLOCAL(локальный IP внешнего интерфейса); TUNREMOTE(удалённый IP внешнего интерфейса); TUNTTL(время жизни пакета); TUNMTU(максимальный размер пакета)
[/QUOTE]

[SIZE=3]Настройка IP-адреса туннеля в /etc/net/ifaces/tun/ipv4address[/SIZE]

[CODE]
10.10.10.2/30
 
[/CODE]

[QUOTE]
Внутренний IP-адрес туннеля с маской /30
[/QUOTE]

[SIZE=3]Перезапуск сети[/SIZE]

[CODE]
systemctl restart network                                                                
                                                                                              
 
[/CODE]

[QUOTE]
Аналогичную настройку необходимо выполнить на втором роутере с зеркальными параметрами TUNLOCAL и TUNREMOTE
[/QUOTE]

[SIZE=4]etcnet_ip[/SIZE]

[SIZE=3]Настройка сетевых интерфейсов в ALT Linux[/SIZE]

[QUOTE]
Конфигурация интерфейсов хранится в /etc/net/ifaces/
[/QUOTE]

[QUOTE]
Рекомендуется добавлять интерфейсы по одному, чтобы избежать изменения имён
[/QUOTE]

[SIZE=3]Создание конфигурации интерфейса[/SIZE]

[SIZE=3]Создание каталога интерфейса[/SIZE]

[CODE]
mkdir -p /etc/net/ifaces/ens32                                                           
                                                                                              
 
[/CODE]

[SIZE=3]Копирование конфигурации существующего интерфейса[/SIZE]

[CODE]
cp /etc/net/ifaces/ens33/options /etc/net/ifaces/ens32/                                  
 
[/CODE]

[QUOTE]
Опционально, если уже есть настроенный интерфейс
[/QUOTE]

[SIZE=3]Настройка параметров интерфейса[/SIZE]

[SIZE=3]Базовая конфигурация в /etc/net/ifaces/ens32/options[/SIZE]

[CODE]
TYPE=eth                                                                                 
  BOOTPROTO=static                                                                            
  CONFIG_IPV4=yes                                                                             
 
[/CODE]

[QUOTE]
TYPE=eth(тип интерфейса Ethernet); BOOTPROTO(протокол получения IP) {static, dhcp}; CONFIG_IPV4=yes(включение IPv4)
[/QUOTE]

[SIZE=3]Настройка IP-адреса в /etc/net/ifaces/ens32/ipv4address[/SIZE]

[CODE]
192.168.11.67/28
  192.168.33.67/32                                                                            
 
[/CODE]

[QUOTE]
IP-адрес обязательно указывается с маской сети, можно указать несколько адресов
[/QUOTE]

[SIZE=3]Настройка шлюза в /etc/net/ifaces/ens32/ipv4route[/SIZE]

[CODE]
default via 192.168.11.1                                                                 
 
[/CODE]

[QUOTE]
default(маршрут по умолчанию); via(IP-адрес маршрутизатора)
[/QUOTE]

[SIZE=3]Применение изменений[/SIZE]

[CODE]
systemctl restart network                                                                
                                                                                              
 
[/CODE]

[SIZE=3]Ручное управление интерфейсами[/SIZE]

[SIZE=3]Запуск интерфейса[/SIZE]

[CODE]
ifup ens32                                                                               
                                                                                              
 
[/CODE]

[SIZE=3]Остановка интерфейса[/SIZE]

[CODE]
ifdown ens32                                                                             
                                                                                              
 
[/CODE]

[SIZE=3]Ручное управление маршрутами[/SIZE]

[SIZE=3]Добавление шлюза[/SIZE]

[CODE]
ip route add default via 192.168.11.1                                                    
                                                                                              
 
[/CODE]

[SIZE=3]Удаление шлюза[/SIZE]

[CODE]
ip route del default via 192.168.11.1                                                    
                                                                                              
 
[/CODE]

[SIZE=3]Проверка маршрутов[/SIZE]

[CODE]
ip route                                                                                 
                                                                                              
 
[/CODE]

[SIZE=3]Проверка интерфейсов[/SIZE]

[SIZE=3]Просмотр интерфейсов[/SIZE]

[CODE]
ip a
[/CODE]

[SIZE=4]etcnet_ip_forward[/SIZE]

[SIZE=3]Настройка[/SIZE]

[SIZE=3]Изменение параметра в /etc/net/sysctl.conf[/SIZE]

[CODE]
net.ipv4.ip_forward=1                                                                    
 
[/CODE]

[QUOTE]
Разрешает маршрутизацию пакетов между интерфейсами
[/QUOTE]

[SIZE=3]Применение изменений из файла[/SIZE]

[CODE]
sysctl -p                                                                                
                                                                                              
 
[/CODE]

[SIZE=3]Временное включение до перезагрузки[/SIZE]

[CODE]
echo 1 > /proc/sys/net/ipv4/ip_forward                                                   
                                                                                              
 
[/CODE]

[SIZE=3]Включение через sysctl напрямую[/SIZE]

[CODE]
sysctl -w net.ipv4.ip_forward=1                                                          
 
[/CODE]

[QUOTE]
Изменения через echo и sysctl -w не сохраняются после перезагрузки
[/QUOTE]

[SIZE=3]Проверка текущего значения[/SIZE]

[CODE]
cat /proc/sys/net/ipv4/ip_forward                                                        
  sysctl net.ipv4.ip_forward                                                                  
 
[/CODE]

[QUOTE]
Должно вернуть 1 если включено, 0 если выключено
[/QUOTE]

[SIZE=4]etcnet_vlan[/SIZE]

[SIZE=3]Настройка VLAN-интерфейсов[/SIZE]

[SIZE=3]Создание VLAN-интерфейса[/SIZE]

[SIZE=3]Создание каталога VLAN-интерфейса[/SIZE]

[CODE]
mkdir -p /etc/net/ifaces/ens32.100                                                       
 
[/CODE]

[QUOTE]
Формат: физический_интерфейс.номер_VLAN
[/QUOTE]

[SIZE=3]Настройка параметров в /etc/net/ifaces/ens32.100/options[/SIZE]

[CODE]
TYPE=vlan                                                                                
  CONFIG_IPV4=yes                                                                             
  BOOTPROTO=static                                                                            
  VID=100                                                                                     
  HOST=ens32                                                                                  
 
[/CODE]

[QUOTE]
TYPE=vlan(тип интерфейса VLAN); VID(идентификатор VLAN); HOST(физический интерфейс); BOOTPROTO(протокол получения IP) {static, dhcp}; HOST(для нескольких интерфейсов) 'ens32 ens33'
[/QUOTE]

[SIZE=3]Настройка IP-адреса в /etc/net/ifaces/ens32.100/ipv4address[/SIZE]

[CODE]
192.168.11.67/24
                                                                                              
 
[/CODE]

[SIZE=3]Применение изменений[/SIZE]

[CODE]
systemctl restart network                                                                
                                                                                              
 
[/CODE]

[SIZE=3]Ручное управление VLAN[/SIZE]

[SIZE=3]Запуск VLAN-интерфейса[/SIZE]

[CODE]
ifup ens32.100                                                                           
                                                                                              
 
[/CODE]

[SIZE=3]Остановка VLAN-интерфейса[/SIZE]

[CODE]
ifdown ens32.100                                                                         
                                                                                              
 
[/CODE]

[SIZE=3]Проверка VLAN[/SIZE]

[SIZE=3]Просмотр интерфейсов[/SIZE]

[CODE]
ip a
[/CODE]

[SIZE=4]FreeIPA[/SIZE]

[SIZE=3]Установка FreeIPA-сервера[/SIZE]

[SIZE=3]Установка генератора энтропии[/SIZE]

[CODE]
apt-get update && apt-get install -y haveged                                             
                                                                                              
 
[/CODE]

[SIZE=3]Включение и запуск haveged[/SIZE]

[CODE]
systemctl enable --now haveged                                                           
                                                                                              
 
[/CODE]

[SIZE=3]Установка пакета FreeIPA[/SIZE]

[CODE]
apt-get install -y freeipa-server                                                        
                                                                                              
 
[/CODE]

[SIZE=3]Запуск интерактивной установки[/SIZE]

[CODE]
ipa-server-install --setup-dns                                                           
 
[/CODE]

[QUOTE]
--setup-dns опционально, если нужна интеграция с DNS
[/QUOTE]

[SIZE=4]Параметры установки[/SIZE]
[LIST][*]Server host name: имя узла FreeIPA-сервера[/LIST]
[LIST][*]Domain name: доменное имя[/LIST]
[LIST][*]Realm name: пространство Kerberos (обычно домен в верхнем регистре)[/LIST]
[LIST][*]Directory Manager password: пароль для LDAP-администратора (минимум 8 символов)[/LIST]
[LIST][*]IPA admin password: пароль администратора FreeIPA[/LIST]
[LIST][*]NetBIOS name: имя NetBIOS[/LIST]
[LIST][*]DNS forwarders: внешние DNS-серверы (например 8.8.8.8)[/LIST]
[LIST][*]Reverse DNS zone: обратная DNS-зона[/LIST]

[QUOTE]
Имена узла, домена и realm нельзя изменить после установки
[/QUOTE]

[SIZE=3]Создание пользователей и групп[/SIZE]

[SIZE=3]Получение билета Kerberos[/SIZE]

[CODE]
kinit admin                                                                              
 
[/CODE]

[QUOTE]
Ввести пароль администратора FreeIPA
[/QUOTE]

[SIZE=3]Создание 30 пользователей с паролем[/SIZE]

[CODE]
for i in {1..30}; do                                                                     
      echo "P@ssw0rd" | ipa user-add user$i --first=User --last=$i --password;                
      ipa user-mod user$i --setattr=krbPasswordExpiration=20251225011529Z;                    
  done                                                                                        
 
[/CODE]

[QUOTE]
Устанавливает срок действия пароля до 2025 года, чтобы не требовалась смена при первом входе
[/QUOTE]

[SIZE=3]Создание групп[/SIZE]

[CODE]
for i in {1..3}; do
      ipa group-add group$i;                                                                  
  done                                                                                        
                                                                                              
 
[/CODE]

[SIZE=3]Добавление пользователей в группы[/SIZE]

[CODE]
for i in {1..10}; do                                                                     
      ipa group-add-member group1 --users=user$i;                                             
  done                                                                                        
                                                                                              
  for i in {11..20}; do                                                                       
      ipa group-add-member group2 --users=user$i;
  done                                                                                        
                  
  for i in {21..30}; do                                                                       
      ipa group-add-member group3 --users=user$i;
  done                                                                                        
                                                                                              
 
[/CODE]

[SIZE=3]Подключение клиента к FreeIPA[/SIZE]

[SIZE=3]Установка пакетов на клиенте[/SIZE]

[CODE]
apt-get update && apt-get install -y freeipa-client zip                                  
                                                                                              
 
[/CODE]

[SIZE=3]Запуск настройки клиента[/SIZE]

[CODE]
ipa-client-install --server=srv-hq.your.domain --domain=your.domain --mkhomedir          
 
[/CODE]

[QUOTE]
--mkhomedir автоматически создаёт домашние каталоги для доменных пользователей
[/QUOTE]

[QUOTE]
Скрипт автоматически найдёт настройки FreeIPA-сервера и запросит имя пользователя с правом ввода машин в домен
[/QUOTE]

[SIZE=3]Перезагрузка клиента[/SIZE]

[CODE]
reboot       
                                                                                              
 
[/CODE]

[SIZE=3]Установка CA-сертификата на клиенте[/SIZE]

[SIZE=3]Копирование сертификата с сервера[/SIZE]

[CODE]
scp /etc/ipa/ca.crt root@CLI-HQ:/etc/pki/ca-trust/source/anchors/                        
 
[/CODE]

[QUOTE]
Выполняется на FreeIPA-сервере
[/QUOTE]

[SIZE=3]Обновление доверенных сертификатов на клиенте[/SIZE]

[CODE]
update-ca-trust                                                                          
                                                                                              
 
[/CODE]

[SIZE=3]Проверка FreeIPA[/SIZE]

[SIZE=3]Проверка пользователя[/SIZE]

[CODE]
ipa user-find admin                                                                      
                                                                                              
 
[/CODE]

[SIZE=3]Проверка HTTPS-соединения[/SIZE]

[CODE]
curl https://srv-hq.your.domain                                                          
                                                                                              
 
[/CODE]

[SIZE=3]Проверка запущенных служб[/SIZE]

[CODE]
ipactl status
[/CODE]

[SIZE=4]frr_and_quagga_OSPF[/SIZE]

[SIZE=3]Установка FRR[/SIZE]

[SIZE=3]Установка пакета[/SIZE]

[CODE]
apt-get install frr                                                                      
   
 
[/CODE]

[SIZE=3]Включение OSPF в /etc/frr/daemons[/SIZE]

[CODE]
ospfd=yes    

 
[/CODE]

[SIZE=3]Добавление в автозагрузку и запуск[/SIZE]

[CODE]
systemctl enable --now frr
 
[/CODE]

[QUOTE]
FRR (Free Range Routing) - пакет протоколов маршрутизации; необходимо включить только нужные протоколы маршрутизации
[/QUOTE]

[SIZE=3]Установка Quagga (старая версия для ALT Linux)[/SIZE]

[SIZE=3]Установка пакета[/SIZE]

[CODE]
apt-get install quagga                                                                   
                                                                                              
 
[/CODE]

[SIZE=3]Назначение прав[/SIZE]

[CODE]
chown -R quagga:quagga /etc/quagga                                                       
                                                                                              
 
[/CODE]

[SIZE=3]Включение и запуск служб[/SIZE]

[CODE]
systemctl enable zebra ospfd                                                             
  systemctl start zebra ospfd                                                                 
 
[/CODE]

[QUOTE]
Важно включать и запускать службы отдельно
[/QUOTE]

[SIZE=3]Настройка OSPF[/SIZE]

[QUOTE]
Перед настройкой OSPF маршрутизаторы должны иметь IP-связность через GRE-туннели, VLAN, выделенные каналы или VPN
[/QUOTE]

[SIZE=3]Полная конфигурация OSPF в vtysh[/SIZE]

[CODE]
vtysh
  conf t       
  ip forwarding                                                                               
  router ospf     
      ospf router-id 1.1.1.1                                                                  
      network 10.10.10.0/30 area 0                                                            
      network 192.168.11.0/26 area 0                                                          
      network 192.168.11.65/28 area 0                                                         
      network 192.168.11.81/29 area 0                                                         
      passive-interface default                                                               
      area 0 authentication message-digest                                                    
  int tun                                                                                     
      no ip ospf passive                                                                      
      ip ospf message-digest-key 1 md5 P@ssw0rd                                               
      ip ospf network point-to-point                                                          
  int ens35                                                                                   
      no ip ospf passive                                                                      
  do wr mem                                                                                   
 
[/CODE]

[QUOTE]
router ospf(включение процесса OSPF); ospf router-id(уникальный идентификатор маршрутизатора); network(сети участвующие в OSPF); area 0(backbone area, центральная область OSPF); passive-interface default(все интерфейсы пассивны по умолчанию); no ip ospf passive(отключить пассивный режим); area 0 authentication message-digest(MD5-аутентификация для area); ip ospf message-digest-key(номер ключа, тип хеширования, пароль); ip ospf network(тип сети OSPF); do wr mem(сохранение конфигурации); пароли на обеих сторонах должны совпадать
[/QUOTE]

[SIZE=3]Типы сетей OSPF[/SIZE]

[QUOTE]
point-to-point(для 2 узлов, экономит трафик, multicast 224.0.0.5)
[/QUOTE]

[QUOTE]
broadcast(для >2 узлов, поддерживает DR/BDR, multicast 224.0.0.5 и 224.0.0.6)
[/QUOTE]

[SIZE=3]Проверка OSPF[/SIZE]

[SIZE=3]Проверка соседей[/SIZE]

[CODE]
show ip ospf neighbor                                                                    
 
[/CODE]

[QUOTE]
Показывает соседние маршрутизаторы, состояние соседства, Router ID
[/QUOTE]

[SIZE=3]Проверка маршрутов[/SIZE]

[CODE]
ip route show                                                                            
 
[/CODE]

[QUOTE]
Маршруты OSPF помечаются буквой O
[/QUOTE]

[SIZE=3]Просмотр интерфейсов OSPF[/SIZE]

[CODE]
show ip ospf interface                                                                   
                                                                                              
 
[/CODE]

[SIZE=3]Просмотр конфигурации[/SIZE]

[CODE]
show running-config
[/CODE]

[SIZE=4]GOST_OpenSSL[/SIZE]

[SIZE=3]Настройка HTTPS с ГОСТ-сертификатами[/SIZE]

[QUOTE]
Создание собственного удостоверяющего центра (УЦ), выпуск ГОСТ-сертификатов для веб-ресурсов, настройка доверия
[/QUOTE]

[SIZE=3]Установка поддержки ГОСТ[/SIZE]

[SIZE=3]Установка пакета[/SIZE]

[CODE]
apt-get install -y openssl-gost-engine                                                   
                                                                                              
 
[/CODE]

[SIZE=3]Включение поддержки ГОСТ[/SIZE]

[CODE]
control openssl-gost enabled                                                             
                                                                                              
 
[/CODE]

[SIZE=3]Подключение GOST к OpenSSL в /etc/openssl/openssl.cnf[/SIZE]

[CODE]
openssl_conf = openssl_def                                                               
                                                                                              
  [openssl_def]                                                                               
  engines = engine_section                                                                    
                                                                                              
  [engine_section]                                                                            
  gost = gost_section                                                                         
                                                                                              
  [gost_section]  
  engine_id = gost                                                                            
  dynamic_path = /usr/lib64/openssl/engines-1.1/gost.so                                       
  default_algorithms = ALL                                                                    
 
[/CODE]

[QUOTE]
Необходимо для создания ключей по алгоритмам ГОСТ, выпуска сертификатов с ГОСТ-подписью, корректной работы Nginx с ГОСТ-криптографией
[/QUOTE]

[SIZE=3]Создание корневого сертификата УЦ[/SIZE]

[SIZE=3]Создание закрытого ключа УЦ[/SIZE]

[CODE]
openssl genpkey -algorithm gost2012_256 -pkeyopt paramset:A -out ca.key                  
                                                                                              
 
[/CODE]

[SIZE=3]Создание самоподписанного сертификата УЦ[/SIZE]

[CODE]
openssl req -x509 -new -key ca.key -days 365 -out ca.cer -engine gost -md_gost12_256     
 
[/CODE]

[QUOTE]
В Common Name указать IP сервера или имя корневого сервера; ca.key(закрытый ключ УЦ); ca.cer(корневой сертификат УЦ)
[/QUOTE]

[SIZE=3]Создание сертификатов для доменов[/SIZE]

[SIZE=3]Создание закрытого ключа для домена[/SIZE]

[CODE]
openssl genpkey -algorithm gost2012_256 -pkeyopt paramset:A -out web.some.domain.key     
  openssl genpkey -algorithm gost2012_256 -pkeyopt paramset:A -out docker.some.domain.key     
                                                                                              
 
[/CODE]

[SIZE=3]Создание запроса на подпись (CSR)[/SIZE]

[CODE]
openssl req -new -key web.some.domain.key -out web.some.domain.csr -engine gost          
  -md_gost12_256                                                                              
  openssl req -new -key docker.some.domain.key -out docker.some.domain.csr -engine gost
  -md_gost12_256                                                                              
 
[/CODE]

[QUOTE]
В Common Name указать IP или домен(ы), например *.some.domain
[/QUOTE]

[SIZE=3]Подпись сертификатов УЦ[/SIZE]

[CODE]
openssl x509 -req -in web.some.domain.csr -CA ca.cer -CAkey ca.key -CAcreateserial -out  
  web.some.domain.cer -days 365 -engine gost -md_gost12_256                                   
  openssl x509 -req -in docker.some.domain.csr -CA ca.cer -CAkey ca.key -CAcreateserial -out
  docker.some.domain.cer -days 365 -engine gost -md_gost12_256                                
                  
 
[/CODE]

[SIZE=3]Проверка сертификата[/SIZE]

[CODE]
openssl x509 -in web.some.domain.cer -text -noout
                                                                                              
 
[/CODE]

[SIZE=3]Установка сертификатов в систему[/SIZE]

[SIZE=3]Копирование сертификатов в доверенные[/SIZE]

[CODE]
cp ca.cer /etc/pki/ca-trust/source/anchors/                                              
  cp web.some.domain.cer /etc/pki/ca-trust/source/anchors/                                    
  cp docker.some.domain.cer /etc/pki/ca-trust/source/anchors/                                 
                                                                                              
 
[/CODE]

[SIZE=3]Обновление доверенных сертификатов[/SIZE]

[CODE]
update-ca-trust
[/CODE]

[SIZE=4]HAProxy_balance_of_servers[/SIZE]

[SIZE=3]Установка[/SIZE]

[SIZE=3]Установка пакета[/SIZE]

[CODE]
apt-get install haproxy                                                                  
   
 
[/CODE]

[SIZE=3]Включение и запуск службы[/SIZE]

[CODE]
systemctl enable --now haproxy

 
[/CODE]

[SIZE=3]Настройка HAProxy[/SIZE]

[SIZE=3]Конфигурация в /etc/haproxy/haproxy.cfg[/SIZE]

[CODE]
global                                                                                   
      log /dev/log daemon                                                                     
      chroot /var/lib/haproxy                                                                 
      maxconn 4000                                                                            
      user _haproxy                                                                           
      group _haproxy                                                                          
      daemon                                                                                  
      stats socket /var/lib/haproxy/stats                                                     
                                                                                              
  defaults                                                                                    
      mode http                                                                               
      log global                                                                              
      timeout connect 10s                                                                     
      timeout client 1m                                                                       
      timeout server 1m                                                                       
                                                                                              
  listen stats                                                                                
      bind 0.0.0.0:8989
      mode http                                                                               
      stats enable
      stats uri /haproxy_stats                                                                
      stats realm HAProxy\ Statistics                                                         
      stats auth admin:toor                                                                   
      stats admin if TRUE                                                                     
                                                                                              
  frontend postgre                                                                            
      bind 0.0.0.0:5432                                                                       
      default_backend POSTGRE                                                                 
                                                                                              
  backend POSTGRE                                                                             
      balance roundrobin                                                                      
      server srv-hq 192.168.11.65:5432 check                                                  
      server srv-br 192.168.33.67:5432 check                                                  
 
[/CODE]

[QUOTE]
global(глобальные параметры); log(логирование); chroot(изоляция процесса); maxconn(максимум соединений); user/group(пользователь процесса); stats socket(сокет для статистики); defaults(параметры по умолчанию); mode(режим работы) {http, tcp}; timeout(таймауты подключения); listen stats(веб-интерфейс статистики); stats auth(логин:пароль для доступа); frontend(входящие подключения); backend(серверы назначения); balance(метод балансировки); server(адрес сервера); check(проверка доступности)
[/QUOTE]

[SIZE=3]Методы балансировки[/SIZE]

[QUOTE]
roundrobin(циклическое распределение запросов, все серверы равны)
[/QUOTE]

[QUOTE]
leastconn(запросы на сервер с наименьшим количеством соединений, для долгих соединений)
[/QUOTE]

[QUOTE]
source(один IP клиента всегда на один сервер)
[/QUOTE]

[QUOTE]
uri(одинаковые URI на один сервер, для статики и API)
[/QUOTE]

[QUOTE]
url_param(балансировка по параметру URL, например ?session_id=123)
[/QUOTE]

[QUOTE]
hdr(одинаковые HTTP-заголовки на один сервер, например User-Agent или Cookie)
[/QUOTE]

[QUOTE]
rdp-cookie(балансировка по RDP Cookie для RDP-серверов)
[/QUOTE]

[QUOTE]
random(случайный сервер, приоритет настраивается через random[start_weight])
[/QUOTE]

[QUOTE]
first(всегда первый доступный сервер, для failover)
[/QUOTE]

[SIZE=3]Проверка HAProxy[/SIZE]

[SIZE=3]Проверка статуса службы[/SIZE]

[CODE]
systemctl status haproxy                                                                 
                                                                                              
 
[/CODE]

[SIZE=3]Доступ к веб-статистике[/SIZE]

[CODE]
http://IP_СЕРВЕРА:8989/haproxy_stats                                                     
 
[/CODE]

[QUOTE]
Логин и пароль из параметра stats auth
[/QUOTE]

[SIZE=4]hostname[/SIZE]

[SIZE=3]Настройка hostname[/SIZE]

[SIZE=3]Просмотр текущего hostname[/SIZE]

[CODE]
hostname                                                                                 
  hostnamectl
                                                                                              
 
[/CODE]

[SIZE=3]Временное изменение hostname до перезагрузки[/SIZE]

[CODE]
hostname new-hostname
 
[/CODE]

[QUOTE]
Изменения не сохраняются после перезагрузки
[/QUOTE]

[SIZE=3]Постоянное изменение hostname[/SIZE]

[CODE]
hostnamectl set-hostname new-hostname
 
[/CODE]

[QUOTE]
Изменения сохраняются после перезагрузки
[/QUOTE]

[SIZE=3]Изменение hostname с обновлением текущей сессии[/SIZE]

[CODE]
hostnamectl set-hostname new-hostname; exec bash
 
[/CODE]

[QUOTE]
exec bash перезапускает оболочку без login shell
[/QUOTE]

[SIZE=3]Изменение hostname с обновлением login shell[/SIZE]

[CODE]
hostnamectl set-hostname new-hostname; exec bash -l                                      
 
[/CODE]

[QUOTE]
exec bash -l перезапускает оболочку как login shell, загружает профили пользователя
[/QUOTE]

[SIZE=3]Изменение hostname в /etc/hostname[/SIZE]

[CODE]
echo "new-hostname" > /etc/hostname                                                      
 
[/CODE]

[QUOTE]
Альтернативный способ, требует перезагрузки или применения изменений
[/QUOTE]

[SIZE=3]Изменение hostname в /etc/hosts[/SIZE]

[CODE]
nano /etc/hosts                                                                          
 
[/CODE]

[QUOTE]
Добавить или изменить строку
[/QUOTE]

[CODE]
127.0.0.1   localhost                                                                    
  127.0.1.1   new-hostname                                                                    
  192.168.1.10   new-hostname.some.domain new-hostname                                        
 
[/CODE]

[QUOTE]
Рекомендуется синхронизировать с /etc/hostname для корректной работы DNS
[/QUOTE]

[SIZE=3]Применение изменений без перезагрузки[/SIZE]

[CODE]
systemctl restart systemd-hostnamed                                                      
                                                                                              
 
[/CODE]

[SIZE=3]Проверка hostname[/SIZE]

[SIZE=3]Проверка полного имени хоста[/SIZE]

[CODE]
hostname -f                                                                              
 
[/CODE]

[QUOTE]
Показывает FQDN (Fully Qualified Domain Name)
[/QUOTE]

[SIZE=3]Проверка короткого имени[/SIZE]

[CODE]
hostname -s                                                                              
 
[/CODE]

[QUOTE]
Показывает короткое имя без домена
[/QUOTE]

[SIZE=3]Проверка всех параметров[/SIZE]

[CODE]
hostnamectl status                                                                       
 
[/CODE]

[QUOTE]
Показывает Static hostname, Icon name, Chassis, Machine ID, Boot ID, Operating System, Kernel, Architecture
[/QUOTE]

[SIZE=4]install_MariaDB_Zabbix[/SIZE]

[SIZE=3]Установка[/SIZE]

[SIZE=3]Установка пакетов[/SIZE]

[CODE]
apt-get install mariadb-server zabbix-server-mysql fping                                 
   
 
[/CODE]

[SIZE=3]Включение и запуск службы[/SIZE]

[CODE]
systemctl enable --now mysqld

 
[/CODE]

[SIZE=3]Настройка БД[/SIZE]

[SIZE=3]Создание базы данных и пользователя[/SIZE]

[CODE]
mysql -uroot -p
  CREATE DATABASE zabbix CHARACTER SET utf8 COLLATE utf8_bin;
  GRANT ALL PRIVILEGES ON zabbix.* TO zabbix@localhost IDENTIFIED BY 'P@ssw0rd';              
  QUIT;                                                                                       
 
[/CODE]

[QUOTE]
Пароль можно пропустить при первом входе
[/QUOTE]

[SIZE=3]Импорт данных в БД[/SIZE]

[CODE]
mysql -uzabbix -pP@ssw0rd zabbix <                                                       
  /usr/share/doc/zabbix-common-database-mysql-*/schema.sql                                    
  mysql -uzabbix -pP@ssw0rd zabbix < /usr/share/doc/zabbix-common-database-mysql-*/images.sql
  mysql -uzabbix -pP@ssw0rd zabbix < /usr/share/doc/zabbix-common-database-mysql-*/data.sql   
 
[/CODE]

[QUOTE]
Важно соблюдать порядок ввода команд
[/QUOTE]

[SIZE=3]Установка веб-сервера[/SIZE]

[SIZE=3]Установка Apache и PHP[/SIZE]

[CODE]
apt-get install apache2 apache2-mod_php8.2                                               
  systemctl enable --now httpd2                                                               
  apt-get install php8.2 php8.2-mbstring php8.2-sockets php8.2-gd php8.2-xmlreader            
  php8.2-mysqlnd-mysqli php8.2-ldap php8.2-openssl                                            
                                                                                              
 
[/CODE]

[SIZE=3]Настройка PHP в /etc/php/8.2/apache2-mod_php/php.ini[/SIZE]

[CODE]
memory_limit = 256M
  post_max_size = 32M                                                                         
  max_execution_time = 600                                                                    
  max_input_time = 600                                                                        
  date.timezone = Europe/Moscow                                                               
  always_populate_raw_post_data = -1                                                          
 
[/CODE]

[QUOTE]
date.timezone указать свой регион
[/QUOTE]

[SIZE=3]Перезапуск веб-сервера[/SIZE]

[CODE]
systemctl restart httpd2                                                                 
                                                                                              
 
[/CODE]

[SIZE=3]Настройка сервера[/SIZE]

[SIZE=3]В /etc/zabbix/zabbix_server.conf[/SIZE]

[CODE]
DBHost=localhost                                                                         
  DBName=zabbix                                                                               
  DBUser=zabbix                                                                               
  DBPassword=P@ssw0rd                                                                         
                                                                                              
 
[/CODE]

[SIZE=3]Включение и запуск службы[/SIZE]

[CODE]
systemctl enable --now zabbix_mysql                                                      
                                                                                              
 
[/CODE]

[SIZE=3]Установка веб-интерфейса[/SIZE]

[SIZE=3]Установка пакетов[/SIZE]

[CODE]
apt-get install zabbix-phpfrontend-apache2 zabbix-phpfrontend-php8.2                     
                                                                                              
 
[/CODE]

[SIZE=3]Создание символической ссылки[/SIZE]

[CODE]
ln -s /etc/httpd2/conf/addon.d/A.zabbix.conf /etc/httpd2/conf/extra-enabled/             
                                                                                              
 
[/CODE]

[SIZE=3]Перезапуск веб-сервера[/SIZE]

[CODE]
systemctl restart httpd2                                                                 
                                                                                              
 
[/CODE]

[SIZE=3]Назначение прав[/SIZE]

[CODE]
chown apache2:apache2 /var/www/webapps/zabbix/ui/conf                                    
                                                                                              
 
[/CODE]

[SIZE=3]Доступ к веб-интерфейсу[/SIZE]

[SIZE=3]Открыть в браузере[/SIZE]

[CODE]
http://IP_СЕРВЕРА/zabbix                                                                 
 
[/CODE]

[QUOTE]
Подключиться к БД, ввести пароль от БД
[/QUOTE]

[SIZE=3]Вход по умолчанию[/SIZE]

[QUOTE]
Логин: Admin; Пароль: zabbix
[/QUOTE]

[SIZE=4]install_PostgreSQL_Zabbix[/SIZE]

