Virtual1(имя дисплея, может быть Virtual-1, HDMI-1); --mode(разрешение экрана)
[/QUOTE]

[SIZE=3]Просмотр доступных разрешений[/SIZE]

[CODE]
xrandr
[/CODE]

[SIZE=4]OpenSSL_certificate_center[/SIZE]

[SIZE=3]Установка[/SIZE]

[SIZE=3]Установка OpenSSL[/SIZE]

[CODE]
apt-get install openssl
 
[/CODE]

[QUOTE]
Обычно уже установлен в системе
[/QUOTE]

[SIZE=3]Настройка сервера CA[/SIZE]

[SIZE=3]Создание корневой директории CA[/SIZE]

[CODE]
mkdir /ca    
                                                                                              
 
[/CODE]

[SIZE=3]Поиск конфигурационного файла OpenSSL[/SIZE]

[CODE]
openssl ca                                                                               
 
[/CODE]

[QUOTE]
Команда выдаст ошибку с путём к конфигурационному файлу (/var/lib/ssl/openssl.cnf, /etc/ssl/openssl.cnf)
[/QUOTE]

[SIZE=3]Резервная копия конфигурационного файла[/SIZE]

[CODE]
cp /var/lib/ssl/openssl.cnf /var/lib/ssl/openssl.cnf.backup
                                                                                              
 
[/CODE]

[SIZE=3]В /var/lib/ssl/openssl.cnf в секции [ CA_default ][/SIZE]

[CODE]
dir = /ca                                                                                
 
[/CODE]

[QUOTE]
Изменение корневой директории CA с ./demoCA на /ca
[/QUOTE]

[SIZE=3]Создание структуры директорий CA[/SIZE]

[CODE]
cd /ca                                                                                   
  mkdir certs newcerts crl private                                                            
  touch index.txt                                                                             
  echo -n '00' > serial                                                                       
 
[/CODE]

[QUOTE]
certs(выпущенные сертификаты); newcerts(новые сертификаты); crl(списки отзыва); private(приватные ключи); index.txt(база данных сертификатов); serial(серийный номер); -n(без пробела и перевода строки)
[/QUOTE]

[SIZE=3]В /var/lib/ssl/openssl.cnf в секции [ CA_default ][/SIZE]

[CODE]
policy = policy_anything
 
[/CODE]

[QUOTE]
Принимаем любые значения, требуем только CN (Common Name)
[/QUOTE]

[SIZE=3]В /var/lib/ssl/openssl.cnf в секции [ policy_anything ][/SIZE]

[CODE]
commonName = supplied                                                                    
 
[/CODE]

[QUOTE]
CN обязателен для заполнения
[/QUOTE]

[SIZE=3]В /var/lib/ssl/openssl.cnf в секции [ req_distinguished_name ][/SIZE]

[CODE]
countryName_default = RU                                                                 
  0.organizationName_default = domain.sample                                                  
 
[/CODE]

[QUOTE]
Значения по умолчанию для CA: C=RU, O=domain.sample, CN указывается при генерации
[/QUOTE]

[SIZE=3]В /var/lib/ssl/openssl.cnf в секции [ v3_ca ][/SIZE]

[CODE]
basicConstraints = CA:true                                                               
 
[/CODE]

[QUOTE]
Сертификат может быть корневым CA
[/QUOTE]

[SIZE=3]Генерация ключей и запроса на сертификат CA[/SIZE]

[CODE]
openssl req -nodes -new -out cacert.csr -keyout private/cakey.pem -extensions v3_ca      
 
[/CODE]

[QUOTE]
-nodes(без пароля на ключ); -new(новый запрос); -out(файл запроса); -keyout(приватный ключ); -extensions v3_ca(расширения CA). При заполнении: C=RU и O=domain.sample подставятся автоматически, CN указать вручную (например domain.sample RootCA), пустые поля заполнить точкой
[/QUOTE]

[SIZE=3]Самоподписание сертификата CA[/SIZE]

[CODE]
openssl ca -selfsign -in cacert.csr -out cacert.pem -extensions v3_ca
 
[/CODE]

[QUOTE]
-selfsign(самоподписание); подтвердить y на вопросы
[/QUOTE]

[SIZE=3]Просмотр содержимого сертификата[/SIZE]

[CODE]
openssl x509 -text -noout -in cacert.pem | less                                          
 
[/CODE]

[QUOTE]
Необязательно, для проверки содержимого сертификата
[/QUOTE]

[SIZE=3]Настройка клиента[/SIZE]

[SIZE=3]Подготовка сертификата для клиента[/SIZE]

[CODE]
mv cacert.pem cacert.crt
 
[/CODE]

[QUOTE]
Сертификаты должны иметь расширение .crt
[/QUOTE]

[SIZE=3]Копирование сертификата на клиент Debian/Ubuntu[/SIZE]

[CODE]
cp cacert.crt /usr/local/share/ca-certificates/                                          
  update-ca-certificates                                                                      
 
[/CODE]

[QUOTE]
Для дистрибутивов на базе deb
[/QUOTE]

[SIZE=3]Копирование сертификата на клиент ALT/RHEL/CentOS[/SIZE]

[CODE]
cp cacert.crt /etc/pki/ca-trust/source/anchors/                                          
  update-ca-trust                                                                      
 
[/CODE]

[QUOTE]
Для дистрибутивов на базе rpm
[/QUOTE]

[SIZE=3]Проверка[/SIZE]

[SIZE=3]Проверка доверия к сертификату[/SIZE]

[CODE]
openssl verify cacert.crt
 
[/CODE]

[QUOTE]
Должен вывести: cacert.crt: OK
[/QUOTE]

[SIZE=4]OTRS[/SIZE]

[SIZE=3]Установка[/SIZE]

[SIZE=3]Установка пакетов[/SIZE]

[CODE]
apt-get update && apt-get install -y postgresql15-server otrs otrs-apache2               
                                                                                              
 
[/CODE]

[SIZE=3]Запуск Apache[/SIZE]

[CODE]
systemctl enable --now httpd2                                                            
                                                                                              
 
[/CODE]

[SIZE=3]Создание системных баз данных PostgreSQL[/SIZE]

[CODE]
/etc/init.d/postgresql initdb                                                            
                                                                                              
 
[/CODE]

[SIZE=3]Запуск PostgreSQL[/SIZE]

[CODE]
systemctl enable --now postgresql                                                        
                                                                                              
 
[/CODE]

[SIZE=3]Создание пользователя и базы данных для OTRS[/SIZE]

[CODE]
psql -U postgres                                                                         
  create database otrs;                                                                       
  create user otrs with encrypted password 'P@ssw0rd';                                        
  grant all privileges on database otrs to otrs;                                              
  alter database otrs owner to otrs;                                                          
 
[/CODE]

[QUOTE]
P@ssw0rd(пароль для пользователя otrs)
[/QUOTE]

[SIZE=3]Настройка[/SIZE]

[SIZE=3]Настройка otrs-apache2[/SIZE]

[CODE]
apt-get install -y apache2-httpd-prefork                                                 
  a2enextra httpd-addon.d                                                                     
  echo "httpd-addon.d=yes" >> /etc/httpd2/conf/extra-start.d/999-otrs.conf                    
                                                                                              
 
[/CODE]

[SIZE=3]Перезагрузка Apache[/SIZE]

[CODE]
systemctl restart httpd2                                                                 
                                                                                              
 
[/CODE]

[SIZE=3]Веб-установщик[/SIZE]

[QUOTE]
Открыть в браузере http://IP_адрес_сервера/otrs/installer.pl
[/QUOTE]

[SIZE=4]Действия в веб-установщике[/SIZE]
[LIST][*]Принять лицензию[/LIST]
[LIST][*]Настроить базу данных[/LIST]
[LIST][LIST][*]type database: PostgreSQL[/LIST][/LIST]
[LIST][LIST][*]host: localhost[/LIST][/LIST]
[LIST][LIST][*]database: otrs[/LIST][/LIST]
[LIST][LIST][*]user: otrs[/LIST][/LIST]
[LIST][LIST][*]password: P@ssw0rd[/LIST][/LIST]
[LIST][*]Запомнить пароль администратора[/LIST]
[LIST][*]Перейти по ссылке для входа в админскую учётную запись[/LIST]

[SIZE=3]Установка модулей PostgreSQL[/SIZE]

[CODE]
apt-get install -y postgresql15-perl perl-DBD-Pg                                         
                                                                                              
 
[/CODE]

[SIZE=3]Запуск OTRS[/SIZE]

[CODE]
rm /var/www/webapps/otrs/var/cron/otrs_daemin dist                                       
  /var/www/webapps/otrs/bin/Cron.sh start otrs                                                
 
[/CODE]

[QUOTE]
Устранение ошибок
[/QUOTE]

[SIZE=3]Проверка[/SIZE]

[QUOTE]
Доступ администратора: http://IP_адрес_сервера/otrs/index.pl
[/QUOTE]

[QUOTE]
Доступ пользователей: http://IP_адрес_сервера/otrs/customer.pl
[/QUOTE]

[SIZE=4]OwnCloud[/SIZE]

[SIZE=3]Установка[/SIZE]

[SIZE=3]Установка MariaDB[/SIZE]

[CODE]
apt-get update && apt-get install -y mariadb-server                                      
                                                                                              
 
[/CODE]

[SIZE=3]Запуск MariaDB[/SIZE]

[CODE]
systemctl enable --now mariadb                                                           
                                                                                              
 
[/CODE]

[SIZE=3]Создание базы данных и пользователя[/SIZE]

[CODE]
mysql -uroot                                                                             
  CREATE DATABASE owncloud DEFAULT CHARACTER SET utf8 DEFAULT COLLATE utf8_general_ci;        
  GRANT ALL PRIVILEGES ON owncloud.* TO owncloud@'%' IDENTIFIED BY 'owncloud';                
  EXIT;                                                                                       
 
[/CODE]

[QUOTE]
owncloud(имя базы данных, пользователя и пароль)
[/QUOTE]

[SIZE=3]Установка пакетов PHP[/SIZE]

[CODE]
apt-get install php7                                                                     
  php7-{fpm-fcgi,pdo,zip,dom,intl,gd,mysqli,pdo_mysql,mbstring,json,xmlreader,curl,fileinfo}  
                  
 
[/CODE]

[SIZE=3]Запуск php-fpm[/SIZE]

[CODE]
systemctl enable --now php7-fpm.service
                                                                                              
 
[/CODE]

[SIZE=3]Установка веб-сервера[/SIZE]

[CODE]
apt-get install -y nginx                                                                 
                                                                                              
 
[/CODE]

[SIZE=3]Установка утилит для загрузки архива[/SIZE]

[CODE]
apt-get install -y wget bzip2                                                            
                                                                                              
 
[/CODE]

[SIZE=3]Загрузка OwnCloud[/SIZE]

[CODE]
cd /tmp                                                                                  
  wget https://download.owncloud.com/server/stable/owncloud-complete-latest.tar.bz2           
 
[/CODE]

[QUOTE]
Ссылку на последнюю версию копировать со страницы https://owncloud.com/download-server/#edition
[/QUOTE]

[SIZE=3]Создание директории для файлов OwnCloud[/SIZE]

[CODE]
mkdir -p /var/www/webapps/owncloud                                                       
                                                                                              
 
[/CODE]

[SIZE=3]Распаковка архива[/SIZE]

[CODE]
tar -xvjf owncloud-*.tar.bz2 -C /var/www/webapps/owncloud                                
  mv /var/www/webapps/owncloud/owncloud/* /var/www/webapps/owncloud/                          
  rm -rf /var/www/webapps/owncloud/owncloud/*                                                 
                                                                                              
 
[/CODE]

[SIZE=3]Настройка[/SIZE]

[SIZE=3]Содержимое файла /etc/nginx/sites-available.d/owncloud.conf[/SIZE]

[CODE]
upstream php-handler {                                                                   
      server unix:/var/run/php7-fpm/php7-fpm.sock;                                            
  }                                                                                           
                                                                                              
  server {                                                                                    
      listen 80;  
      server_name cloud.example.com;                                                          
      return 301 https://$server_name$request_uri;                                            
  }                                                                                           
                                                                                              
  server {                                                                                    
      listen 443 ssl;
      server_name cloud.example.com;                                                          
                                                                                              
      ssl_certificate /var/lib/ssl/certs/owncloud.pem;                                        
      ssl_certificate_key /var/lib/ssl/private/owncloud.key;                                  
                                                                                              
      add_header Strict-Transport-Security "max-age=15552000; includeSubDomains";             
      add_header X-Content-Type-Options nosniff;                                              
      add_header X-Frame-Options "SAMEORIGIN";                                                
      add_header X-XSS-Protection "1; mode=block";                                            
      add_header X-Robots-Tag none;                                                           
      add_header X-Download-Options noopen;                                                   
      add_header X-Permitted-Cross-Domain-Policies none;                                      
                                                                                              
      root /var/www/webapps/owncloud;                                                         
                                                                                              
      location = /robots.txt {                                                                
          allow all;
          log_not_found off;                                                                  
          access_log off;                                                                     
      }                                                                                       
                                                                                              
      location = /.well-known/carddav {                                                       
          return 301 $scheme://$host/remote.php/dav;
      }                                                                                       
      location = /.well-known/caldav {
          return 301 $scheme://$host/remote.php/dav;                                          
      }                                                                                       
                                                                                              
      location /.well-known/acme-challenge { }                                                
                                                                                              
      client_max_body_size 512M;                                                              
      fastcgi_buffers 64 4K;
                                                                                              
      gzip off;                                                                               
                                                                                              
      error_page 403 /core/templates/403.php;                                                 
      error_page 404 /core/templates/404.php;
                                                                                              
      location / {                                                                            
          rewrite ^ /index.php$uri;                                                           
      }                                                                                       
                                                                                              
      location ~ ^/(?:build|tests|config|lib|3rdparty|templates|data)/ {                      
          return 404;                                                                         
      }                                                                                       
      location ~ ^/(?:\.|autotest|occ|issue|indie|db_|console) {
          return 404;                                                                         
      }                                                                                       
                                                                                              
      location ~ ^/(?:index|remote|public|cron|core/ajax/update|status|ocs/v[12]|updater/.+|oc
  s-provider/.+|core/templates/40[34])\.php(?:$|/) {
          fastcgi_split_path_info ^(.+\.php)(/.*)$;                                           
          include fastcgi_params;                                                             
          fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;                   
          fastcgi_param PATH_INFO $fastcgi_path_info;                                         
          fastcgi_param HTTPS on;                                                             
          fastcgi_param modHeadersAvailable true;                                             
          fastcgi_param front_controller_active true;                                         
          fastcgi_pass php-handler;                                                           
          fastcgi_intercept_errors on;                                                        
          fastcgi_request_buffering off;                                                      
      }                                                                                       
                                                                                              
      location ~ ^/(?:updater|ocs-provider)(?:$|/) {                                          
          try_files $uri $uri/ =404;
          index index.php;                                                                    
      }                                                                                       
                                                                                              
      location ~* \.(?:css|js)$ {                                                             
          try_files $uri /index.php$uri$is_args$args;
          add_header Cache-Control "public, max-age=7200";                                    
                                                                                              
          add_header X-Content-Type-Options nosniff;                                          
          add_header X-Frame-Options "SAMEORIGIN";                                            
          add_header X-XSS-Protection "1; mode=block";                                        
          add_header X-Robots-Tag none;                                                       
          add_header X-Download-Options noopen;                                               
          add_header X-Permitted-Cross-Domain-Policies none;                                  
                                                                                              
          access_log off;                                                                     
      }                                                                                       
                                                                                              
      location ~* \.(?:svg|gif|png|html|ttf|woff|ico|jpg|jpeg)$ {                             
          try_files $uri /index.php$uri$is_args$args;                                         
                                                                                              
          access_log off;                                                                     
      }                                                                                       
  }                                                                                           
                                                                                              
 
[/CODE]

[SIZE=3]Создание символической ссылки[/SIZE]

[CODE]
ln -s /etc/nginx/sites-available.d/owncloud.conf /etc/nginx/sites-enabled.d/             
                                                                                              
 
[/CODE]

[SIZE=3]Генерация самоподписанного сертификата[/SIZE]

[CODE]
cd /var/lib/ssl                                                                          
  openssl req -new -x509 -days 1461 -nodes -out certs/owncloud.pem -keyout                    
  private/owncloud.key -subj "/C=RU/ST=SPb/L=SPb/O=Global Security/OU=IT                      
  Department/CN=cloud.example.com/CN=owncloud"                                                
 
[/CODE]

[QUOTE]
Опционально, для тестирования
[/QUOTE]

[SIZE=3]Запуск веб-сервера[/SIZE]

[CODE]
systemctl enable --now nginx                                                             
                                                                                              
 
[/CODE]

[SIZE=3]Веб-установщик[/SIZE]

[QUOTE]
Открыть в браузере https://IP_адрес_или_доменное_имя
[/QUOTE]

[QUOTE]
Игнорировать предупреждение безопасности при использовании самоподписанного сертификата
[/QUOTE]

[SIZE=4]Параметры веб-установщика[/SIZE]
[LIST][*]Admin user: admin[/LIST]
[LIST][*]Admin password: P@ssw0rd[/LIST]
[LIST][*]Data folder: /var/www/webapps/owncloud/data[/LIST]
[LIST][*]Configure the database: MySQL/MariaDB[/LIST]
[LIST][*]Database user: owncloud[/LIST]
[LIST][*]Database password: owncloud[/LIST]
[LIST][*]Database host: localhost[/LIST]
[LIST][*]Нажать Finish setup[/LIST]
[LIST][*]Войти в созданную учётную запись[/LIST]

[SIZE=3]Проверка[/SIZE]

[QUOTE]
Доступ к веб-интерфейсу: https://IP_адрес_или_доменное_имя
[/QUOTE]

[SIZE=4]partitions_of_devices[/SIZE]

[SIZE=3]Создание GPT разметки на диске /dev/sda[/SIZE]

[CODE]
parted /dev/sda                                                                          
  mklabel gpt                                                                                 
  mkpart boot 0% 100%                                                                         
 
[/CODE]

[QUOTE]
mklabel(создание таблицы разделов) {gpt, msdos}
[/QUOTE]

[QUOTE]
mkpart(создание раздела) boot(название раздела, любое)
[/QUOTE]

[QUOTE]
0% 100%(начало и конец раздела в процентах) {1MiB 100%, 0% 50GB}
[/QUOTE]

[SIZE=3]Создание раздела с указанием файловой системы[/SIZE]

[CODE]
parted /dev/sdc                                                                          
  mklabel gpt                                                                                 
  mkpart root ext4 0% 100%                                                                    
 
[/CODE]

[QUOTE]
ext4(тип файловой системы) {ext4, xfs, btrfs, swap}
[/QUOTE]

[QUOTE]
root(название раздела, может быть любым{A–Z, a–z}, {0–9}, {`-`, `_`})
[/QUOTE]

[SIZE=3]Создание нескольких разделов[/SIZE]

[CODE]
parted /dev/sdd                                                                          
  mklabel gpt                                                                                 
  mkpart system 0% 50%                                                                        
  mkpart data 50% 100%                                                                        
 
[/CODE]

[QUOTE]
Создание двух разделов по 50% диска с названиями system и data
[/QUOTE]

[SIZE=3]Создание раздела с точным размером[/SIZE]

[CODE]
parted /dev/sde                                                                          
  mklabel gpt                                                                                 
  mkpart root 1MiB 10GiB
 
[/CODE]

[QUOTE]
1MiB(начало раздела, выравнивание) 10GiB(конец раздела)
[/QUOTE]

[QUOTE]
Единицы измерения {MiB, GiB, TiB, MB, GB, TB}
[/QUOTE]

[SIZE=3]Создание swap раздела[/SIZE]

[CODE]
parted /dev/sdf                                                                          
  mklabel gpt                                                                                 
  mkpart swap linux-swap 0% 4GiB
  mkpart root ext4 4GiB 100%                                                                  
 
[/CODE]

[QUOTE]
Первый раздел для swap, второй для системы
[/QUOTE]

[SIZE=3]Создание EFI раздела для UEFI систем[/SIZE]

[CODE]
parted /dev/sdg                                                                          
  mklabel gpt                                                                                 
  mkpart EFI fat32 1MiB 512MiB                                                                
  set 1 esp on                                                                                
  mkpart root ext4 512MiB 100%                                                                
 
[/CODE]

[QUOTE]
EFI(название раздела) для загрузчика UEFI
[/QUOTE]

[QUOTE]
esp(флаг для UEFI загрузки) обязателен для EFI раздела
[/QUOTE]

[QUOTE]
Размер EFI раздела обычно 512MiB {256MiB, 512MiB, 1GiB}
[/QUOTE]

[QUOTE]
GPT обязательна для UEFI систем
[/QUOTE]

[SIZE=3]Создание разметки для BIOS Legacy загрузки[/SIZE]

[CODE]
parted /dev/sdh                                                                          
  mklabel msdos                                                                               
  mkpart primary ext4 1MiB 100%                                                               
  set 1 boot on                                                                               
 
[/CODE]

[QUOTE]
msdos(таблица разделов MBR) для BIOS Legacy систем
[/QUOTE]

[QUOTE]
boot(флаг загрузочного раздела) для Legacy BIOS
[/QUOTE]

[QUOTE]
Для BIOS Legacy лучше использовать msdos, не gpt
[/QUOTE]

[SIZE=3]Создание разметки BIOS Legacy с swap[/SIZE]

[CODE]
parted /dev/sdi                                                                          
  mklabel msdos                                                                               
  mkpart primary linux-swap 1MiB 4GiB                                                         
  mkpart primary ext4 4GiB 100%                                                               
  set 2 boot on                                                                               
 
[/CODE]

[QUOTE]
msdos для совместимости со старыми BIOS
[/QUOTE]

[QUOTE]
boot устанавливается на корневой раздел
[/QUOTE]

[SIZE=3]Создание полной разметки с boot разделом[/SIZE]

[CODE]
parted /dev/sdj                                                                          
  mklabel gpt                                                                                 
  mkpart boot ext4 1MiB 512MiB                                                                
  set 1 boot on                                                                               
  mkpart swap linux-swap 512MiB 4GiB                                                          
  set 2 swap on                                                                               
  mkpart root ext4 4GiB 100%                                                                  
 
[/CODE]

[QUOTE]
boot(название и флаг загрузочного раздела) для /boot
[/QUOTE]

[QUOTE]
swap(название и флаг раздела подкачки) для swap
[/QUOTE]

[QUOTE]
Типичная схема: boot + swap + root
[/QUOTE]

[SIZE=3]Создание разметки для UEFI с boot и swap[/SIZE]

[CODE]
parted /dev/sdk                                                                          
  mklabel gpt                                                                                 
  mkpart EFI fat32 1MiB 512MiB                                                                
  set 1 esp on                                                                                
  mkpart boot ext4 512MiB 1GiB                                                                
  set 2 boot on                                                                               
  mkpart swap linux-swap 1GiB 5GiB                                                            
  set 3 swap on                                                                               
  mkpart root ext4 5GiB 100%                                                                  
 
[/CODE]

[QUOTE]
esp(EFI раздел) + boot(/boot) + swap(подкачка) + root(корень)
[/QUOTE]

[QUOTE]
Полная схема для UEFI системы
[/QUOTE]

[SIZE=3]Создание разметки с LVM[/SIZE]

[CODE]
parted /dev/sdl                                                                          
  mklabel gpt                                                                                 
  mkpart EFI fat32 1MiB 512MiB                                                                
  set 1 esp on                                                                                
  mkpart lvm 512MiB 100%                                                                      
  set 2 lvm on                                                                                
 
[/CODE]

[QUOTE]
lvm(флаг для LVM) для физического тома LVM
[/QUOTE]

[QUOTE]
LVM позволяет гибко управлять разделами: изменять размер, создавать снапшоты, объединять диски
[/QUOTE]

[SIZE=3]Пример использования LVM после создания раздела[/SIZE]

[CODE]
pvcreate /dev/sdl2
  vgcreate vg0 /dev/sdl2                                                                      
  lvcreate -L 4G -n swap vg0                                                                  
  lvcreate -L 20G -n root vg0                                                                 
  lvcreate -l 100%FREE -n home vg0                                                            
 
[/CODE]

[QUOTE]
pvcreate(создание физического тома)
[/QUOTE]

[QUOTE]
vgcreate(создание группы томов) vg0(название группы)
[/QUOTE]

[QUOTE]
lvcreate(создание логического тома) -L(размер) -n(название) -l(процент свободного места)
[/QUOTE]

[QUOTE]
LVM позволяет изменять размер разделов без перезагрузки
[/QUOTE]

[SIZE=3]Создание разметки с RAID[/SIZE]

[CODE]
parted /dev/sdm                                                                          
  mklabel gpt                                                                                 
  mkpart raid1 1MiB 100%
  set 1 raid on                                                                               
 
[/CODE]

[QUOTE]
raid(флаг для RAID) для программного RAID массива
[/QUOTE]

[QUOTE]
RAID объединяет несколько дисков для отказоустойчивости или производительности
[/QUOTE]

[SIZE=3]Неинтерактивное создание разметки[/SIZE]

[CODE]
parted -s /dev/sdg mklabel gpt                                                           
  parted -s /dev/sdg mkpart root 0% 100%                                                      
 
[/CODE]

[QUOTE]
-s(неинтерактивный режим, без подтверждений)
[/QUOTE]

[SIZE=3]Удаление раздела[/SIZE]

[CODE]
parted /dev/sdh                                                                          
  rm 1                                                                                        
 
[/CODE]

[QUOTE]
rm(удаление раздела) 1(номер раздела)
[/QUOTE]

[SIZE=3]Изменение размера раздела[/SIZE]

[CODE]
parted /dev/sdi                                                                          
  resizepart 1 50GiB                                                                          
 
[/CODE]

[QUOTE]
resizepart(изменение размера) 1(номер раздела) 50GiB(новый размер)
[/QUOTE]

[SIZE=3]Установка и снятие флагов раздела[/SIZE]

[CODE]
parted /dev/sdj                                                                          
  set 1 boot on                                                                               
  set 1 boot off                                                                              
 
[/CODE]

[QUOTE]
set(установка флага) 1(номер раздела) boot(тип флага) on/off(включить/выключить)
[/QUOTE]

[QUOTE]
Типы флагов {boot, esp, swap, raid, lvm, bios_grub}
[/QUOTE]

[SIZE=3]Просмотр доступных флагов[/SIZE]

[CODE]
parted /dev/sda                                                                          
  help set                                                                                    
 
[/CODE]

[QUOTE]
Показывает все доступные флаги для установки
[/QUOTE]

[SIZE=3]Проверка[/SIZE]

[SIZE=3]Просмотр разделов дисков[/SIZE]

[CODE]
lsblk                                                                                    
 
[/CODE]

[QUOTE]
Показывает все блочные устройства и разделы
[/QUOTE]

[SIZE=3]Просмотр информации о разделах диска[/SIZE]

[CODE]
parted /dev/sda print                                                                    
 
[/CODE]

[QUOTE]
Показывает таблицу разделов конкретного диска с флагами
[/QUOTE]

[SIZE=3]Просмотр всех дисков[/SIZE]

[CODE]
parted -l                                                                                
 
[/CODE]

[QUOTE]
Показывает информацию о всех дисках в системе
[/QUOTE]

[SIZE=3]Проверка выравнивания разделов[/SIZE]

[CODE]
parted /dev/sda align-check optimal 1                                                    
 
[/CODE]

[QUOTE]
align-check(проверка выравнивания) optimal(тип) 1(номер раздела)
[/QUOTE]

[SIZE=3]Проверка активации swap[/SIZE]

[CODE]
swapon --show                                                                            
 
[/CODE]

[QUOTE]
Показывает активные swap разделы
[/QUOTE]

[SIZE=3]Проверка монтирования EFI раздела[/SIZE]

[CODE]
mount | grep efi                                                                         
 
[/CODE]

[QUOTE]
Показывает смонтированные EFI разделы
[/QUOTE]

[SIZE=3]Проверка LVM томов[/SIZE]

[CODE]
pvdisplay                                                                                
  vgdisplay                                                                                   
  lvdisplay                                                                                   
 
[/CODE]

[QUOTE]
Показывает физические тома, группы томов и логические тома LVM Исправления: - primary заменено на осмысленные названия разделов (boot, root, swap, data) - Для BIOS Legacy использую msdos, не gpt - Добавлено объяснение LVM: технология для гибкого управления разделами (изменение размера, снапшоты, объединение дисков) - Добавлен пример создания LVM томов после разметки
[/QUOTE]

[SIZE=4]phpMyAdmin[/SIZE]

[SIZE=3]Установка[/SIZE]

[SIZE=3]Установка MariaDB[/SIZE]

[CODE]
apt-get update -y && apt-get install -y mariadb-server                                   
                                                                                              
 
[/CODE]

[SIZE=3]Запуск MariaDB[/SIZE]

[CODE]
systemctl enable --now mariadb                                                           
                                                                                              
 
[/CODE]

[SIZE=3]Установка PHP расширений для phpMyAdmin[/SIZE]

[CODE]
apt-get install -y php8.2 php8.2-{fpm-fcgi,mbstring,zip,gd,libs,mysqlnd,mysqlnd-mysqli,bz
  2,curl,mcrypt,opcache,openssl} libmcrypt wget                                               
 
[/CODE]

[QUOTE]
Расширения для дополнительных функций и производительности phpMyAdmin
[/QUOTE]

[SIZE=3]Загрузка phpMyAdmin[/SIZE]

[CODE]
wget https://files.phpmyadmin.net/phpMyAdmin/5.2.1/phpMyAdmin-5.2.1-all-languages.zip    
 
[/CODE]

[QUOTE]
Ссылку на последнюю версию копировать со страницы https://docs.phpmyadmin.net
[/QUOTE]

[SIZE=3]Распаковка архива[/SIZE]

[CODE]
unzip phpMyAdmin-5.2.1-all-languages.zip                                                 
                                                                                              
 
[/CODE]

[SIZE=3]Перемещение в рабочую директорию[/SIZE]

[CODE]
mv phpMyAdmin-5.2.1-all-languages /usr/share/phpmyadmin                                  
                                                                                              
 
[/CODE]

[SIZE=3]Создание директории для временных файлов[/SIZE]

[CODE]
mkdir -p /var/lib/phpmyadmin/tmp                                                         
                                                                                              
 
[/CODE]

[SIZE=3]Установка веб-сервера Apache[/SIZE]

[CODE]
apt-get install -y httpd2 apache2-{httpd-prefork,mod_php8.2}                             
                                                                                              
 
[/CODE]

[SIZE=3]Назначение владельца файлов phpMyAdmin[/SIZE]

[CODE]
chown -R apache2:apache2 /usr/share/phpmyadmin                                           
  chown -R apache2:apache2 /var/lib/phpmyadmin                                                
 
[/CODE]

[QUOTE]
apache2(пользователь веб-сервера)
[/QUOTE]

[SIZE=3]Создание конфигурационного файла phpMyAdmin[/SIZE]

[CODE]
cp /usr/share/phpmyadmin/config.sample.inc.php /usr/share/phpmyadmin/config.inc.php      
                                                                                              
 
[/CODE]

[SIZE=3]Создание базы данных и таблиц phpMyAdmin[/SIZE]

[CODE]
mariadb < /usr/share/phpmyadmin/sql/create_tables.sql                                    
 
[/CODE]

[QUOTE]
Создание базы данных хранилища конфигурации
[/QUOTE]

[SIZE=3]Создание пользователя pma для phpMyAdmin[/SIZE]

[CODE]
mariadb                                                                                  
  GRANT SELECT, INSERT, UPDATE, DELETE ON phpmyadmin.* TO 'pma'@'localhost' IDENTIFIED BY     
  'P@ssw0rd';                                                                                 
  EXIT;                                                                                       
 
[/CODE]

[QUOTE]
pma(пользователь для административных задач phpMyAdmin)
[/QUOTE]

[SIZE=3]Настройка[/SIZE]

[SIZE=3]В /usr/share/phpmyadmin/config.inc.php параметр blowfish_secret[/SIZE]

[CODE]
$cfg['blowfish_secret'] = 'случайная_строка_32_символа';
 
[/CODE]

[QUOTE]
Строка из 32 случайных символов для шифрования AES
[/QUOTE]

[QUOTE]
Если короче 32 символов - менее надежные куки
[/QUOTE]

[SIZE=3]Генерация случайной строки для blowfish_secret[/SIZE]

[CODE]
openssl rand -base64 32                                                                  
 
[/CODE]

[QUOTE]
Генерирует случайную строку, результат скопировать в config.inc.php
[/QUOTE]

[QUOTE]
Альтернативные способы {openssl rand -hex 16, pwgen 32 1, head /dev/urandom | tr -dc A-Za-z0-9 | head -c 32}
[/QUOTE]

[SIZE=3]Пример сгенерированной строки в config.inc.php[/SIZE]

[CODE]
$cfg['blowfish_secret'] = 'a8b7c6d5e4f3g2h1i0j9k8l7m6n5o4p3';
 
[/CODE]

[QUOTE]
Использовать результат команды openssl rand -base64 32
[/QUOTE]

[SIZE=3]В /usr/share/phpmyadmin/config.inc.php раскомментировать controluser и controlpass[/SIZE]

[CODE]
$cfg['Servers'][$i]['controluser'] = 'pma';                                              
  $cfg['Servers'][$i]['controlpass'] = 'P@ssw0rd';                                            
 
[/CODE]

[QUOTE]
Пользователь для административных задач в многопользовательских сценариях
[/QUOTE]

[SIZE=3]В /usr/share/phpmyadmin/config.inc.php раскомментировать Storage database and tables[/SIZE]

[CODE]
$cfg['Servers'][$i]['pmadb'] = 'phpmyadmin';                                             
  $cfg['Servers'][$i]['bookmarktable'] = 'pma__bookmark';                                     
  $cfg['Servers'][$i]['relation'] = 'pma__relation';                                          
  $cfg['Servers'][$i]['table_info'] = 'pma__table_info';                                      
  $cfg['Servers'][$i]['table_coords'] = 'pma__table_coords';                                  
  $cfg['Servers'][$i]['pdf_pages'] = 'pma__pdf_pages';                                        
  $cfg['Servers'][$i]['column_info'] = 'pma__column_info';                                    
  $cfg['Servers'][$i]['history'] = 'pma__history';                                            
  $cfg['Servers'][$i]['table_uiprefs'] = 'pma__table_uiprefs';                                
  $cfg['Servers'][$i]['tracking'] = 'pma__tracking';                                          
  $cfg['Servers'][$i]['userconfig'] = 'pma__userconfig';                                      
  $cfg['Servers'][$i]['recent'] = 'pma__recent';                                              
  $cfg['Servers'][$i]['favorite'] = 'pma__favorite';                                          
  $cfg['Servers'][$i]['users'] = 'pma__users';                                                
  $cfg['Servers'][$i]['usergroups'] = 'pma__usergroups';                                      
  $cfg['Servers'][$i]['navigationhiding'] = 'pma__navigationhiding';                          
  $cfg['Servers'][$i]['savedsearches'] = 'pma__savedsearches';                                
  $cfg['Servers'][$i]['central_columns'] = 'pma__central_columns';                            
  $cfg['Servers'][$i]['designer_settings'] = 'pma__designer_settings';                        
  $cfg['Servers'][$i]['export_templates'] = 'pma__export_templates';                          
 
[/CODE]

[QUOTE]
Определение базы данных и таблиц хранилища конфигурации
[/QUOTE]

[SIZE=3]В /usr/share/phpmyadmin/config.inc.php настроить временную директорию[/SIZE]

[CODE]
$cfg['TempDir'] = '/var/lib/phpmyadmin/tmp';                                             
 
[/CODE]

[QUOTE]
Использование созданной ранее директории для временных файлов
[/QUOTE]

[SIZE=3]В /usr/share/phpmyadmin/config.inc.php разрешить указывать сервер БД[/SIZE]

[CODE]
$cfg['AllowArbitraryServer'] = true;                                                     
 
[/CODE]

[QUOTE]
Опционально, для явного указания IP-адреса или имени сервера БД
[/QUOTE]

[SIZE=3]Настройка удалённого доступа к MariaDB в /etc/my.cnf.d/server.cnf[/SIZE]

[CODE]
bind-address = 0.0.0.0                                                                   
  #skip-networking                                                                            
 
[/CODE]

[QUOTE]
bind-address(IP-адрес для подключений) {0.0.0.0, 192.168.1.0/24, конкретный_IP}
[/QUOTE]

[QUOTE]
0.0.0.0(разрешено подключаться всем и отовсюду)
[/QUOTE]

[QUOTE]
skip-networking(закомментировать для разрешения сетевых подключений)
[/QUOTE]

[QUOTE]
Опционально, не влияет на работу phpMyAdmin
[/QUOTE]

[SIZE=3]Предоставление привилегий пользователю root для удалённого доступа[/SIZE]

[CODE]
mariadb                                                                                  
  GRANT ALL PRIVILEGES ON *.* TO 'root'@'%' IDENTIFIED BY 'P@ssw0rd' WITH GRANT OPTION;       
  EXIT;                                                                                       
 
[/CODE]

[QUOTE]
Опционально, если необходимо удалённое подключение
[/QUOTE]

[QUOTE]
GRANT ALL PRIVILEGES(полные права на все операции)
[/QUOTE]

[QUOTE]
*.*(все базы данных и таблицы)
[/QUOTE]

[QUOTE]
'root'@'%'(пользователь root с любого хоста)
[/QUOTE]

[QUOTE]
%(с любого хоста)
[/QUOTE]

[SIZE=3]Запуск веб-сервера Apache[/SIZE]

[CODE]
systemctl enable --now httpd2                                                            
                                                                                              
 
[/CODE]

[SIZE=3]Содержимое файла /etc/httpd2/conf/sites-available/phpmyadmin.conf[/SIZE]

[CODE]
Alias /phpmyadmin /usr/share/phpmyadmin                                                  
                                                                                              
  <Directory /usr/share/phpmyadmin>                                                           
      Options FollowSymLinks                                                                  
      DirectoryIndex index.php                                                                
      AllowOverride All
      Require all granted                                                                     
  </Directory>                                                                                
                                                                                              
 
[/CODE]

[SIZE=3]Включение конфигурационного файла[/SIZE]

[CODE]
a2ensite phpmyadmin                                                                      
                                                                                              
 
[/CODE]

[SIZE=3]Проверка синтаксиса конфигурации Apache[/SIZE]

[CODE]
apachectl configtest                                                                     
                                                                                              
 
[/CODE]

[SIZE=3]Применение изменений Apache[/SIZE]

[CODE]
systemctl reload httpd2                                                                  
                                                                                              
 
[/CODE]

[SIZE=3]Исправление ошибки входа в phpMyAdmin в /etc/my.cnf.d/server.cnf[/SIZE]

[CODE]
skip-grant-tables                                                                        
 
[/CODE]

[QUOTE]
Опционально, если возникает ошибка при входе
[/QUOTE]

[SIZE=3]Перезагрузка MariaDB после изменений[/SIZE]

[CODE]
systemctl restart mariadb                                                                
                                                                                              
 
[/CODE]

[SIZE=3]Проверка[/SIZE]

[SIZE=3]Проверка открытого порта MariaDB[/SIZE]

[CODE]
ss -tlpn | grep mysqld                                                                   
 
[/CODE]

[QUOTE]
Показывает открытый порт 3306 для удалённых подключений
[/QUOTE]

[SIZE=3]Проверка удалённого доступа с клиента[/SIZE]

[CODE]
mariadb -h IP_адрес_сервера -u root -p                                                   
 
[/CODE]

[QUOTE]
На клиенте должен быть установлен пакет mariadb-client
[/QUOTE]

[SIZE=3]Доступ к phpMyAdmin[/SIZE]

[QUOTE]
Открыть в браузере http://IP_адрес_сервера/phpmyadmin
[/QUOTE]

[QUOTE]
Вход под пользователем root с паролем P@ssw0rd
[/QUOTE]

[SIZE=4]PostgreSQL_base-command[/SIZE]

[SIZE=3]Подключение к PostgreSQL[/SIZE]

[SIZE=3]Подключение к БД от имени пользователя postgres[/SIZE]

[CODE]
psql -U postgres                                                                         
 
[/CODE]

[QUOTE]
-U(имя пользователя)
[/QUOTE]

[SIZE=3]Подключение к конкретной базе данных[/SIZE]

[CODE]
psql -U user01 -d db01                                                                   
 
[/CODE]

[QUOTE]
-d(имя базы данных)
[/QUOTE]

[SIZE=3]Удалённое подключение к БД[/SIZE]

[CODE]
psql -U user01 -h 192.168.1.10 -d db01                                                   
 
[/CODE]

[QUOTE]
-h(IP-адрес или hostname сервера)
[/QUOTE]

[SIZE=3]Подключение с указанием порта[/SIZE]

[CODE]
psql -U user01 -h 192.168.1.10 -p 5432 -d db01                                           
 
[/CODE]

[QUOTE]
-p(порт) по умолчанию 5432
[/QUOTE]

[SIZE=3]Выход из psql[/SIZE]

[CODE]
\q                                                                                       
                                                                                              
 
[/CODE]

[SIZE=3]Управление базами данных[/SIZE]

[SIZE=3]Создание базы данных[/SIZE]

[CODE]
CREATE DATABASE mydb;                                                                    
 
[/CODE]

[QUOTE]
mydb(имя создаваемой БД)
[/QUOTE]

[SIZE=3]Создание БД с указанием владельца и кодировки[/SIZE]

[CODE]
CREATE DATABASE mydb OWNER myuser ENCODING 'UTF8';                                       
 
[/CODE]

[QUOTE]
OWNER(владелец БД); ENCODING(кодировка) {UTF8, LATIN1}
[/QUOTE]

[SIZE=3]Удаление базы данных[/SIZE]

[CODE]
DROP DATABASE mydb;                                                                      
 
[/CODE]

[QUOTE]
Удаляет БД безвозвратно
[/QUOTE]

[SIZE=3]Переименование базы данных[/SIZE]

[CODE]
ALTER DATABASE mydb RENAME TO newdb;                                                     
                                                                                              
 
[/CODE]

[SIZE=3]Просмотр списка баз данных[/SIZE]

[CODE]
\l                                                                                       
 
[/CODE]

[QUOTE]
Показывает все БД с владельцами и кодировками
[/QUOTE]

[SIZE=3]Просмотр списка БД через SQL[/SIZE]

[CODE]
SELECT datname FROM pg_database;                                                         
                                                                                              
 
[/CODE]

[SIZE=3]Подключение к другой БД внутри psql[/SIZE]

[CODE]
\c dbname                                                                                
 
[/CODE]

[QUOTE]
Переключение между базами данных
[/QUOTE]

[SIZE=3]Просмотр размера базы данных[/SIZE]

[CODE]
SELECT pg_size_pretty(pg_database_size('mydb'));                                         
                                                                                              
 
[/CODE]

[SIZE=3]Управление пользователями[/SIZE]

[SIZE=3]Создание пользователя[/SIZE]

[CODE]
CREATE USER username WITH PASSWORD 'P@ssw0rd';                                           
 
[/CODE]

[QUOTE]
username(имя пользователя)
[/QUOTE]

[SIZE=3]Создание пользователя с правами суперпользователя[/SIZE]

[CODE]
CREATE USER admin WITH SUPERUSER PASSWORD 'P@ssw0rd';                                    
 
[/CODE]

[QUOTE]
SUPERUSER(полные права на сервер)
[/QUOTE]

[SIZE=3]Создание пользователя с правами создания БД[/SIZE]

[CODE]
CREATE USER dbcreator WITH CREATEDB PASSWORD 'P@ssw0rd';                                 
 
[/CODE]

[QUOTE]
CREATEDB(право создавать базы данных)
[/QUOTE]

[SIZE=3]Изменение пароля пользователя[/SIZE]

[CODE]
ALTER USER username WITH PASSWORD 'NewP@ssw0rd';                                         
                                                                                              
 
[/CODE]

[SIZE=3]Удаление пользователя[/SIZE]

[CODE]
DROP USER username;                                                                      
                                                                                              
 
[/CODE]

[SIZE=3]Просмотр списка пользователей[/SIZE]

[CODE]
\du                                                                                      
 
[/CODE]

[QUOTE]
Показывает пользователей с их ролями
[/QUOTE]

[SIZE=3]Просмотр списка пользователей через SQL[/SIZE]

[CODE]
SELECT usename, usesuper, usecreatedb FROM pg_catalog.pg_user;                           
                                                                                              
 
[/CODE]

[SIZE=3]Переименование пользователя[/SIZE]

[CODE]
ALTER USER oldname RENAME TO newname;                                                    
                                                                                              
 
[/CODE]

[SIZE=3]Управление правами доступа[/SIZE]

[SIZE=3]Предоставление всех прав на БД пользователю[/SIZE]

[CODE]
GRANT ALL PRIVILEGES ON DATABASE mydb TO username;                                       
 
[/CODE]

[QUOTE]
ALL PRIVILEGES(все права на БД)
[/QUOTE]

[SIZE=3]Предоставление прав на подключение к БД[/SIZE]

[CODE]
GRANT CONNECT ON DATABASE mydb TO username;                                              
 
[/CODE]

[QUOTE]
CONNECT(право подключаться к БД)
[/QUOTE]

[SIZE=3]Предоставление прав на схему[/SIZE]

[CODE]
GRANT ALL ON SCHEMA public TO username;                                                  
 
[/CODE]

[QUOTE]
public(схема по умолчанию)
[/QUOTE]

[SIZE=3]Предоставление прав на все таблицы в схеме[/SIZE]

[CODE]
GRANT ALL PRIVILEGES ON ALL TABLES IN SCHEMA public TO username;                         
                                                                                              
 
[/CODE]

[SIZE=3]Предоставление прав на конкретную таблицу[/SIZE]

[CODE]
GRANT SELECT, INSERT, UPDATE, DELETE ON tablename TO username;                           
 
[/CODE]

[QUOTE]
SELECT, INSERT, UPDATE, DELETE(типы операций)
[/QUOTE]

[SIZE=3]Отзыв прав у пользователя[/SIZE]

[CODE]
REVOKE ALL PRIVILEGES ON DATABASE mydb FROM username;                                    
                                                                                              
 
[/CODE]

[SIZE=3]Изменение владельца базы данных[/SIZE]

[CODE]
ALTER DATABASE mydb OWNER TO newowner;                                                   
                                                                                              
 
[/CODE]

[SIZE=3]Изменение владельца таблицы[/SIZE]

[CODE]
ALTER TABLE tablename OWNER TO newowner;                                                 
                                                                                              
 
[/CODE]

[SIZE=3]Управление таблицами[/SIZE]

[SIZE=3]Просмотр списка таблиц[/SIZE]

[CODE]
\dt                                                                                      
 
[/CODE]

[QUOTE]
Показывает таблицы в текущей БД
[/QUOTE]

[SIZE=3]Просмотр списка таблиц с размерами[/SIZE]

[CODE]
\dt+                                                                                     
 
[/CODE]

[QUOTE]
Показывает таблицы с размерами и описанием
[/QUOTE]

[SIZE=3]Просмотр структуры таблицы[/SIZE]

[CODE]
\d tablename                                                                             
 
[/CODE]

[QUOTE]
Показывает столбцы, типы данных, индексы
[/QUOTE]

[SIZE=3]Создание таблицы[/SIZE]

[CODE]
CREATE TABLE users (                                                                     
      id SERIAL PRIMARY KEY,                                                                  
      username VARCHAR(50) NOT NULL,                                                          
      email VARCHAR(100) UNIQUE,                                                              
      created_at TIMESTAMP DEFAULT NOW()                                                      
  );                                                                                          
 
[/CODE]

[QUOTE]
SERIAL(автоинкремент); PRIMARY KEY(первичный ключ); NOT NULL(обязательное поле); UNIQUE(уникальное значение)
[/QUOTE]

[SIZE=3]Удаление таблицы[/SIZE]

[CODE]
DROP TABLE tablename;
                                                                                              
 
[/CODE]

[SIZE=3]Переименование таблицы[/SIZE]

[CODE]
ALTER TABLE oldname RENAME TO newname;                                                   
                                                                                              
 
[/CODE]

[SIZE=3]Добавление столбца в таблицу[/SIZE]

[CODE]
ALTER TABLE tablename ADD COLUMN columnname VARCHAR(50);                                 
                                                                                              
 
[/CODE]

[SIZE=3]Удаление столбца из таблицы[/SIZE]

[CODE]
ALTER TABLE tablename DROP COLUMN columnname;                                            
                                                                                              
 
[/CODE]

[SIZE=3]Изменение типа данных столбца[/SIZE]

[CODE]
ALTER TABLE tablename ALTER COLUMN columnname TYPE INTEGER;                              
                                                                                              
 
[/CODE]

[SIZE=3]Очистка таблицы[/SIZE]

[CODE]
TRUNCATE TABLE tablename;                                                                
 
[/CODE]

[QUOTE]
Удаляет все строки, но сохраняет структуру
[/QUOTE]

[SIZE=3]Работа с данными[/SIZE]

[SIZE=3]Вставка данных в таблицу[/SIZE]

[CODE]
INSERT INTO users (username, email) VALUES ('john', 'john@example.com');                 
                                                                                              
 
[/CODE]

[SIZE=3]Вставка нескольких строк[/SIZE]

[CODE]
INSERT INTO users (username, email) VALUES                                               
  ('alice', 'alice@example.com'),                                                             
  ('bob', 'bob@example.com');                                                                 
                                                                                              
 
[/CODE]

[SIZE=3]Выборка всех данных из таблицы[/SIZE]

[CODE]
SELECT * FROM users;                                                                     
                                                                                              
 
[/CODE]

[SIZE=3]Выборка конкретных столбцов[/SIZE]

[CODE]
SELECT username, email FROM users;                                                       
                                                                                              
 
[/CODE]

[SIZE=3]Выборка с условием[/SIZE]

[CODE]
SELECT * FROM users WHERE id = 1;                                                        
 
[/CODE]

[QUOTE]
WHERE(условие фильтрации)
[/QUOTE]

[SIZE=3]Выборка с сортировкой[/SIZE]

[CODE]
SELECT * FROM users ORDER BY created_at DESC;                                            
 
[/CODE]

[QUOTE]
ORDER BY(сортировка); DESC(по убыванию) {ASC, DESC}
[/QUOTE]

[SIZE=3]Выборка с ограничением количества строк[/SIZE]

[CODE]
SELECT * FROM users LIMIT 10;                                                            
 
[/CODE]

[QUOTE]
LIMIT(ограничение количества строк)
[/QUOTE]

[SIZE=3]Обновление данных[/SIZE]

[CODE]
UPDATE users SET email = 'newemail@example.com' WHERE id = 1;                            
                                                                                              
 
[/CODE]

[SIZE=3]Удаление данных[/SIZE]

[CODE]
DELETE FROM users WHERE id = 1;                                                          
                                                                                              
 
[/CODE]

[SIZE=3]Подсчёт количества строк[/SIZE]

[CODE]
SELECT COUNT(*) FROM users;                                                              
                                                                                              
 
[/CODE]

[SIZE=3]Резервное копирование и восстановление[/SIZE]

[SIZE=3]Создание резервной копии БД[/SIZE]

[CODE]
pg_dump -U postgres -d mydb -f backup.sql                                                
 
[/CODE]

[QUOTE]
-f(файл для сохранения резервной копии)
[/QUOTE]

[SIZE=3]Создание резервной копии в сжатом формате[/SIZE]

[CODE]
pg_dump -U postgres -d mydb -F c -f backup.dump                                          
 
[/CODE]

[QUOTE]
-F c(custom format, сжатый формат)
[/QUOTE]

[SIZE=3]Создание резервной копии всех БД[/SIZE]

[CODE]
pg_dumpall -U postgres -f all_databases.sql                                              
 
[/CODE]

[QUOTE]
pg_dumpall(резервное копирование всех БД и пользователей)
[/QUOTE]

[SIZE=3]Восстановление БД из SQL файла[/SIZE]

[CODE]
psql -U postgres -d mydb -f backup.sql                                                   
 
[/CODE]

[QUOTE]
Восстановление из текстового SQL файла
[/QUOTE]

[SIZE=3]Восстановление БД из сжатого формата[/SIZE]

[CODE]
pg_restore -U postgres -d mydb backup.dump                                               
 
[/CODE]

[QUOTE]
pg_restore(восстановление из custom format)
[/QUOTE]

[SIZE=3]Восстановление с созданием новой БД[/SIZE]

[CODE]
pg_restore -U postgres -C -d postgres backup.dump                                        
 
[/CODE]

[QUOTE]
-C(создать БД перед восстановлением)
[/QUOTE]

[SIZE=3]Информационные команды psql[/SIZE]

[SIZE=3]Список всех команд psql[/SIZE]

[CODE]
\?                                                                                       
 
[/CODE]

[QUOTE]
Показывает все доступные команды psql
[/QUOTE]

[SIZE=3]Список SQL команд[/SIZE]

[CODE]
\h                                                                                       
 
[/CODE]

[QUOTE]
Показывает справку по SQL командам
[/QUOTE]

[SIZE=3]Справка по конкретной SQL команде[/SIZE]

[CODE]
\h CREATE TABLE                                                                          
 
[/CODE]

[QUOTE]
Показывает синтаксис команды CREATE TABLE
[/QUOTE]

[SIZE=3]Просмотр текущей БД и пользователя[/SIZE]

[CODE]
\conninfo                                                                                
 
[/CODE]

[QUOTE]
Показывает информацию о текущем подключении
[/QUOTE]

[SIZE=3]Просмотр всех схем[/SIZE]

[CODE]
\dn                                                                                      
 
[/CODE]

[QUOTE]
Показывает список схем в текущей БД
[/QUOTE]

[SIZE=3]Просмотр всех представлений[/SIZE]

[CODE]
\dv                                                                                      
 
[/CODE]

[QUOTE]
Показывает список представлений (views)
[/QUOTE]

[SIZE=3]Просмотр всех индексов[/SIZE]

[CODE]
\di                                                                                      
 
[/CODE]

[QUOTE]
Показывает список индексов
[/QUOTE]

[SIZE=3]Просмотр всех последовательностей[/SIZE]

[CODE]
\ds                                                                                      
 
[/CODE]

[QUOTE]
Показывает список sequences
[/QUOTE]

[SIZE=3]Включение расширенного вывода[/SIZE]

[CODE]
\x                                                                                       
 
[/CODE]

[QUOTE]
Переключает между обычным и расширенным форматом вывода
[/QUOTE]

[SIZE=3]Выполнение команд из файла[/SIZE]

[CODE]
\i /path/to/file.sql                                                                     
 
[/CODE]

[QUOTE]
Выполняет SQL команды из файла
[/QUOTE]

[SIZE=3]Вывод результата запроса в файл[/SIZE]

[CODE]
\o /path/to/output.txt                                                                   
  SELECT * FROM users;                                                                        
  \o                                                                                          
 
[/CODE]

[QUOTE]
\o(перенаправление вывода в файл); \o без параметра(отключение перенаправления)
[/QUOTE]

[SIZE=3]Измерение времени выполнения запросов[/SIZE]

[CODE]
\timing                                                                                  
 
[/CODE]

[QUOTE]
Включает/выключает отображение времени выполнения
[/QUOTE]

[SIZE=3]Управление индексами[/SIZE]

[SIZE=3]Создание индекса[/SIZE]

[CODE]
CREATE INDEX idx_username ON users(username);                                            
 
[/CODE]

[QUOTE]
idx_username(имя индекса); users(таблица); username(столбец)
[/QUOTE]

[SIZE=3]Создание уникального индекса[/SIZE]

[CODE]
CREATE UNIQUE INDEX idx_email ON users(email);                                           
 
[/CODE]

[QUOTE]
UNIQUE(индекс с уникальными значениями)
[/QUOTE]

[SIZE=3]Удаление индекса[/SIZE]

[CODE]
DROP INDEX idx_username;                                                                 
                                                                                              
 
[/CODE]

[SIZE=3]Просмотр индексов таблицы[/SIZE]

[CODE]
\d tablename                                                                             
 
[/CODE]

[QUOTE]
Показывает индексы в описании таблицы
[/QUOTE]

[SIZE=3]Управление транзакциями[/SIZE]

[SIZE=3]Начало транзакции[/SIZE]

[CODE]
BEGIN;                                                                                   
                                                                                              
 
[/CODE]

[SIZE=3]Фиксация транзакции[/SIZE]

[CODE]
COMMIT;                                                                                  
                                                                                              
 
[/CODE]

[SIZE=3]Откат транзакции[/SIZE]

[CODE]
ROLLBACK;
                                                                                              
 
[/CODE]

[SIZE=3]Пример использования транзакции[/SIZE]

[CODE]
BEGIN;                                                                                   
  UPDATE accounts SET balance = balance - 100 WHERE id = 1;                                   
  UPDATE accounts SET balance = balance + 100 WHERE id = 2;                                   
  COMMIT;                                                                                     
 
[/CODE]

[QUOTE]
Транзакция для атомарного выполнения нескольких операций
[/QUOTE]

[SIZE=3]Проверка[/SIZE]

[SIZE=3]Проверка версии PostgreSQL[/SIZE]

[CODE]
SELECT version();                                                                        
                                                                                              
 
[/CODE]

[SIZE=3]Проверка текущего времени на сервере[/SIZE]

[CODE]
SELECT NOW();                                                                            
                                                                                              
 
[/CODE]

[SIZE=3]Проверка активных подключений[/SIZE]

[CODE]
SELECT * FROM pg_stat_activity;                                                          
 
[/CODE]

[QUOTE]
Показывает все активные подключения к серверу
[/QUOTE]

[SIZE=3]Проверка размера всех БД[/SIZE]

[CODE]
SELECT datname, pg_size_pretty(pg_database_size(datname)) FROM pg_database;              
                                                                                              
 
[/CODE]

[SIZE=3]Проверка размера всех таблиц в БД[/SIZE]

[CODE]
SELECT tablename, pg_size_pretty(pg_total_relation_size(schemaname||'.'||tablename))     
  FROM pg_tables WHERE schemaname = 'public';
[/CODE]

[SIZE=4]RADIUS[/SIZE]

[SIZE=3]Установка RADIUS сервера[/SIZE]

[SIZE=3]Установка пакетов[/SIZE]

[CODE]
apt-get update && apt-get install -y freeradius freeradius-utils                         
 
[/CODE]

[SIZE=3]Запуск службы[/SIZE]

[CODE]
systemctl enable --now radiusd                                                           
                                                                                              
 
[/CODE]

[SIZE=3]Настройка RADIUS сервера[/SIZE]

[SIZE=3]В /etc/raddb/clients.conf[/SIZE]

[CODE]
client ALL {                                                                             
    ipaddr = 0.0.0.0
    netmask = 0                                                                               
    secret = P@ssw0rd                                                                         
  }                                                                                           
 
[/CODE]

[QUOTE]
ipaddr(IP клиента); netmask(маска сети); secret(общий секрет)
[/QUOTE]

[SIZE=3]В конец /etc/raddb/users[/SIZE]

[CODE]
netuser Cleartext-Password := "P@ssw0rd"                                                 
          Service-Type = Administrative-User,                                                 
          Cisco-AVPair = "shell:roles=admin"                                                  
 
[/CODE]

[QUOTE]
Cleartext-Password(пароль пользователя); Service-Type(тип доступа); Cisco-AVPair(роль для Cisco)
[/QUOTE]

[SIZE=3]Перезапуск службы[/SIZE]

[CODE]
systemctl restart radiusd
                                                                                              
 
[/CODE]

[SIZE=3]Проверка RADIUS сервера[/SIZE]

[SIZE=3]Проверка статуса службы[/SIZE]

[CODE]
systemctl status radiusd                                                                 
 
[/CODE]

[QUOTE]
служба должна быть active (running)
[/QUOTE]

[SIZE=3]Тестирование аутентификации[/SIZE]

[CODE]
radtest netuser P@ssw0rd localhost 0 P@ssw0rd                                            
 
[/CODE]

[QUOTE]
должен вернуть Access-Accept
[/QUOTE]

[SIZE=3]Установка RADIUS клиента[/SIZE]

[SIZE=3]Установка пакетов[/SIZE]

[CODE]
apt-get update && apt-get install -y pam_radius                                          
 
[/CODE]

[SIZE=3]В /etc/pam_radius_auth.conf[/SIZE]

[CODE]
<ip сервера> P@ssw0rd 3                                                                  
 
[/CODE]

[QUOTE]
формат: IP секрет таймаут
[/QUOTE]

[SIZE=3]В /etc/pam.d/sshd и /etc/pam.d/system-auth-local[/SIZE]

[CODE]
auth  sufficient  pam_radius_auth.so                                                     
 
[/CODE]

[QUOTE]
sufficient(достаточно для авторизации); pam_radius_auth.so(модуль RADIUS)
[/QUOTE]

[SIZE=3]Создание пользователя[/SIZE]

[CODE]
useradd netuser                                                                          
 
[/CODE]

[QUOTE]
пользователь должен совпадать с настроенным на сервере
[/QUOTE]

[SIZE=3]Проверка RADIUS клиента[/SIZE]

[SIZE=3]Проверка подключения через SSH[/SIZE]

[CODE]
ssh netuser@<ip клиента>                                                                 
 
[/CODE]

[QUOTE]
вход должен пройти с паролем P@ssw0rd через RADIUS-сервер
[/QUOTE]

[SIZE=4]replication_postgresql-server[/SIZE]

[SIZE=3]Установка PostgreSQL на резервном сервере[/SIZE]

[SIZE=3]На SRV-BR установка пакетов[/SIZE]

[CODE]
apt-get install -y postgresql16 postgresql16-server postgresql16-contrib                 
 
[/CODE]

[QUOTE]
SRV-BR(резервный сервер); SRV-HQ(основной сервер)
[/QUOTE]

[SIZE=3]Настройка основного сервера[/SIZE]

[SIZE=3]На SRV-HQ в /var/lib/pgsql/data/postgresql.conf[/SIZE]

[CODE]
wal_level = replica                                                                      
  max_wal_senders = 2                                                                         
  max_replication_slots = 2                                                                   
  hot_standby = on                                                                            
  hot_standby_feedback = on                                                                   
 
[/CODE]

[QUOTE]
wal_level(уровень журналирования); max_wal_senders(количество процессов репликации); hot_standby(чтение на реплике)
[/QUOTE]

[SIZE=3]Перезапуск службы на SRV-HQ[/SIZE]

[CODE]
systemctl restart postgresql
                                                                                              
 
[/CODE]

[SIZE=3]Настройка репликации на резервном сервере[/SIZE]

[SIZE=3]На SRV-BR остановка службы[/SIZE]

[CODE]
systemctl stop postgresql                                                                
                                                                                              
 
[/CODE]

[SIZE=3]Очистка директории данных[/SIZE]

[CODE]
rm -rf /var/lib/pgsql/data/*                                                             
 
[/CODE]

[QUOTE]
удаляет существующие данные для создания реплики
[/QUOTE]

[SIZE=3]Создание базовой копии с SRV-HQ[/SIZE]

[CODE]
pg_basebackup -h 192.168.11.67 -U postgres -D /var/lib/pgsql/data --wal-method=stream    
  --write-recovery-conf                                                                       
 
[/CODE]

[QUOTE]
-h(IP основного сервера); -U(пользователь); -D(директория данных); --wal-method(метод передачи WAL); --write-recovery-conf(создание конфига репликации)
[/QUOTE]

[SIZE=3]Установка прав доступа[/SIZE]

[CODE]
chown -R postgres:postgres /var/lib/pgsql/data/
                                                                                              
 
[/CODE]

[SIZE=3]Запуск службы на SRV-BR[/SIZE]

[CODE]
systemctl start postgresql                                                               
                                                                                              
 
[/CODE]

[SIZE=3]Проверка репликации[/SIZE]

[SIZE=3]Подключение к базе данных[/SIZE]

[CODE]
psql -U postgres                                                                         
 
[/CODE]

[QUOTE]
подключение к PostgreSQL
[/QUOTE]

[SIZE=3]Проверка статуса репликации на SRV-HQ[/SIZE]

[CODE]
SELECT * FROM pg_stat_replication;                                                       
 
[/CODE]

[QUOTE]
показывает подключенные реплики
[/QUOTE]

[SIZE=3]Проверка данных на SRV-BR[/SIZE]

[CODE]
\c one                                                                                   
  \dt+                                                                                        
 
[/CODE]

[QUOTE]
\c(подключение к БД); \dt+(список таблиц с размерами)
[/QUOTE]

[SIZE=4]resolve_options[/SIZE]

[SIZE=3]Настройка[/SIZE]

[SIZE=3]Просмотр текущей конфигурации[/SIZE]

[CODE]
cat /etc/resolv.conf                                                                     
 
[/CODE]

[QUOTE]
показывает текущие DNS-серверы
[/QUOTE]

[SIZE=3]Добавление одного DNS-сервера[/SIZE]

[CODE]
echo "nameserver 77.88.8.8" > /etc/resolv.conf                                           
 
[/CODE]

[QUOTE]
перезаписывает файл; 77.88.8.8(Яндекс DNS)
[/QUOTE]

[SIZE=3]Добавление нескольких DNS-серверов[/SIZE]

[CODE]
echo "nameserver 77.88.8.8" > /etc/resolv.conf                                           
  echo "nameserver 8.8.8.8" >> /etc/resolv.conf                                               
 
[/CODE]

[QUOTE]
добавляет в конец файла; 8.8.8.8(Google DNS)
[/QUOTE]

[SIZE=3]Настройка с доменом поиска[/SIZE]

[CODE]
nameserver 192.168.1.1                                                                   
  search example.local                                                                        
  domain example.local                                                                        
 
[/CODE]

[QUOTE]
search(список доменов для поиска); domain(локальный домен)
[/QUOTE]

[SIZE=3]Настройка с опциями[/SIZE]

[CODE]
nameserver 77.88.8.8                                                                     
  options timeout:2 attempts:3 rotate                                                         
 
[/CODE]

[QUOTE]
timeout(таймаут запроса в секундах); attempts(количество попыток); rotate(чередование серверов)
[/QUOTE]

[SIZE=3]Проверка DNS[/SIZE]

[SIZE=3]Проверка разрешения имен[/SIZE]

[CODE]
nslookup ya.ru
 
[/CODE]

[QUOTE]
должен вернуть IP-адрес
[/QUOTE]

[SIZE=3]Проверка через dig(bind-utils)[/SIZE]

[CODE]
dig ya.ru                                                                                
 
[/CODE]

[QUOTE]
показывает подробную информацию о DNS-запросе
[/QUOTE]

[SIZE=3]Проверка через host[/SIZE]

[CODE]
host ya.ru                                                                               
 
[/CODE]

[QUOTE]
простая проверка разрешения имени
[/QUOTE]

[SIZE=4]rsyslog[/SIZE]

[SIZE=3]Установка[/SIZE]

[SIZE=3]Установка пакетов на всех устройствах[/SIZE]

[CODE]
apt-get install rsyslog logrotate                                                        
 
[/CODE]

[QUOTE]
rsyslog(сбор и пересылка логов); logrotate(ротация и сжатие логов)
[/QUOTE]

[QUOTE]
Обычно работают в связке
[/QUOTE]

[SIZE=3]Настройка сервера сбора логов[/SIZE]

[SIZE=3]В /etc/rsyslog.conf[/SIZE]

[CODE]
module(load="imuxsock")                                                                  
  module(load="imklog")                                                                       
  module(load="imudp")                                                                        
  input(type="imudp" port="514")                                                              
  module(load="imtcp")                                                                        
  input(type="imtcp" port="514")                                                              
                                                                                              
  $template RemoteLogs, "/opt/%HOSTNAME%/%PROGRAMNAME%.log"                                   
                  
  if ($fromhost-ip != "127.0.0.1" and $syslogseverity <= 4) then ?RemoteLogs                  
  & stop          
 
[/CODE]

[QUOTE]
imuxsock(локальные сообщения); imklog(логи ядра); imudp/imtcp(приём по UDP/TCP); $syslogseverity <= 4(warning и выше); & stop(остановка обработки)
[/QUOTE]

[SIZE=3]Создание каталогов для логов[/SIZE]

[CODE]
mkdir -p /opt/client1
  mkdir -p /opt/client2                                                                       
  mkdir -p /opt/client3                                                                       
 
[/CODE]

[QUOTE]
создаются каталоги для каждого клиента
[/QUOTE]

[SIZE=3]Установка прав на каталоги[/SIZE]

[CODE]
chown -R root:root /opt                                                                  
  chmod -R 755 /opt                                                                           
 
[/CODE]

[QUOTE]
права для записи логов службой rsyslog
[/QUOTE]

[SIZE=3]Перезапуск службы на сервере[/SIZE]

[CODE]
systemctl restart rsyslog                                                                
                                                                                              
 
[/CODE]

[SIZE=3]Настройка клиента[/SIZE]

[SIZE=3]В /etc/rsyslog.conf на клиенте[/SIZE]

[CODE]
*.warning action(type="omfwd"                                                            
      target="<HQ-SRV_IP>"                                                                    
      port="514"                                                                              
      protocol="tcp"                                                                          
      action.resumeRetryCount="-1"                                                            
      queue.type="linkedList"                                                                 
      queue.size="10000")                                                                     
 
[/CODE]

[QUOTE]
*.warning(уровень warning и выше); target(IP сервера логов); protocol(tcp для надежности); resumeRetryCount=-1(бесконечные попытки); queue.size(размер очереди сообщений)
[/QUOTE]

[SIZE=3]Перезапуск службы на клиенте[/SIZE]

[CODE]
systemctl restart rsyslog
                                                                                              
 
[/CODE]

[SIZE=3]Проверка[/SIZE]

[SIZE=3]Проверка открытого порта на сервере[/SIZE]

[CODE]
ss -tulpn | grep 514                                                                     
 
[/CODE]

[QUOTE]
должен показать порты 514 TCP и UDP
[/QUOTE]

[SIZE=3]Проверка каталогов логов на сервере[/SIZE]

[CODE]
ls -la /opt/                                                                             
 
[/CODE]

[QUOTE]
должны появиться каталоги с именами клиентов
[/QUOTE]

[SIZE=3]Проверка содержимого логов[/SIZE]

[CODE]
ls -la /opt/client1/                                                                     
 
[/CODE]

[QUOTE]
должны появиться файлы логов от клиента
[/QUOTE]

[SIZE=3]Тестовая отправка сообщения с клиента[/SIZE]

[CODE]
logger -p user.warning "Test message from client"                                        
 
[/CODE]

[QUOTE]
отправляет тестовое сообщение уровня warning
[/QUOTE]

[SIZE=3]Проверка получения на сервере[/SIZE]

[CODE]
tail -f /opt/client1/*.log                                                               
 
[/CODE]

[QUOTE]
должно появиться тестовое сообщение
[/QUOTE]

[SIZE=4]SAMBA_INTERNAL_samba[/SIZE]

[SIZE=3]Установка Samba DC[/SIZE]

[SIZE=3]Установка пакетов[/SIZE]

[CODE]
apt-get update && apt-get install -y task-samba-dc                                       
 
[/CODE]

[QUOTE]
task-samba-dc(Samba DC на базе Heimdal Kerberos)
[/QUOTE]

[SIZE=3]Остановка конфликтующих служб[/SIZE]

[CODE]
for i in smb nmb krb5kdc slapd bind; do systemctl disable $i --now; done                 
 
[/CODE]

[QUOTE]
Samba DC использует собственные LDAP и Kerberos
[/QUOTE]

[SIZE=3]Настройка имени узла и домена[/SIZE]

[SIZE=3]В /etc/sysconfig/network[/SIZE]

[CODE]
HOSTNAME=dc.domain.sample
 
[/CODE]

[QUOTE]
dc.domain.sample(FQDN сервера); domain.sample(имя домена)
[/QUOTE]

[SIZE=3]Установка имени узла[/SIZE]

[CODE]
hostnamectl set-hostname dc.domain.sample                                                  
  exec bash                                                                                   
  domainname domain.sample                                                                      
 
[/CODE]

[QUOTE]
exec bash(перезагрузка оболочки для применения)
[/QUOTE]

[SIZE=3]В /etc/resolvconf.conf[/SIZE]

[CODE]
nameserver 127.0.0.1                                                                     
 
[/CODE]

[QUOTE]
для корректного распознавания локальных DNS-запросов
[/QUOTE]

[SIZE=3]Подготовка к созданию домена[/SIZE]

[SIZE=3]Очистка баз и конфигурации Samba[/SIZE]

[CODE]
rm -f /etc/samba/smb.conf
  rm -rf /var/lib/samba                                                                       
  rm -rf /var/cache/samba                                                                     
  mkdir -p /var/lib/samba/sysvol                                                              
 
[/CODE]

[QUOTE]
удаляет предыдущую конфигурацию домена
[/QUOTE]

[SIZE=3]Создание домена[/SIZE]

[SIZE=3]Интерактивное создание домена[/SIZE]

[CODE]
samba-tool domain provision
 
[/CODE]

[QUOTE]
указать: доменное имя, рабочую группу, роль dc, бэкенд SAMBA_INTERNAL, DNS forwarder 77.88.8.8, пароль администратора
[/QUOTE]

[SIZE=3]Пакетное создание домена[/SIZE]

[CODE]
samba-tool domain provision --realm=domain.sample --domain=domain --adminpass='P@ssw0rd'
  --dns-backend=SAMBA_INTERNAL --option="dns forwarder=77.88.8.8" --server-role=dc            
  --use-rfc2307   
 
[/CODE]

[QUOTE]
--realm(имя области Kerberos и DNS домена); --domain(имя рабочей группы); --dns-backend(бэкенд DNS); --use-rfc2307(поддержка UID/GID и ACL)
[/QUOTE]

[SIZE=3]Запуск службы Samba[/SIZE]

[CODE]
systemctl enable --now samba
                                                                                              
 
[/CODE]

[SIZE=3]Копирование конфигурации Kerberos[/SIZE]

[CODE]
cp /var/lib/samba/private/krb5.conf /etc/krb5.conf                                       
 
[/CODE]

[QUOTE]
Samba создает шаблон krb5.conf при создании домена
[/QUOTE]

[SIZE=3]Проверка[/SIZE]

[SIZE=3]Проверка статуса службы[/SIZE]

[CODE]
systemctl status samba
 
[/CODE]

[QUOTE]
служба должна быть active (running)
[/QUOTE]

[SIZE=3]Просмотр информации о домене[/SIZE]

[CODE]
samba-tool domain info 127.0.0.1                                                         
 
[/CODE]

[QUOTE]
показывает общую информацию о домене
[/QUOTE]

[SIZE=3]Просмотр общих ресурсов[/SIZE]

[CODE]
smbclient -L localhost -U administrator                                                  
 
[/CODE]

[QUOTE]
должны быть netlogon и sysvol
[/QUOTE]

[SIZE=3]Проверка DNS в /etc/resolv.conf[/SIZE]

[CODE]
cat /etc/resolv.conf                                                                     
 
[/CODE]

[QUOTE]
должен быть nameserver 127.0.0.1
[/QUOTE]

[SIZE=3]Проверка SRV-записи Kerberos[/SIZE]

[CODE]
host -t SRV _kerberos._udp.domain.sample.                                                  
 
[/CODE]

[QUOTE]
утилита host из пакета bind-utils
[/QUOTE]

[SIZE=3]Проверка SRV-записи LDAP[/SIZE]

[CODE]
host -t SRV _ldap._tcp.domain.sample.                                                      
 
[/CODE]

[QUOTE]
проверяет доступность LDAP
[/QUOTE]

[SIZE=3]Проверка A-записи хоста[/SIZE]

[CODE]
host -t A dc.domain.sample.                                                                
 
[/CODE]

[QUOTE]
должен вернуть IP-адрес контроллера домена
[/QUOTE]

[SIZE=3]Проверка Kerberos[/SIZE]

[CODE]
kinit administrator@DOMAIN.SAMPLE                                                          
 
[/CODE]

[QUOTE]
имя домена в верхнем регистре; запрашивает пароль администратора
[/QUOTE]

[SIZE=4]samba_share_folder[/SIZE]

[SIZE=3]Настройка Samba для анонимного доступа[/SIZE]

[SIZE=3]Создание общей директории[/SIZE]

[CODE]
mkdir /opt/data                                                                          
  chmod 777 /opt/data                                                                         
 
[/CODE]

[QUOTE]
777(полные права для всех пользователей)
[/QUOTE]

[SIZE=3]В /etc/samba/smb.conf добавить секцию[/SIZE]

[CODE]
[samba]                                                                                  
  path = /opt/data                                                                            
  browseable = yes                                                                            
  writable = yes                                                                              
  guest ok = yes                                                                              
  read only = no                                                                              
  force user = nobody                                                                         
 
[/CODE]

[QUOTE]
guest ok = yes(анонимный доступ); force user(все действия от имени nobody)
[/QUOTE]

[SIZE=3]Перезапуск службы[/SIZE]

[CODE]
systemctl restart smbd                                                                   
                                                                                              
 
[/CODE]

[SIZE=3]Настройка Samba для пользователей домена[/SIZE]

[SIZE=3]Создание общей директории[/SIZE]

[CODE]
mkdir /opt/data
  chmod 770 /opt/data                                                                         
  chown root:domain_users /opt/data                                                           
 
[/CODE]

[QUOTE]
770(доступ только владельцу и группе); domain_users(группа домена)
[/QUOTE]

[SIZE=3]В /etc/samba/smb.conf добавить секцию[/SIZE]

[CODE]
[samba]                                                                                  
  path = /opt/data                                                                            
  browseable = yes                                                                            
  writable = yes                                                                              
  valid users = @domain_users                                                                 
  read only = no                                                                              
  create mask = 0660                                                                          
  directory mask = 0770                                                                       
 
[/CODE]

[QUOTE]
valid users = @domain_users(доступ только группе домена); create mask(права на новые файлы); directory mask(права на новые каталоги)
[/QUOTE]

[SIZE=3]Добавление пользователя Samba[/SIZE]

[CODE]
smbpasswd -a username
 
[/CODE]

[QUOTE]
создает пароль Samba для существующего системного пользователя
[/QUOTE]

[SIZE=3]Настройка Samba для конкретных пользователей[/SIZE]

[SIZE=3]В /etc/samba/smb.conf добавить секцию[/SIZE]

[CODE]
[samba]      
  path = /opt/data                                                                            
  browseable = yes                                                                            
  writable = yes                                                                              
  valid users = user1, user2, user3                                                           
  read only = no                                                                              
  write list = user1, user2                                                                   
 
[/CODE]

[QUOTE]
valid users(список разрешенных пользователей); write list(пользователи с правом записи)
[/QUOTE]

[SIZE=3]Описание основных опций Samba[/SIZE]

[SIZE=3]Опции доступа[/SIZE]

[CODE]
browseable = yes
  guest ok = yes                                                                              
  valid users = user1, @group1                                                                
  invalid users = user2                                                                       
  read only = no                                                                              
  writable = yes                                                                              
  write list = user1, @group1                                                                 
  read list = user2                                                                           
 
[/CODE]

[QUOTE]
browseable(видимость в сети); guest ok(гостевой доступ); valid users(разрешенные пользователи/группы); invalid users(запрещенные); write list(право записи); read list(только чтение)
[/QUOTE]

[SIZE=3]Опции прав доступа[/SIZE]

[CODE]
create mask = 0660
  directory mask = 0770                                                                       
  force user = nobody                                                                         
  force group = nogroup                                                                       
  inherit permissions = yes                                                                   
 
[/CODE]

[QUOTE]
create mask(права на файлы); directory mask(права на каталоги); force user/group(принудительный владелец); inherit permissions(наследование прав)
[/QUOTE]

[SIZE=3]Опции безопасности[/SIZE]

[CODE]
hosts allow = 192.168.1.0/24
  hosts deny = 192.168.2.0/24                                                                 
  max connections = 10                                                                        
 
[/CODE]

[QUOTE]
hosts allow(разрешенные сети); hosts deny(запрещенные сети); max connections(лимит подключений)
[/QUOTE]

[SIZE=3]Проверка[/SIZE]

[SIZE=3]Проверка конфигурации[/SIZE]

[CODE]
testparm     
 
[/CODE]

[QUOTE]
проверяет синтаксис smb.conf
[/QUOTE]

[SIZE=3]Просмотр активных подключений[/SIZE]

[CODE]
smbstatus                                                                                
 
[/CODE]

[QUOTE]
показывает подключенных пользователей и открытые файлы
[/QUOTE]

[SIZE=3]Подключение с клиента Windows[/SIZE]

[CODE]
\\192.168.1.1\samba                                                                      
 
[/CODE]

[QUOTE]
в проводнике Windows
[/QUOTE]

[SIZE=3]Подключение с клиента Linux[/SIZE]

[CODE]
smb://192.168.1.1/samba                                                                  
 
[/CODE]

[QUOTE]
в файловом менеджере или через smbclient
[/QUOTE]

[SIZE=4]SQL_install_MariaDB[/SIZE]

[SIZE=3]Установка[/SIZE]

[SIZE=3]Установка пакета[/SIZE]

[CODE]
apt-get install -y mariadb-server                                                        
   
 
[/CODE]

[SIZE=3]Включение и запуск службы[/SIZE]

[CODE]
systemctl enable --now mariadb

 
[/CODE]

[SIZE=3]Настройка MariaDB[/SIZE]

[SIZE=3]Установка пароля root[/SIZE]

[CODE]
mariadb -u root
  ALTER USER 'root'@'localhost' IDENTIFIED BY 'P@ssw0rd';
  EXIT;

 
[/CODE]

[SIZE=3]Разрешение доступа из сети в /etc/my.cnf.d/server.cnf[/SIZE]

[CODE]
sed -i "s/skip-networking/#skip-networking/g" /etc/my.cnf.d/server.cnf
                                                                                              
 
[/CODE]

[SIZE=3]Перезапуск службы[/SIZE]

[CODE]
systemctl restart mariadb                                                                
                                                                                              
 
[/CODE]

[SIZE=3]Разрешение доступа для root по сети[/SIZE]

[CODE]
mariadb -u root -p                                                                       
  GRANT ALL PRIVILEGES ON *.* TO 'root'@'localhost';                                          
  UPDATE mysql.user SET host='%' WHERE user='root';                                           
  FLUSH PRIVILEGES;                                                                           
  EXIT;                                                                                       
 
[/CODE]

[QUOTE]
host='%' разрешает подключение с любого узла
[/QUOTE]

[SIZE=3]Перезапуск службы[/SIZE]

[CODE]
systemctl restart mariadb                                                                
                                                                                              
 
[/CODE]

[SIZE=3]Проверка MariaDB[/SIZE]

[SIZE=3]Проверка пользователей на сервере[/SIZE]

[CODE]
mariadb -u root -p                                                                       
  SELECT user, HOST FROM mysql.user;                                                          
  EXIT;                                                                                       
                                                                                              
 
[/CODE]

[SIZE=3]Удаленное подключение с клиента[/SIZE]

[CODE]
mariadb -h IP_СЕРВЕРА -u root -p
                                                                                              
 
[/CODE]

[SIZE=3]Создание БД и пользователей[/SIZE]

[SIZE=3]Создание базы данных[/SIZE]

[CODE]
mariadb -u root -p                                                                       
  CREATE DATABASE db01;                                                                       
 
[/CODE]

[QUOTE]
db01 - имя создаваемой БД
[/QUOTE]

[SIZE=3]Создание пользователя[/SIZE]

[CODE]
CREATE USER 'user01'@'%' IDENTIFIED BY 'P@ssw0rd';                                       
 
[/CODE]

[QUOTE]
'%' означает подключение с любого хоста
[/QUOTE]

[SIZE=3]Предоставление прав пользователю[/SIZE]

[CODE]
GRANT ALL PRIVILEGES ON db01.* TO 'user01'@'%';                                          
  FLUSH PRIVILEGES;                                                                           
                                                                                              
 
[/CODE]

[SIZE=3]Проверка существования БД и пользователей[/SIZE]

[CODE]
SHOW DATABASES;                                                                          
  SELECT user, HOST FROM mysql.user;                                                          
  EXIT;
[/CODE]

[SIZE=4]SQL_install_MySQL[/SIZE]

[SIZE=3]Установка[/SIZE]

[SIZE=3]Установка пакета[/SIZE]

[CODE]
apt-get install -y MySQL-server                                                          
   
 
[/CODE]

[SIZE=3]Включение и запуск службы[/SIZE]

[CODE]
systemctl enable --now mysqld

 
[/CODE]

[SIZE=3]Настройка MySQL[/SIZE]

[SIZE=3]Установка пароля root[/SIZE]

[CODE]
mysql -u root
  ALTER USER 'root'@'localhost' IDENTIFIED BY 'P@ssw0rd';
  EXIT;

 
[/CODE]

[SIZE=3]Разрешение доступа из сети в /etc/my.cnf.d/server.cnf[/SIZE]

[CODE]
sed -i "s/skip-networking/#skip-networking/g" /etc/my.cnf.d/server.cnf
                                                                                              
 
[/CODE]

[SIZE=3]Перезапуск службы[/SIZE]

[CODE]
systemctl restart mysqld                                                                 
                                                                                              
 
[/CODE]

[SIZE=3]Разрешение доступа для root по сети[/SIZE]

[CODE]
mysql -u root -p                                                                         
  GRANT ALL PRIVILEGES ON *.* TO 'root'@'localhost';                                          
  UPDATE mysql.user SET host='%' WHERE user='root';                                           
  FLUSH PRIVILEGES;                                                                           
  EXIT;                                                                                       
 
[/CODE]

[QUOTE]
host='%' разрешает подключение с любого узла
[/QUOTE]

[SIZE=3]Перезапуск службы[/SIZE]

[CODE]
systemctl restart mysqld                                                                 
                                                                                              
 
[/CODE]

[SIZE=3]Проверка MySQL[/SIZE]

[SIZE=3]Проверка пользователей на сервере[/SIZE]

[CODE]
mysql -u root -p                                                                         
  SELECT user, HOST FROM mysql.user;                                                          
  EXIT;                                                                                       
                                                                                              
 
[/CODE]

[SIZE=3]Удаленное подключение с клиента[/SIZE]

[CODE]
mysql -h IP_СЕРВЕРА -u root -p                                                           
                                                                                              
 
[/CODE]

[SIZE=3]Создание БД и пользователей[/SIZE]

[SIZE=3]Создание базы данных[/SIZE]

[CODE]
mysql -u root -p                                                                         
  CREATE DATABASE db01;                                                                       
 
[/CODE]

[QUOTE]
db01 - имя создаваемой БД
[/QUOTE]

[SIZE=3]Создание пользователя[/SIZE]

[CODE]
CREATE USER 'user01'@'%' IDENTIFIED BY 'P@ssw0rd';                                       
 
[/CODE]

[QUOTE]
'%' означает подключение с любого хоста
[/QUOTE]

[SIZE=3]Предоставление прав пользователю[/SIZE]

[CODE]
GRANT ALL PRIVILEGES ON db01.* TO 'user01'@'%';                                          
  FLUSH PRIVILEGES;                                                                           
                                                                                              
 
[/CODE]

[SIZE=3]Проверка существования БД и пользователей[/SIZE]

[CODE]
SHOW DATABASES;                                                                          
  SELECT user, HOST FROM mysql.user;                                                          
  EXIT;
[/CODE]

[SIZE=4]SQL_install_PostgreSQL[/SIZE]

[SIZE=3]Установка[/SIZE]

[SIZE=3]Установка пакетов[/SIZE]

[CODE]
apt-get install -y postgresql16 postgresql16-server postgresql16-contrib                 
 
[/CODE]

[QUOTE]
postgresql16-contrib(дополнительные модули и утилиты)
[/QUOTE]

[SIZE=3]Создание системных БД[/SIZE]

[CODE]
/etc/init.d/postgresql initdb
                                                                                              
 
[/CODE]

[SIZE=3]Запуск службы[/SIZE]

[CODE]
systemctl enable --now postgresql                                                        
                                                                                              
 
[/CODE]

[SIZE=3]Установка пароля для пользователя postgres[/SIZE]

[CODE]
psql -U postgres                                                                         
  ALTER USER postgres WITH PASSWORD 'P@ssw0rd';                                               
  \q                                                                                          
                                                                                              
 
[/CODE]

[SIZE=3]Настройка[/SIZE]

[SIZE=3]Разрешение доступа из сети в /var/lib/pgsql/data/postgresql.conf[/SIZE]

[CODE]
listen_addresses = '*'                                                                   
 
[/CODE]

[QUOTE]
Найти listen_addresses = 'localhost' и заменить на '*'
[/QUOTE]

[QUOTE]
listen_addresses(адреса для прослушивания) {'*', 'localhost', '192.168.1.1'}
[/QUOTE]

[SIZE=3]Перезапуск службы после изменения postgresql.conf[/SIZE]

[CODE]
systemctl restart postgresql                                                             
                                                                                              
 
[/CODE]

[SIZE=3]Настройка парольной аутентификации в /var/lib/pgsql/data/pg_hba.conf[/SIZE]

[CODE]
host    all             all             0.0.0.0/0               md5                      
  host    replication     all             0.0.0.0/0               md5                         
 
[/CODE]

[QUOTE]
Добавить строки в конец файла перед секцией IPv6
[/QUOTE]

[QUOTE]
host(тип подключения) {host, local, hostssl}
[/QUOTE]

[QUOTE]
all(база данных) {all, имя_БД}
[/QUOTE]

[QUOTE]
all(пользователь) {all, имя_пользователя}
[/QUOTE]

[QUOTE]
0.0.0.0/0(IP-адреса клиентов) {0.0.0.0/0, 192.168.1.0/24, конкретный_IP}
[/QUOTE]

[QUOTE]
md5(метод аутентификации) {md5, trust, reject, scram-sha-256}
[/QUOTE]

[QUOTE]
Первая строка для обычных подключений, вторая для репликации
[/QUOTE]

[SIZE=3]Перезапуск службы после изменения pg_hba.conf[/SIZE]

[CODE]
systemctl restart postgresql                                                             
                                                                                              
 
[/CODE]

[SIZE=3]Создание базы данных и пользователя[/SIZE]

[CODE]
psql -U postgres                                                                         
  CREATE DATABASE db01;                                                                       
  CREATE USER user01 WITH PASSWORD 'P@ssw0rd';
  GRANT ALL PRIVILEGES ON DATABASE db01 TO user01;                                            
  \q                                                                                          
 
[/CODE]

[QUOTE]
db01(имя создаваемой БД); user01(имя пользователя)
[/QUOTE]

[SIZE=3]Создание нескольких баз данных и пользователей[/SIZE]

[CODE]
psql -U postgres                                                                         
  CREATE DATABASE one;                                                                        
  CREATE DATABASE two;                                                                        
  CREATE USER oneuser WITH PASSWORD 'P@ssw0rd';                                               
  CREATE USER twouser WITH PASSWORD 'P@ssw0rd';                                               
  GRANT ALL PRIVILEGES ON DATABASE one TO oneuser;                                            
  GRANT ALL PRIVILEGES ON DATABASE two TO twouser;                                            
  \q                                                                                          
                                                                                              
 
[/CODE]

[SIZE=3]Заполнение базы данных тестовыми данными[/SIZE]

[CODE]
pgbench -U postgres -i one                                                               
  pgbench -U postgres -i two                                                                  
 
[/CODE]

[QUOTE]
Опционально, для тестирования производительности
[/QUOTE]

[SIZE=3]Проверка[/SIZE]

[SIZE=3]Проверка открытого порта PostgreSQL[/SIZE]

[CODE]
ss -tlpn | grep postgres                                                                 
 
[/CODE]

[QUOTE]
Показывает открытый порт 5432
[/QUOTE]

[SIZE=3]Проверка БД и пользователей на сервере[/SIZE]

[CODE]
psql -U postgres                                                                         
  SELECT datname FROM pg_database;                                                            
  SELECT usename, usesuper, usecreatedb FROM pg_catalog.pg_user;                              
  \q                                                                                          
 
[/CODE]

[QUOTE]
Показывает список баз данных и пользователей
[/QUOTE]

[SIZE=3]Проверка таблиц в базе данных[/SIZE]

[CODE]
psql -U postgres                                                                         
  \c one                                                                                      
  \dt+                                                                                        
  \c two                                                                                      
  \dt+                                                                                        
  \q              
 
[/CODE]

[QUOTE]
\c(подключение к БД); \dt+(список таблиц с размерами)
[/QUOTE]

[SIZE=3]Локальное подключение на клиенте[/SIZE]

[CODE]
psql -U user01 db01                                                                      
 
[/CODE]

[QUOTE]
Подключение к БД db01 от имени user01
[/QUOTE]

[SIZE=3]Удалённое подключение на клиенте[/SIZE]

[CODE]
psql -U user01 -h IP_сервера -d db01                                                     
 
[/CODE]

[QUOTE]
-h(хост сервера); -d(имя базы данных)
[/QUOTE]

[SIZE=4]squid_base_options[/SIZE]

[SIZE=3]Установка[/SIZE]

[SIZE=3]Установка пакетов[/SIZE]

[CODE]
apt-get install squid squid-helpers                                                      
 
[/CODE]

[QUOTE]
squid(прокси-сервер); squid-helpers(модули аутентификации)
[/QUOTE]

[SIZE=3]Настройка Squid с аутентификацией через Samba AD[/SIZE]

[SIZE=3]В /etc/squid/squid.conf[/SIZE]

[CODE]
auth_param basic program /usr/lib/squid/basic_smb_lm_auth AD/srv-hq.ad.team
  auth_param basic children 5                                                                 
  auth_param basic realm Proxy Authentication Required                                        
  auth_param basic credentialsttl 2 hours                                                     
                                                                                              
  external_acl_type check_group %LOGIN /usr/lib/squid/ext_wbinfo_group_acl -d                 
                                                                                              
  acl authenticated proxy_auth REQUIRED                                                       
  acl group1 external check_group group1
  acl group2 external check_group group2                                                      
  acl group3 external check_group group3                                                      
  acl enterprise_services dst 192.168.0.0/16                                                  
  acl monitoring_system dst 192.168.1.100                                                     
  acl cli_hq src 192.168.2.10                                                                 
  acl forbidden_domains dstdomain vk.com mail.yandex.ru worldskills.org                       
                                                                                              
  http_access allow authenticated group1 enterprise_services                                  
  http_access allow authenticated group2 monitoring_system                                    
  http_access deny group3                                                                     
  http_access allow cli_hq !forbidden_domains                                                 
  http_access deny all                                                                        
                                                                                              
  http_port 3128                                                                              
 
[/CODE]

[QUOTE]
basic_smb_lm_auth(аутентификация через SMB); ext_wbinfo_group_acl(проверка групп через Winbind); authenticated(требует аутентификацию); dst(назначение); src(источник); !(отрицание); правила обрабатываются сверху вниз
[/QUOTE]

[SIZE=3]Перезапуск службы[/SIZE]

[CODE]
systemctl restart squid
                                                                                              
 
[/CODE]

[SIZE=3]Управление пользователями[/SIZE]

[SIZE=3]Смена пароля пользователя в Samba[/SIZE]

[CODE]
samba-tool user setpassword USER
 
[/CODE]

[QUOTE]
USER(имя пользователя домена)
[/QUOTE]

[SIZE=3]Проверка[/SIZE]

[SIZE=3]Проверка конфигурации Squid[/SIZE]

[CODE]
squid -k parse
 
[/CODE]

[QUOTE]
проверяет синтаксис squid.conf
[/QUOTE]

[SIZE=3]Проверка работы прокси с аутентификацией[/SIZE]

[CODE]
curl -v -x http://<ip прокси>:3128 --proxy-user "user1:P@ssw0rd" http://192.168.0.10     
 
[/CODE]

[QUOTE]
-x(адрес прокси); --proxy-user(учетные данные); -v(подробный вывод)
[/QUOTE]

[SIZE=3]Проверка статуса службы[/SIZE]

[CODE]
systemctl status squid                                                                   
 
[/CODE]

[QUOTE]
служба должна быть active (running)
[/QUOTE]

[SIZE=3]Просмотр логов доступа[/SIZE]

[CODE]
tail -f /var/log/squid/access.log                                                        
 
[/CODE]

[QUOTE]
показывает запросы в реальном времени
[/QUOTE]

[SIZE=4]SSH[/SIZE]

[SIZE=3]Установка[/SIZE]

[SIZE=3]Установка пакетов OpenSSH[/SIZE]

[CODE]
sudo apt-get install openssh-server
 
[/CODE]

[QUOTE]
openssh-server(SSH-сервер, включает openssh-common автоматически)
[/QUOTE]

[SIZE=3]Запуск и автозагрузка службы[/SIZE]

[CODE]
sudo systemctl enable --now sshd                                                         
                                                                                              
 
[/CODE]

[SIZE=3]Проверка[/SIZE]

[SIZE=3]Проверка статуса службы[/SIZE]

[CODE]
systemctl status sshd
                                                                                              
 
[/CODE]

[SIZE=3]Проверка прослушиваемого порта[/SIZE]

[CODE]
ss -tulpn | grep ssh                                                                     
                                                                                              
 
[/CODE]

[SIZE=3]Проверка конфигурации[/SIZE]

[CODE]
sshd -t                                                                                  
 
[/CODE]

[QUOTE]
Необязательно, проверяет синтаксис /etc/openssh/sshd_config перед перезапуском
[/QUOTE]

[SIZE=3]Просмотр активных подключений[/SIZE]

[CODE]
who                                                                                      
 
[/CODE]

[QUOTE]
Необязательно, показывает текущие SSH-сессии
[/QUOTE]

[SIZE=3]Просмотр логов SSH[/SIZE]

[CODE]
journalctl -u sshd                                                                       
 
[/CODE]

[QUOTE]
Необязательно, для диагностики проблем подключения
[/QUOTE]

[SIZE=3]Настройка сервера[/SIZE]

[SIZE=3]Основной конфигурационный файл[/SIZE]

[CODE]
/etc/openssh/sshd_config
                                                                                              
 
[/CODE]

[SIZE=3]Настройка /etc/openssh/sshd_config[/SIZE]

[CODE]
Port 22                                                                                  
  PasswordAuthentication yes                                                                  
  PermitRootLogin no                                                                          
  AllowUsers sshuser adminuser                                                                
  MaxAuthTries 3                                                                              
  PubkeyAuthentication yes                                                                    
 
 AuthorizedKeysFile .ssh/authorized_keys                                                     
  Banner /etc/ssh/banner.txt                                                                  
 
[/CODE]

[QUOTE]
Port(обычно 22, изменение необязательно); PasswordAuthentication(yes для начальной настройки, no после настройки ключей); PermitRootLogin no(рекомендуется); AllowUsers(необязательно, белый список); MaxAuthTries(необязательно, обычно 3-6); PubkeyAuthentication yes(обычно включено по умолчанию); AuthorizedKeysFile(стандартное расположение); Banner(необязательно)
[/QUOTE]

[SIZE=3]Создание файла баннера /etc/ssh/banner.txt[/SIZE]

[CODE]
************************************
  - Authorized Access Only          *                                                         
  - All activity is monitored        *                                                        
  ---
 
[/CODE]

[QUOTE]
Необязательно, содержимое баннера произвольное
[/QUOTE]

[SIZE=3]Перезапуск службы после изменений[/SIZE]

[CODE]
sudo systemctl restart sshd                                                              
                                                                                              
 
[/CODE]

[SIZE=3]Настройка аутентификации по ключам[/SIZE]

[SIZE=3]Генерация SSH-ключа на клиенте[/SIZE]

[CODE]
ssh-keygen -t ed25519 -f ~/.ssh/srv_ssh_key
 
[/CODE]

[QUOTE]
-t ed25519(современный стандарт, быстрее и безопаснее RSA); -f(имя файла, по умолчанию id_ed25519)
[/QUOTE]

[SIZE=3]Копирование публичного ключа на сервер[/SIZE]

[CODE]
ssh-copy-id -i ~/.ssh/srv_ssh_key.pub sshuser@192.168.11.67
 
[/CODE]

[QUOTE]
Публичный ключ добавляется в ~/.ssh/authorized_keys на сервере
[/QUOTE]

[SIZE=3]Настройка клиента[/SIZE]

[SIZE=3]Настройка ~/.ssh/config для упрощения подключения[/SIZE]

[CODE]
Host srv-hq  
      HostName 192.168.11.67                                                                  
      User sshuser                                                                            
      IdentityFile ~/.ssh/srv_ssh_key
      Port 22                                                                                 
 
[/CODE]

[QUOTE]
Необязательно, упрощает подключение. Port(указывать только если не 22)
[/QUOTE]

[SIZE=3]Установка прав на config[/SIZE]

[CODE]
chmod 600 ~/.ssh/config                                                                  
                                                                                              
 
[/CODE]

[SIZE=3]Подключение к серверу по псевдониму[/SIZE]

[CODE]
ssh srv-hq                                                                               
 
[/CODE]

[QUOTE]
Работает только при настроенном ~/.ssh/config
[/QUOTE]

[SIZE=3]Подключение к серверу напрямую[/SIZE]

[CODE]
ssh -i ~/.ssh/srv_ssh_key sshuser@192.168.11.67                                          
 
[/CODE]

[QUOTE]
Стандартный способ подключения с указанием ключа, для нестандартного порта использовать -p {8022]
[/QUOTE]

[SIZE=3]Подключение по паролю[/SIZE]

[CODE]
ssh sshuser@192.168.11.67                                                                
 
[/CODE]

[QUOTE]
Работает если PasswordAuthentication yes на сервере
[/QUOTE]

[SIZE=3]Создание пользователя[/SIZE]

[SIZE=3]Создание пользователя[/SIZE]

[CODE]
useradd -u 2026 -m -g users -G wheel sshuser
 
[/CODE]

[QUOTE]
-u(UID, необязательно); -m(создать домашний каталог); -g(основная группа, обычно users); -G wheel(для sudo)
[/QUOTE]

[SIZE=3]Установка пароля[/SIZE]

[CODE]
passwd sshuser
                                                                                              
 
[/CODE]

[SIZE=3]Настройка sudo без пароля[/SIZE]

[CODE]
visudo                                                                                   
 
[/CODE]

[QUOTE]
Добавить: %wheel ALL=(ALL:ALL) NOPASSWD: ALL. Необязательно, обычно sudo требует пароль
[/QUOTE]

[SIZE=3]Проверка sudo[/SIZE]

[CODE]
sudo whoami                                                                              
 
[/CODE]

[QUOTE]
Результат: root
[/QUOTE]

[SIZE=4]strongswan_ipsec[/SIZE]

[SIZE=3]Установка[/SIZE]

[SIZE=3]Установка StrongSwan[/SIZE]

[CODE]
apt-get install strongswan
                                                                                              
 
[/CODE]

[SIZE=3]Настройка первого маршрутизатора[/SIZE]

[SIZE=3]Основной конфигурационный файл[/SIZE]

[CODE]
/etc/strongswan/ipsec.conf
                                                                                              
 
[/CODE]

[SIZE=3]Настройка /etc/strongswan/ipsec.conf на маршрутизаторе 10.10.10.1[/SIZE]

[CODE]
config setup                                                                             
                                                                                              
  conn nameConnect                                                                            
      authby=psk                                                                              
      keyexchange=ikev2                                                                       
                                                                                              
  leftid=10.10.10.1                                                                           
  left=10.10.10.1                                                                             
  leftsubnet=10.10.10.0/30                                                                    
                                                                                              
  rightid=10.10.10.2                                                                          
  right=10.10.10.2                                                                            
  rightsubnet=10.10.10.0/30                                                                   
                                                                                              
  auto=start                                                                                  
 
[/CODE]

[QUOTE]
authby=psk(аутентификация по общему ключу); keyexchange=ikev2(протокол обмена ключами); leftid(публичный идентификатор локального узла); left(локальный IP-адрес); leftsubnet(локальная подсеть); rightid(публичный идентификатор удалённого узла); right(удалённый IP-адрес); rightsubnet(удалённая подсеть); auto=start(автоматический запуск туннеля)
[/QUOTE]

[SIZE=3]Файл с общими ключами[/SIZE]

[CODE]
/etc/strongswan/ipsec.secrets                                                            
                                                                                              
 
[/CODE]

[SIZE=3]Настройка /etc/strongswan/ipsec.secrets на маршрутизаторе 10.10.10.1[/SIZE]

[CODE]
10.10.10.1 10.10.10.2 : PSK "P@ssw0rd"                                                   
 
[/CODE]

[QUOTE]
Формат: локальный_IP удалённый_IP : PSK "пароль"
[/QUOTE]

[SIZE=3]Настройка второго маршрутизатора[/SIZE]

[SIZE=3]Настройка /etc/strongswan/ipsec.conf на маршрутизаторе 10.10.10.2[/SIZE]

[CODE]
config setup 
                                                                                              
  conn nameConnect                                                                            
      authby=psk
      keyexchange=ikev2                                                                       
                                                                                              
  leftid=10.10.10.2                                                                           
  left=10.10.10.2                                                                             
  leftsubnet=10.10.10.0/30                                                                    
                                                                                              
  rightid=10.10.10.1                                                                          
  right=10.10.10.1                                                                            
  rightsubnet=10.10.10.0/30                                                                   
                                                                                              
  auto=start                                                                                  
 
[/CODE]

[QUOTE]
Зеркальная конфигурация: left и right меняются местами
[/QUOTE]

[SIZE=3]Настройка /etc/strongswan/ipsec.secrets на маршрутизаторе 10.10.10.2[/SIZE]

[CODE]
10.10.10.2 10.10.10.1 : PSK "P@ssw0rd"                                                   
 
[/CODE]

[QUOTE]
Тот же пароль, адреса в обратном порядке
[/QUOTE]

[SIZE=3]Запуск[/SIZE]

[SIZE=3]Запуск и автозагрузка службы на обоих маршрутизаторах[/SIZE]

[CODE]
systemctl enable --now strongswan-starter ipsec
                                                                                              
 
[/CODE]

[SIZE=3]Проверка[/SIZE]

[SIZE=3]Проверка статуса туннеля[/SIZE]

[CODE]
ipsec status
 
[/CODE]

[QUOTE]
Показывает состояние IPsec соединений
[/QUOTE]

[SIZE=3]Проверка связности через туннель[/SIZE]

[CODE]
ping 10.10.10.2                                                                          
 
[/CODE]

[QUOTE]
С первого маршрутизатора, с второго ping 10.10.10.1
[/QUOTE]

[SIZE=4]sudo[/SIZE]

[SIZE=3]Установка[/SIZE]

[SIZE=3]Установка sudo[/SIZE]

[CODE]
apt-get install sudo
 
[/CODE]

[QUOTE]
sudo(выполнение команд от имени другого пользователя, обычно root)
[/QUOTE]

[SIZE=3]Создание пользователя[/SIZE]

[SIZE=3]Создание пользователя с параметрами[/SIZE]

[CODE]
useradd -m -g users -G wheel -s /bin/bash username
 
[/CODE]

[QUOTE]
-m(создать домашний каталог); -g(основная группа); -G(дополнительные группы); -s(оболочка по умолчанию /bin/bash)
[/QUOTE]

[SIZE=3]Создание пользователя с указанным UID[/SIZE]

[CODE]
useradd -u 2026 -m -g users -G wheel username
 
[/CODE]

[QUOTE]
-u(указать конкретный UID)
[/QUOTE]

[SIZE=3]Установка пароля пользователю[/SIZE]

[CODE]
passwd username                                                                          
                                                                                              
 
[/CODE]

[SIZE=3]Создание пользователя интерактивно[/SIZE]

[CODE]
adduser username                                                                         
 
[/CODE]

[QUOTE]
Либо интерактивный режим с запросом всех параметров
[/QUOTE]

[SIZE=3]Настройка sudo[/SIZE]

[SIZE=3]Основной конфигурационный файл[/SIZE]

[CODE]
/etc/sudoers 
                                                                                              
 
[/CODE]

[SIZE=3]Редактирование конфигурации sudo[/SIZE]

[CODE]
visudo                                                                                   
 
[/CODE]

[QUOTE]
Безопасное редактирование /etc/sudoers с проверкой синтаксиса
[/QUOTE]

[SIZE=3]Предоставление sudo группе wheel[/SIZE]

[CODE]
%wheel ALL=(ALL:ALL) ALL                                                                 
 
[/CODE]

[QUOTE]
Пользователи группы wheel могут выполнять любые команды через sudo с вводом пароля
[/QUOTE]

[SIZE=3]Предоставление sudo без пароля группе wheel[/SIZE]

[CODE]
%wheel ALL=(ALL:ALL) NOPASSWD: ALL                                                       
 
[/CODE]

[QUOTE]
Пользователи группы wheel могут выполнять sudo без ввода пароля
[/QUOTE]

[SIZE=3]Предоставление sudo конкретному пользователю[/SIZE]

[CODE]
username ALL=(ALL:ALL) ALL                                                               
 
[/CODE]

[QUOTE]
Конкретный пользователь может выполнять любые команды через sudo
[/QUOTE]

[SIZE=3]Предоставление sudo для конкретных команд[/SIZE]

[CODE]
username ALL=(ALL) /usr/bin/systemctl, /usr/bin/apt-get                                  
 
[/CODE]

[QUOTE]
Пользователь может выполнять только указанные команды через sudo
[/QUOTE]

[SIZE=3]Добавление пользователя в группу wheel[/SIZE]

[CODE]
usermod -aG wheel username                                                               
 
[/CODE]

[QUOTE]
-aG(добавить в дополнительные группы, не удаляя из существующих)
[/QUOTE]

[SIZE=3]Управление пользователями[/SIZE]

[SIZE=3]Изменение оболочки пользователя[/SIZE]

[CODE]
usermod -s /bin/bash username
 
[/CODE]

[QUOTE]
-s(изменить оболочку по умолчанию)
[/QUOTE]

[SIZE=3]Изменение домашнего каталога[/SIZE]

[CODE]
usermod -d /home/newdir username                                                         
 
[/CODE]

[QUOTE]
-d(изменить домашний каталог)
[/QUOTE]

[SIZE=3]Блокировка пользователя[/SIZE]

[CODE]
usermod -L username                                                                      
 
[/CODE]

[QUOTE]
-L(заблокировать учётную запись, запретить вход)
[/QUOTE]

[SIZE=3]Разблокировка пользователя[/SIZE]

[CODE]
usermod -U username                                                                      
 
[/CODE]

[QUOTE]
-U(разблокировать учётную запись)
[/QUOTE]

[SIZE=3]Удаление пользователя[/SIZE]

[CODE]
userdel username                                                                         
 
[/CODE]

[QUOTE]
Удаляет пользователя, но сохраняет домашний каталог
[/QUOTE]

[SIZE=3]Удаление пользователя с домашним каталогом[/SIZE]

[CODE]
userdel -r username                                                                      
 
[/CODE]

[QUOTE]
-r(удалить вместе с домашним каталогом)
[/QUOTE]

[SIZE=3]Просмотр групп пользователя[/SIZE]

[CODE]
groups username                                                                          
 
[/CODE]

[QUOTE]
Показывает все группы пользователя
[/QUOTE]

[SIZE=3]Просмотр информации о пользователе[/SIZE]

[CODE]
id username                                                                              
 
[/CODE]

[QUOTE]
Показывает UID, GID и группы пользователя
[/QUOTE]

[SIZE=3]Проверка[/SIZE]

[SIZE=3]Проверка sudo[/SIZE]

[CODE]
sudo whoami  
 
[/CODE]

[QUOTE]
Результат: root
[/QUOTE]

[SIZE=3]Проверка выполнения команды от другого пользователя[/SIZE]

[CODE]
sudo -u username whoami                                                                  
 
[/CODE]

[QUOTE]
-u(выполнить от имени указанного пользователя), результат: username
[/QUOTE]

[SIZE=3]Просмотр прав sudo текущего пользователя[/SIZE]

[CODE]
sudo -l                                                                                  
 
[/CODE]

[QUOTE]
Показывает какие команды может выполнять пользователь через sudo
[/QUOTE]

[SIZE=3]Просмотр истории sudo[/SIZE]

[CODE]
journalctl -u sudo                                                                       
 
[/CODE]

[QUOTE]
Показывает логи выполнения команд через sudo
[/QUOTE]

[SIZE=3]Просмотр всех пользователей системы[/SIZE]

[CODE]
cat /etc/passwd                                                                          
 
[/CODE]

[QUOTE]
Список всех пользователей с их параметрами
[/QUOTE]

[SIZE=3]Просмотр всех групп системы[/SIZE]

[CODE]
cat /etc/group                                                                           
 
[/CODE]

[QUOTE]
Список всех групп и их членов
[/QUOTE]

[SIZE=4]sudo-schema-samba[/SIZE]

[SIZE=3]Установка sudo-samba-schema[/SIZE]

[SIZE=3]Добавление временного репозитория[/SIZE]

[CODE]
echo "rpm http://altrepo.ru/local-p10 noarch local-p10" >>  
  /etc/apt/sources.list                                          
 
[/CODE]

[SIZE=3]Установка пакета[/SIZE]

[CODE]
apt-get install sudo-samba-schema                           
 
[/CODE]

[SIZE=3]Удаление временного репозитория[/SIZE]

[CODE]
sed -i '/altrepo.ru\/local-p10/d' /etc/apt/sources.list     
 
[/CODE]

[SIZE=3]Настройка DNS в /etc/resolv.conf[/SIZE]

[CODE]
nameserver <ip_локального_сервера>                                   
[/CODE]

[QUOTE]
Оставляем только локальный DNS
[/QUOTE]

[SIZE=3]Перезапуск Samba[/SIZE]

[CODE]
systemctl restart samba                                     
 
[/CODE]

[SIZE=3]Настройка схемы sudo в AD[/SIZE]

[SIZE=3]Применение схемы sudo[/SIZE]

[CODE]
sudo-schema-apply                                           
 
[/CODE]

[QUOTE]
Ответить Yes, ввести Administrator и пароль, подтвердить Ok
[/QUOTE]

[SIZE=3]Создание роли sudo[/SIZE]

[CODE]
create-sudo-role                                            
 
[/CODE]

[QUOTE]
Вводим: OU=sudoers,dc=DOMAIN,dc=SAMPLE
[/QUOTE]

[QUOTE]
Имя роли: pravila_hq
[/QUOTE]

[QUOTE]
sudoHost: ALL
[/QUOTE]

[QUOTE]
sudoCommand: /bin/cat
[/QUOTE]

[QUOTE]
sudoUser: %hq
[/QUOTE]

[SIZE=3]Настройка через ADMC[/SIZE]

[SIZE=3]Установка ADMC на клиенте[/SIZE]

[CODE]
apt-get install admc                                        
 
[/CODE]

[SIZE=3]Аутентификация[/SIZE]

[CODE]
kinit administrator                                         
 
[/CODE]

[SIZE=3]Запуск ADMC[/SIZE]

[CODE]
sudo admc                                                   
 
[/CODE]

[SIZE=3]Включение дополнительных возможностей[/SIZE]

[SIZE=4]Настройка правила pravila_hq[/SIZE]
[LIST][*]Настройки → Включить Дополнительные возможности[/LIST]
[LIST][*]domain.sample → sudoers → pravila_hq → Правой кнопкой мыши → Свойства[/LIST]
[LIST][*]Атрибуты → sudoOption → Изменить → Добавить параметр !authenticate → Apply[/LIST]
[LIST][*]Атрибуты → sudoCommand → Изменить → Добавить /bin/grep и /usr/bin/id → Apply[/LIST]

[SIZE=3]Настройка клиента[/SIZE]

[SIZE=3]Установка пакетов[/SIZE]

[CODE]
apt-get install sudo libsss_sudo                            
 
[/CODE]

[SIZE=3]Настройка прав sudo[/SIZE]

[CODE]
control sudo public                                         
 
[/CODE]

[SIZE=3]Настройка SSSD в /etc/sssd/sssd.conf[/SIZE]

[CODE]
[sssd]                                                      
  services = nss, pam, sudo                                      
                                                                 
  [pam]                                                          
                                                                 
  [domain/DOMAIN.SAMPLE]                                          
  sudo_provider = ad
 
[/CODE]

[SIZE=3]Настройка NSS в /etc/nsswitch.conf[/SIZE]

[CODE]
sudoers: files sss                                          
 
[/CODE]

[SIZE=3]Очистка кэша и перезапуск[/SIZE]

[CODE]
rm -rf /var/lib/sss/db/*                                    
  sss_cache -E                                                   
  systemctl restart sssd                                         
 
[/CODE]

[QUOTE]
Можно выполнить reboot вместо очистки кэша
[/QUOTE]

[SIZE=3]Проверка[/SIZE]

[SIZE=3]Вход за пользователя hquser1[/SIZE]

[CODE]
sudo cat /etc/passwd | sudo grep root && sudo id root       
 
[/CODE]

[QUOTE]
Должны выполниться команды без запроса пароля благодаря !authenticate
[/QUOTE]

[SIZE=4]systemd-timesyncd[/SIZE]

[SIZE=3]Установка и настройка systemd-timesyncd[/SIZE]

[SIZE=3]Проверка установки[/SIZE]

[CODE]
systemctl status systemd-timesyncd
 
[/CODE]

[QUOTE]
systemd-timesyncd(встроенный NTP-клиент/сервер systemd, обычно уже установлен)
[/QUOTE]

[SIZE=3]Остановка и отключение chrony[/SIZE]

[CODE]
systemctl stop chronyd
  systemctl disable chronyd
 
[/CODE]

[QUOTE]
systemd-timesyncd и chrony несовместимы на одной машине, работает только один NTP-сервис
[/QUOTE]

[SIZE=3]Настройка NTP-сервера[/SIZE]

[SIZE=3]Основной конфигурационный файл[/SIZE]

[CODE]
/etc/systemd/timesyncd.conf

 
[/CODE]

[SIZE=3]Настройка /etc/systemd/timesyncd.conf для сервера[/SIZE]

[CODE]
[Time]
  NTP=ntp2.vniiftri.ru
  FallbackNTP=0.pool.ntp.org 1.pool.ntp.org
 
[/CODE]

[QUOTE]
NTP(основные NTP-серверы через пробел); FallbackNTP(резервные серверы)
[/QUOTE]

[SIZE=3]Перезапуск службы[/SIZE]

[CODE]
systemctl restart systemd-timesyncd

 
[/CODE]

[SIZE=3]Включение службы[/SIZE]

[CODE]
systemctl enable systemd-timesyncd

 
[/CODE]

[SIZE=3]Разрешение NTP в firewall[/SIZE]

[SIZE=3]Разрешение UDP 123 в iptables[/SIZE]

[CODE]
iptables -A INPUT -p udp --dport 123 -j ACCEPT
  iptables -A OUTPUT -p udp --sport 123 -j ACCEPT
 
[/CODE]

[QUOTE]
UDP порт 123 используется для NTP
[/QUOTE]

[SIZE=3]Разрешение UDP 123 в nftables[/SIZE]

[CODE]
nft add rule inet filter input udp dport 123 accept
  nft add rule inet filter output udp sport 123 accept

 
[/CODE]

[SIZE=3]Проверка NTP-сервера[/SIZE]

[SIZE=3]Проверка статуса синхронизации[/SIZE]

[CODE]
timedatectl status
 
[/CODE]

[QUOTE]
Показывает System clock synchronized, NTP service
[/QUOTE]

[SIZE=3]Проверка статуса службы[/SIZE]

[CODE]
systemctl status systemd-timesyncd

 
[/CODE]

[SIZE=3]Подробная информация о синхронизации[/SIZE]

[CODE]
timedatectl timesync-status
 
[/CODE]

[QUOTE]
Показывает сервер, stratum, задержку, смещение
[/QUOTE]

[SIZE=3]Проверка открытого UDP-порта 123[/SIZE]

[CODE]
ss -ulnp | grep 123

 
[/CODE]

[SIZE=3]Просмотр логов[/SIZE]

[CODE]
journalctl -u systemd-timesyncd

 
[/CODE]

[SIZE=3]Настройка NTP-клиента[/SIZE]

[SIZE=3]Остановка и отключение chrony[/SIZE]

[CODE]
systemctl stop chronyd
  systemctl disable chronyd

 
[/CODE]

[SIZE=3]Настройка /etc/systemd/timesyncd.conf для клиента[/SIZE]

[CODE]
[Time]
  NTP=192.168.11.67
  FallbackNTP=ntp2.vniiftri.ru
 
[/CODE]

[QUOTE]
NTP(локальный NTP-сервер); FallbackNTP(резервный внешний сервер)
[/QUOTE]

[SIZE=3]Перезапуск службы[/SIZE]

[CODE]
systemctl restart systemd-timesyncd

 
[/CODE]

[SIZE=3]Включение службы[/SIZE]

[CODE]
systemctl enable systemd-timesyncd

 
[/CODE]

[SIZE=3]Проверка клиента[/SIZE]

[SIZE=3]Проверка синхронизации[/SIZE]

[CODE]
timedatectl status

 
[/CODE]

[SIZE=3]Подробная информация[/SIZE]

[CODE]
timedatectl timesync-status

 
[/CODE]

[SIZE=3]Включение NTP-синхронизации[/SIZE]

[CODE]
timedatectl set-ntp true
 
[/CODE]

[QUOTE]
Включает автоматическую синхронизацию времени
[/QUOTE]

[SIZE=3]Проверка синхронизации с сервером[/SIZE]

[CODE]
ntpdate -q 192.168.11.67
 
[/CODE]

[QUOTE]
-q(запрос без изменения времени), показывает смещение времени
[/QUOTE]

[SIZE=4]systemd_backup[/SIZE]

[SIZE=3]Настройка службы резервного копирования[/SIZE]

[SIZE=3]Создание директории для резервных копий[/SIZE]

[CODE]
mkdir -p /var/backup
                                                                                              
 
[/CODE]

[SIZE=3]Создание службы /etc/systemd/system/backup.service[/SIZE]

[CODE]
[Unit]                                                                                   
  Description=Backup shared folder to /var/backup                                             
  After=network.target                                                                        
                                                                                              
  [Service]                                                                                   
  Type=oneshot                                                                                
  ExecStart=/bin/bash -c 'tar -czf /var/backup/shared-$(date +%%Y-%%m-%%d-%%H-%%M-%%S).tar.gz 
  /path/to/shared/folder'                                                                     
 
[/CODE]

[QUOTE]
Type=oneshot(служба завершается после выполнения команды); ExecStart(команда создания архива с датой и временем); %%(двойной процент для экранирования в systemd)
[/QUOTE]

[SIZE=3]Создание таймера /etc/systemd/system/backup.timer[/SIZE]

[CODE]
[Unit]       
  Description=Run backup.service daily at 20:00                                               
                                                                                              
  [Timer]                                                                                     
  OnCalendar=20:00                                                                            
  Persistent=true                                                                             
                                                                                              
  [Install]                                                                                   
  WantedBy=timers.target                                                                      
 
[/CODE]

[QUOTE]
OnCalendar=20:00(запуск каждый день в 20:00); Persistent=true(выполнить пропущенную задачу при загрузке, если система была выключена)
[/QUOTE]

[SIZE=3]Запуск[/SIZE]

[SIZE=3]Перезагрузка конфигурации systemd[/SIZE]

[CODE]
systemctl daemon-reload
 
[/CODE]

[QUOTE]
Применяет изменения после создания или редактирования unit-файлов
[/QUOTE]

[SIZE=3]Включение и запуск таймера[/SIZE]

[CODE]
systemctl enable --now backup.timer                                                      
                                                                                              
 
[/CODE]

[SIZE=3]Проверка[/SIZE]

[SIZE=3]Просмотр активных таймеров[/SIZE]

[CODE]
systemctl list-timers
 
[/CODE]

[QUOTE]
Показывает все таймеры, время следующего запуска и последнего выполнения
[/QUOTE]

[SIZE=3]Проверка статуса таймера[/SIZE]

[CODE]
systemctl status backup.timer                                                            
                                                                                              
 
[/CODE]

[SIZE=3]Проверка статуса службы[/SIZE]

[CODE]
systemctl status backup.service                                                          
                                                                                              
 
[/CODE]

[SIZE=3]Ручной запуск службы резервного копирования[/SIZE]

[CODE]
systemctl start backup.service                                                           
 
[/CODE]

[QUOTE]
Для проверки работы службы без ожидания таймера
[/QUOTE]

[SIZE=3]Просмотр созданных архивов[/SIZE]

[CODE]
ls -lh /var/backup                                                                       
 
[/CODE]

[QUOTE]
-lh(список с размерами в читаемом формате)
[/QUOTE]

[SIZE=3]Просмотр логов службы[/SIZE]

[CODE]
journalctl -u backup.service                                                             
 
[/CODE]

[QUOTE]
Показывает логи выполнения резервного копирования
[/QUOTE]

[SIZE=3]Просмотр логов таймера[/SIZE]

[CODE]
journalctl -u backup.timer                                                               
                                                                                              
 
[/CODE]

[SIZE=4]Дополнительные варианты OnCalendar[/SIZE]
[LIST][*]OnCalendar=daily (каждый день в 00:00)[/LIST]
[LIST][*]OnCalendar=weekly (каждую неделю в понедельник 00:00)[/LIST]
[LIST][*]OnCalendar=--* 02:00:00 (каждый день в 02:00)[/LIST]
[LIST][*]OnCalendar=Mon,Fri 18:00 (понедельник и пятница в 18:00)[/LIST]
[LIST][*]OnCalendar=*:0/15 (каждые 15 минут)[/LIST]
[LIST][*]OnCalendar=hourly (каждый час)[/LIST]

[SIZE=4]timedatectl[/SIZE]

[SIZE=3]Управление временем через timedatectl[/SIZE]

[SIZE=3]Просмотр текущего времени и настроек[/SIZE]

[CODE]
timedatectl  
 
[/CODE]

[QUOTE]
Показывает локальное время, UTC, часовой пояс, синхронизацию NTP
[/QUOTE]

[SIZE=3]Просмотр статуса синхронизации времени[/SIZE]

[CODE]
timedatectl status                                                           
 
[/CODE]

[QUOTE]
Показывает полную информацию
[/QUOTE]

[SIZE=3]Настройка времени[/SIZE]

[SIZE=3]Установка текущей даты и времени[/SIZE]

[CODE]
timedatectl set-time "2026-05-31 10:30:00"
 
[/CODE]

[QUOTE]
Формат: YYYY-MM-DD HH:MM:SS
[/QUOTE]

[SIZE=3]Установка только даты[/SIZE]

[CODE]
timedatectl set-time "2026-05-31"                                            
                                                                                  
 
[/CODE]

[SIZE=3]Установка только времени[/SIZE]

[CODE]
timedatectl set-time "10:30:00"                                              
                                                                                  
 
[/CODE]

[SIZE=3]Настройка часового пояса[/SIZE]

[SIZE=3]Просмотр текущего часового пояса[/SIZE]

[CODE]
timedatectl show-timezones
 
[/CODE]

[QUOTE]
Показывает список всех доступных часовых поясов
[/QUOTE]

[SIZE=3]Поиск часового пояса[/SIZE]

[CODE]
timedatectl list-timezones | grep Moscow                                     
                                                                                  
 
[/CODE]

[SIZE=3]Установка часового пояса[/SIZE]

[CODE]
timedatectl set-timezone Europe/Moscow                                       
 
[/CODE]

[QUOTE]
Часовой пояс Москвы
[/QUOTE]

[SIZE=3]Установка UTC[/SIZE]

[CODE]
timedatectl set-timezone UTC                                                 
                                                                                  
 
[/CODE]

[SIZE=3]Настройка NTP-синхронизации[/SIZE]

[SIZE=3]Включение NTP-синхронизации[/SIZE]

[CODE]
timedatectl set-ntp true
 
[/CODE]

[QUOTE]
Включает автоматическую синхронизацию времени через systemd-timesyncd
[/QUOTE]

[SIZE=3]Отключение NTP-синхронизации[/SIZE]

[CODE]
timedatectl set-ntp false                                                    
 
[/CODE]

[QUOTE]
Отключает автоматическую синхронизацию, позволяет устанавливать время вручную
[/QUOTE]

[SIZE=3]Проверка статуса NTP-синхронизации[/SIZE]

[CODE]
timedatectl timesync-status                                                  
 
[/CODE]

[QUOTE]
Показывает сервер, stratum, задержку, смещение времени
[/QUOTE]

[SIZE=3]Настройка аппаратных часов[/SIZE]

[SIZE=3]Синхронизация системного времени с аппаратными часами[/SIZE]

[CODE]
hwclock --systohc
 
[/CODE]

[QUOTE]
Записывает системное время в аппаратные часы (RTC)
[/QUOTE]

[SIZE=3]Синхронизация аппаратных часов с системным временем[/SIZE]

[CODE]
hwclock --hctosys                                                            
 
[/CODE]

[QUOTE]
Устанавливает системное время из аппаратных часов
[/QUOTE]

[SIZE=3]Просмотр аппаратных часов[/SIZE]

[CODE]
hwclock --show                                                               
 
[/CODE]

[QUOTE]
Показывает время из RTC
[/QUOTE]

[SIZE=3]Установка аппаратных часов в UTC[/SIZE]

[CODE]
timedatectl set-local-rtc 0                                                  
 
[/CODE]

[QUOTE]
0(RTC в UTC), рекомендуется для Linux
[/QUOTE]

[SIZE=3]Установка аппаратных часов в локальное время[/SIZE]

[CODE]
timedatectl set-local-rtc 1                                                  
 
[/CODE]

[QUOTE]
1(RTC в локальном времени), используется для совместимости с Windows
[/QUOTE]

[SIZE=3]Проверка[/SIZE]

[SIZE=3]Просмотр всех свойств[/SIZE]

[CODE]
timedatectl show
 
[/CODE]

[QUOTE]
Показывает все параметры в формате ключ=значение
[/QUOTE]

[SIZE=3]Просмотр конкретного свойства[/SIZE]

[CODE]
timedatectl show -p Timezone                                                 
 
[/CODE]

[QUOTE]
-p(конкретное свойство): Timezone, NTPSynchronized, LocalRTC
[/QUOTE]

[SIZE=3]Просмотр логов службы времени[/SIZE]

[CODE]
journalctl -u systemd-timesyncd                                              
                                                                                  
 
[/CODE]

[SIZE=4]Примеры часовых поясов[/SIZE]
[LIST][*]Europe/Moscow (Москва, UTC+3)[/LIST]
[LIST][*]Asia/Yekaterinburg (Екатеринбург, UTC+5)[/LIST]
[LIST][*]Asia/Novosibirsk (Новосибирск, UTC+7)[/LIST]
[LIST][*]Asia/Vladivostok (Владивосток, UTC+10)[/LIST]
[LIST][*]UTC (Всемирное координированное время)[/LIST]

[SIZE=4]wireguard[/SIZE]

[SIZE=3]Установка WireGuard[/SIZE]

[SIZE=3]Установка пакетов[/SIZE]

[CODE]
apt-get update && apt-get install -y wireguard-tools wireguard-tools-wg-quick
 
[/CODE]

[QUOTE]
wireguard-tools(утилиты для управления WireGuard); wireguard-tools-wg-quick(утилита wg-quick для быстрой настройки)
[/QUOTE]

[SIZE=3]Настройка сервера FW-L[/SIZE]

[SIZE=3]Создание директории для ключей[/SIZE]

[CODE]
mkdir -p /etc/wireguard/keys
                                                                                  
 
[/CODE]

[SIZE=3]Генерация ключей сервера и клиента[/SIZE]

[CODE]
cd /etc/wireguard/keys                                                       
  wg genkey | tee srv-sec.key | wg pubkey > srv-pub.key                           
  wg genkey | tee cli-sec.key | wg pubkey > cli-pub.key                           
 
[/CODE]

[QUOTE]
wg genkey(генерация приватного ключа); wg pubkey(генерация публичного ключа из приватного); srv-sec.key(приватный ключ сервера); srv-pub.key(публичный ключ сервера); cli-sec.key(приватный ключ клиента); cli-pub.key(публичный ключ клиента)
[/QUOTE]

[SIZE=3]Создание конфигурационного файла /etc/wireguard/wg0.conf[/SIZE]

[CODE]
[Interface]
  Address = 10.20.30.1/30                                                         
  ListenPort = 51820                                                              
  PrivateKey = <содержимое srv-sec.key>                                           
                                                                                  
  [Peer]                                                                          
  PublicKey = <содержимое cli-pub.key>                                            
  AllowedIPs = 10.20.30.2/32, 172.16.100.0/24                                     
 
[/CODE]

[QUOTE]
[Interface](настройки сервера); Address(адрес в VPN-сети); ListenPort(порт сервера, обычно 51820); PrivateKey(приватный ключ сервера); [Peer](настройки клиента); PublicKey(публичный ключ клиента); AllowedIPs(разрешённые маршруты от клиента)
[/QUOTE]

[SIZE=3]Включение и автозагрузка туннельного интерфейса[/SIZE]

[CODE]
systemctl enable --now wg-quick@wg0
                                                                                  
 
[/CODE]

[SIZE=3]Настройка клиента FW-R[/SIZE]

[SIZE=3]Создание директории для ключей[/SIZE]

[CODE]
mkdir -p /etc/wireguard/keys
                                                                                  
 
[/CODE]

[SIZE=3]Копирование ключей с сервера[/SIZE]

[CODE]
cd /etc/wireguard/keys
  scp root@4.4.4.2:/etc/wireguard/keys/cli-sec.key ./                             
  scp root@4.4.4.2:/etc/wireguard/keys/srv-pub.key ./                             
 
[/CODE]

[QUOTE]
Копируем приватный ключ клиента и публичный ключ сервера
[/QUOTE]

[SIZE=3]Создание конфигурационного файла /etc/wireguard/wg0.conf[/SIZE]

[CODE]
[Interface]                                                                  
  Address = 10.20.30.2/30                                                         
  PrivateKey = <содержимое cli-sec.key>                                           
                                                                                  
  [Peer]                                                                          
  PublicKey = <содержимое srv-pub.key>                                            
  Endpoint = 4.4.4.2:51820                                                        
  AllowedIPs = 10.20.30.1/32, 192.168.100.0/24                                    
  PersistentKeepalive = 25                                                        
 
[/CODE]

[QUOTE]
Endpoint(адрес и порт сервера); AllowedIPs(разрешённые маршруты к серверу); PersistentKeepalive(интервал проверки соединения в секундах, обычно 25)
[/QUOTE]

[SIZE=3]Включение и автозагрузка туннельного интерфейса[/SIZE]

[CODE]
systemctl enable --now wg-quick@wg0
                                                                                  
 
[/CODE]

[SIZE=3]Разрешение WireGuard в firewall[/SIZE]

[SIZE=3]Разрешение UDP 51820 в iptables на сервере[/SIZE]

[CODE]
iptables -A INPUT -p udp --dport 51820 -j ACCEPT
 
[/CODE]

[QUOTE]
UDP порт 51820 используется для WireGuard
[/QUOTE]

[SIZE=3]Разрешение UDP 51820 в nftables на сервере[/SIZE]

[CODE]
nft add rule inet filter input udp dport 51820 accept                        
                                                                                  
 
[/CODE]

[SIZE=3]Проверка[/SIZE]

[SIZE=3]Проверка статуса туннеля[/SIZE]

[CODE]
wg show wg0  
 
[/CODE]

[QUOTE]
Показывает информацию о туннеле, пиры, передачу данных
[/QUOTE]

[SIZE=3]Проверка интерфейса wg0[/SIZE]

[CODE]
ip -c a | grep wg0                                                           
                                                                                  
 
[/CODE]

[SIZE=3]Проверка статуса службы[/SIZE]

[CODE]
systemctl status wg-quick@wg0                                                
                                                                                  
 
[/CODE]

[SIZE=3]Проверка связности через туннель[/SIZE]

[CODE]
ping 10.20.30.2                                                              
 
[/CODE]

[QUOTE]
С сервера пинг клиента, с клиента ping 10.20.30.1
[/QUOTE]

[SIZE=3]Проверка связности из LAN LEFT в LAN RIGHT[/SIZE]

[CODE]
ping 172.16.100.10                                                           
 
[/CODE]

[QUOTE]
С машины в сети 192.168.100.0/24 пинг в сеть 172.16.100.0/24
[/QUOTE]

[SIZE=3]Управление туннелем[/SIZE]

[SIZE=3]Остановка туннеля[/SIZE]

[CODE]
systemctl stop wg-quick@wg0
                                                                                  
 
[/CODE]

[SIZE=3]Запуск туннеля[/SIZE]

[CODE]
systemctl start wg-quick@wg0                                                 
                                                                                  
 
[/CODE]

[SIZE=3]Перезапуск туннеля[/SIZE]

[CODE]
systemctl restart wg-quick@wg0                                               
                                                                                  
 
[/CODE]

[SIZE=3]Ручное поднятие интерфейса[/SIZE]

[CODE]
wg-quick up wg0                                                              
                                                                                  
 
[/CODE]

[SIZE=3]Ручное отключение интерфейса[/SIZE]

[CODE]
wg-quick down wg0                                                            
                                                                                  
 
[/CODE]

[SIZE=3]Настройка динамической маршрутизации OSPF[/SIZE]

[SIZE=3]Установка FRR на обоих серверах[/SIZE]

[CODE]
apt-get install -y frr
 
[/CODE]

[QUOTE]
FRR(Free Range Routing, пакет для динамической маршрутизации OSPF, BGP)
[/QUOTE]

[SIZE=3]Изменение конфигурации WireGuard на сервере[/SIZE]

[CODE]
[Interface]                                                                  
  Address = 10.20.30.1/30                                                         
  ListenPort = 51820                                                              
  PrivateKey = <содержимое srv-sec.key>                                           
  Table = off                                                                     
                                                                                  
  [Peer]                                                                          
  PublicKey = <содержимое cli-pub.key>
  AllowedIPs = 10.20.30.2/32                                                      
 
[/CODE]

[QUOTE]
Table = off(отключить автоматическое управление маршрутами, маршруты будут управляться через OSPF); AllowedIPs(только адрес клиента, без сетей)
[/QUOTE]

[SIZE=3]Изменение конфигурации WireGuard на клиенте[/SIZE]

[CODE]
[Interface]  
  Address = 10.20.30.2/30                                                         
  PrivateKey = <содержимое cli-sec.key>                                           
  Table = off                                                                     
                                                                                  
  [Peer]                                                                          
  PublicKey = <содержимое srv-pub.key>                                            
  Endpoint = 4.4.4.2:51820                                                        
  AllowedIPs = 10.20.30.1/32                                                      
  PersistentKeepalive = 25                                                        
                                                                                  
 
[/CODE]

[SIZE=3]Перезапуск туннеля на обоих серверах[/SIZE]

[CODE]
systemctl restart wg-quick@wg0                                               
                                                                                  
 
[/CODE]

[SIZE=3]Включение демона OSPF на обоих серверах[/SIZE]

[CODE]
sed -i 's/ospfd=no/ospfd=yes/g' /etc/frr/daemons                             
                                                                                  
 
[/CODE]

[SIZE=3]Запуск и автозагрузка FRR на обоих серверах[/SIZE]

[CODE]
systemctl enable --now frr                                                   
                                                                                  
 
[/CODE]

[SIZE=3]Настройка OSPF на сервере FW-L[/SIZE]

[CODE]
vtysh                                                                        
  configure terminal                                                              
  router ospf     
  passive-interface default                                                       
  network 10.20.30.0/30 area 0
  network 192.168.100.0/24 area 0                                                 
  exit                                                                            
  interface wg0                                                                   
  no ip ospf passive                                                              
  exit                                                                            
  end                                                                             
  wr mem                                                                          
 
[/CODE]

[QUOTE]
vtysh(интерактивная оболочка FRR); router ospf(включить OSPF); passive-interface default(все интерфейсы пассивные по умолчанию); network(объявить сети в OSPF area 0); no ip ospf passive(сделать wg0 активным для OSPF); wr mem(сохранить конфигурацию)
[/QUOTE]

[SIZE=3]Настройка OSPF на клиенте FW-R[/SIZE]

[CODE]
vtysh
  configure terminal                                                              
  router ospf                                                                     
  passive-interface default
  network 10.20.30.0/30 area 0                                                    
  network 172.16.100.0/24 area 0                                                  
  exit                                                                            
  interface wg0                                                                   
  no ip ospf passive                                                              
  exit            
  end                                                                             
  wr mem          
                                                                                  
 
[/CODE]

[SIZE=3]Проверка OSPF соседей[/SIZE]

[CODE]
vtysh -c "show ip ospf neighbor"                                             
 
[/CODE]

[QUOTE]
Должен показать соседа в состоянии Full
[/QUOTE]

[SIZE=3]Проверка маршрутов OSPF[/SIZE]

[CODE]
ip -c r | grep ospf                                                          
 
[/CODE]

[QUOTE]
Показывает маршруты, полученные через OSPF
[/QUOTE]

[SIZE=3]Проверка таблицы маршрутизации OSPF[/SIZE]

[CODE]
vtysh -c "show ip route ospf"                                                
                                                                                  
 
[/CODE]

[SIZE=3]Проверка статуса OSPF[/SIZE]

[CODE]
vtysh -c "show ip ospf"                                                      
                  
 
[/CODE]

[SIZE=3]Проверка интерфейсов OSPF[/SIZE]

[CODE]
vtysh -c "show ip ospf interface"
[/CODE]

[SIZE=4]Zabbix_agent[/SIZE]

[SIZE=3]Установка[/SIZE]

[SIZE=3]Установка пакета на клиенте[/SIZE]

[CODE]
apt-get install zabbix-agent                                                             
   
 
[/CODE]

[SIZE=3]Настройка[/SIZE]

[SIZE=3]Настройка в /etc/zabbix/zabbix_agentd.conf[/SIZE]

[CODE]
Server=IP_ZABBIX_SERVER
  ServerActive=IP_ZABBIX_SERVER
  Hostname=HOST_CLIENT
 
[/CODE]

[QUOTE]
Server(IP или hostname сервера); ServerActive(IP для активных проверок); Hostname(имя хоста как в веб-интерфейсе)
[/QUOTE]

[SIZE=3]Перезапуск и включение службы[/SIZE]

[CODE]
systemctl restart zabbix-agentd
  systemctl enable zabbix-agentd                                                              
                                                                                              
 
[/CODE]

[SIZE=3]Добавление хоста в веб-интерфейсе[/SIZE]

[SIZE=4]Действия[/SIZE]
[LIST][*]Monitoring -> Hosts[/LIST]
[LIST][*]Create host[/LIST]
[LIST][*]Host name: указать как в zabbix_agentd.conf[/LIST]
[LIST][*]Templates: в поиске найти Linux by Zabbix agent[/LIST]
[LIST][*]Host groups: выбрать Discovered hosts[/LIST]
[LIST][*]Add interface: Agent[/LIST]
[LIST][LIST][*]IP address: IP-адрес агента[/LIST][/LIST]
[LIST][LIST][*]Port: 10050[/LIST][/LIST]
[LIST][*]Сохранить[/LIST]

[QUOTE]
После добавления хост можно добавить в Dashboards для мониторинга
[/QUOTE]

[SIZE=4]Zabbix_web-interface[/SIZE]

[SIZE=3]Установка пакетов[/SIZE]

[CODE]
apt-get install zabbix-phpfrontend-apache2 zabbix-phpfrontend-php8.2                     
 
[/CODE]

[QUOTE]
zabbix-phpfrontend-apache2(веб-интерфейс для Apache2); zabbix-phpfrontend-php8.2(поддержка PHP 8.2)
[/QUOTE]

[SIZE=3]Включение конфигурации Apache2[/SIZE]

[CODE]
ln -s /etc/httpd2/conf/addon.d/A.zabbix.conf /etc/httpd2/conf/extra-enabled/
 
[/CODE]

[QUOTE]
создает символическую ссылку для активации конфигурации Zabbix
[/QUOTE]

[SIZE=3]Перезапуск Apache2[/SIZE]

[CODE]
systemctl restart httpd2                                                                 
                                                                                              
 
[/CODE]

[SIZE=3]Изменение владельца для веб-установщика[/SIZE]

[CODE]
chown apache2:apache2 /var/www/webapps/zabbix/ui/conf                                    
 
[/CODE]

[QUOTE]
необходимо для записи конфигурации при установке
[/QUOTE]

[SIZE=3]Настройка через веб-интерфейс[/SIZE]

[SIZE=3]Открытие веб-установщика[/SIZE]

[CODE]
http://<ip сервера>/zabbix
 
[/CODE]

[QUOTE]
открыть в браузере
[/QUOTE]

[SIZE=4]Параметры подключения к базе данных[/SIZE]
[LIST][*]type database: PostgreSQL{MySQL}[/LIST]
[LIST][*]host: localhost[/LIST]
[LIST][*]port: 0[/LIST]
[LIST][*]name: zabbix[/LIST]
[LIST][*]scheme: public[/LIST]
[LIST][*]user: zabbix[/LIST]
[LIST][*]password: zabbixpwd[/LIST]

[QUOTE]
port 0(автоматически использует порт по умолчанию: PostgreSQL 5432, MySQL 3306); scheme(схема базы данных)
[/QUOTE]

[SIZE=3]Проверка[/SIZE]

[SIZE=3]Вход в веб-интерфейс[/SIZE]

[CODE]
http://<ip сервера>/zabbix

 
[/CODE]

[QUOTE]
открыть страницу входа
[/QUOTE]

[SIZE=3]Учетные данные по умолчанию[/SIZE]

[CODE]
username: Admin                                                                          
  password: zabbix                                                                            
 
[/CODE]

[QUOTE]
Admin с заглавной буквы; рекомендуется сменить пароль после первого входа
[/QUOTE]

[SIZE=3]Проверка статуса Apache2[/SIZE]

[CODE]
systemctl status httpd2                                                                  
 
[/CODE]

[QUOTE]
служба должна быть active (running)
[/QUOTE]

[SIZE=3]Проверка прав на каталог конфигурации[/SIZE]

[CODE]
ls -la /var/www/webapps/zabbix/ui/conf
[/CODE]
