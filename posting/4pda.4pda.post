[CODE]
vmware-toolbox-cmd -v                                                        
                                                                                  
 
[/CODE]

[SIZE=3]Проверка работы буфера обмена[/SIZE]

[CODE]
vmware-toolbox-cmd stat clipboard                                            
                                                                                  
 
[/CODE]

[SIZE=3]Проверка синхронизации времени[/SIZE]

