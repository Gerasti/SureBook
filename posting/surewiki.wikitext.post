</syntaxhighlight>

=== RADIUS ===

==== Установка RADIUS сервера ====

==== Установка пакетов ====

<syntaxhighlight lang="bash">
apt-get update && apt-get install -y freeradius freeradius-utils                         
</syntaxhighlight>

==== Запуск службы ====

<syntaxhighlight lang="bash">
systemctl enable --now radiusd                                                           

</syntaxhighlight>

==== Настройка RADIUS сервера ====

==== В /etc/raddb/clients.conf ====

<syntaxhighlight lang="bash">
client ALL {                                                                             
ipaddr = 0.0.0.0
netmask = 0                                                                               
secret = P@ssw0rd                                                                         
}                                                                                           
</syntaxhighlight>

<blockquote>
ipaddr(IP клиента); netmask(маска сети); secret(общий секрет)
</blockquote>

==== В конец /etc/raddb/users ====

<syntaxhighlight lang="bash">
netuser Cleartext-Password := "P@ssw0rd"                                                 
Service-Type = Administrative-User,                                                 
Cisco-AVPair = "shell:roles=admin"                                                  
</syntaxhighlight>

<blockquote>
Cleartext-Password(пароль пользователя); Service-Type(тип доступа); Cisco-AVPair(роль для Cisco)
</blockquote>

==== Перезапуск службы ====

<syntaxhighlight lang="bash">
systemctl restart radiusd

</syntaxhighlight>

==== Проверка RADIUS сервера ====

==== Проверка статуса службы ====

<syntaxhighlight lang="bash">
systemctl status radiusd                                                                 
</syntaxhighlight>

<blockquote>
служба должна быть active (running)
</blockquote>

==== Тестирование аутентификации ====

<syntaxhighlight lang="bash">
radtest netuser P@ssw0rd localhost 0 P@ssw0rd                                            
</syntaxhighlight>

<blockquote>
должен вернуть Access-Accept
</blockquote>

==== Установка RADIUS клиента ====

==== Установка пакетов ====

<syntaxhighlight lang="bash">
apt-get update && apt-get install -y pam_radius                                          
</syntaxhighlight>

==== В /etc/pam_radius_auth.conf ====

<syntaxhighlight lang="bash">
<ip сервера> P@ssw0rd 3                                                                  
</syntaxhighlight>

<blockquote>
формат: IP секрет таймаут
</blockquote>

==== В /etc/pam.d/sshd и /etc/pam.d/system-auth-local ====

<syntaxhighlight lang="bash">
auth  sufficient  pam_radius_auth.so                                                     
</syntaxhighlight>

<blockquote>
sufficient(достаточно для авторизации); pam_radius_auth.so(модуль RADIUS)
</blockquote>

==== Создание пользователя ====

<syntaxhighlight lang="bash">
useradd netuser                                                                          
</syntaxhighlight>

<blockquote>
пользователь должен совпадать с настроенным на сервере
</blockquote>

==== Проверка RADIUS клиента ====

==== Проверка подключения через SSH ====

<syntaxhighlight lang="bash">
ssh netuser@<ip клиента>                                                                 
</syntaxhighlight>

<blockquote>
вход должен пройти с паролем P@ssw0rd через RADIUS-сервер
</blockquote>

=== replication_postgresql-server ===

==== Установка PostgreSQL на резервном сервере ====

==== На SRV-BR установка пакетов ====

<syntaxhighlight lang="bash">
apt-get install -y postgresql16 postgresql16-server postgresql16-contrib                 
</syntaxhighlight>

<blockquote>
SRV-BR(резервный сервер); SRV-HQ(основной сервер)
</blockquote>

==== Настройка основного сервера ====

==== На SRV-HQ в /var/lib/pgsql/data/postgresql.conf ====

<syntaxhighlight lang="bash">
wal_level = replica                                                                      
max_wal_senders = 2                                                                         
max_replication_slots = 2                                                                   
hot_standby = on                                                                            
hot_standby_feedback = on                                                                   
</syntaxhighlight>

<blockquote>
wal_level(уровень журналирования); max_wal_senders(количество процессов репликации); hot_standby(чтение на реплике)
</blockquote>

==== Перезапуск службы на SRV-HQ ====

<syntaxhighlight lang="bash">
systemctl restart postgresql

</syntaxhighlight>

==== Настройка репликации на резервном сервере ====

==== На SRV-BR остановка службы ====

<syntaxhighlight lang="bash">
systemctl stop postgresql                                                                

</syntaxhighlight>

==== Очистка директории данных ====

<syntaxhighlight lang="bash">
rm -rf /var/lib/pgsql/data/*                                                             
</syntaxhighlight>

<blockquote>
удаляет существующие данные для создания реплики
</blockquote>

==== Создание базовой копии с SRV-HQ ====

<syntaxhighlight lang="bash">
pg_basebackup -h 192.168.11.67 -U postgres -D /var/lib/pgsql/data --wal-method=stream    
--write-recovery-conf                                                                       
</syntaxhighlight>

<blockquote>
-h(IP основного сервера); -U(пользователь); -D(директория данных); --wal-method(метод передачи WAL); --write-recovery-conf(создание конфига репликации)
</blockquote>

==== Установка прав доступа ====

<syntaxhighlight lang="bash">
chown -R postgres:postgres /var/lib/pgsql/data/

</syntaxhighlight>

==== Запуск службы на SRV-BR ====

<syntaxhighlight lang="bash">
systemctl start postgresql                                                               

</syntaxhighlight>

==== Проверка репликации ====

==== Подключение к базе данных ====

<syntaxhighlight lang="bash">
psql -U postgres                                                                         
</syntaxhighlight>

<blockquote>
подключение к PostgreSQL
</blockquote>

==== Проверка статуса репликации на SRV-HQ ====

<syntaxhighlight lang="bash">
SELECT * FROM pg_stat_replication;                                                       
</syntaxhighlight>

<blockquote>
показывает подключенные реплики
</blockquote>

==== Проверка данных на SRV-BR ====

<syntaxhighlight lang="bash">
\c one                                                                                   
\dt+                                                                                        
</syntaxhighlight>

<blockquote>
\c(подключение к БД); \dt+(список таблиц с размерами)
</blockquote>

=== resolve_options ===

==== Настройка ====

==== Просмотр текущей конфигурации ====

<syntaxhighlight lang="bash">
cat /etc/resolv.conf                                                                     
</syntaxhighlight>

<blockquote>
показывает текущие DNS-серверы
</blockquote>

==== Добавление одного DNS-сервера ====

<syntaxhighlight lang="bash">
echo "nameserver 77.88.8.8" > /etc/resolv.conf                                           
</syntaxhighlight>

<blockquote>
перезаписывает файл; 77.88.8.8(Яндекс DNS)
</blockquote>

==== Добавление нескольких DNS-серверов ====

<syntaxhighlight lang="bash">
echo "nameserver 77.88.8.8" > /etc/resolv.conf                                           
echo "nameserver 8.8.8.8" >> /etc/resolv.conf                                               
</syntaxhighlight>

<blockquote>
добавляет в конец файла; 8.8.8.8(Google DNS)
</blockquote>

==== Настройка с доменом поиска ====

<syntaxhighlight lang="bash">
nameserver 192.168.1.1                                                                   
search example.local                                                                        
domain example.local                                                                        
</syntaxhighlight>

<blockquote>
search(список доменов для поиска); domain(локальный домен)
</blockquote>

==== Настройка с опциями ====

<syntaxhighlight lang="bash">
nameserver 77.88.8.8                                                                     
options timeout:2 attempts:3 rotate                                                         
</syntaxhighlight>

<blockquote>
timeout(таймаут запроса в секундах); attempts(количество попыток); rotate(чередование серверов)
</blockquote>

==== Проверка DNS ====

==== Проверка разрешения имен ====

<syntaxhighlight lang="bash">
nslookup ya.ru
</syntaxhighlight>

<blockquote>
должен вернуть IP-адрес
</blockquote>

==== Проверка через dig(bind-utils) ====

<syntaxhighlight lang="bash">
dig ya.ru                                                                                
</syntaxhighlight>

<blockquote>
показывает подробную информацию о DNS-запросе
</blockquote>

==== Проверка через host ====

<syntaxhighlight lang="bash">
host ya.ru                                                                               
</syntaxhighlight>

<blockquote>
простая проверка разрешения имени
</blockquote>

=== rsyslog ===

==== Установка ====

==== Установка пакетов на всех устройствах ====

<syntaxhighlight lang="bash">
apt-get install rsyslog logrotate                                                        
</syntaxhighlight>

<blockquote>
rsyslog(сбор и пересылка логов); logrotate(ротация и сжатие логов)
</blockquote>

<blockquote>
Обычно работают в связке
</blockquote>

==== Настройка сервера сбора логов ====

==== В /etc/rsyslog.conf ====

<syntaxhighlight lang="bash">
module(load="imuxsock")                                                                  
module(load="imklog")                                                                       
module(load="imudp")                                                                        
input(type="imudp" port="514")                                                              
module(load="imtcp")                                                                        
input(type="imtcp" port="514")                                                              

$template RemoteLogs, "/opt/%HOSTNAME%/%PROGRAMNAME%.log"                                   

if ($fromhost-ip != "127.0.0.1" and $syslogseverity <= 4) then ?RemoteLogs                  
& stop          
</syntaxhighlight>

<blockquote>
imuxsock(локальные сообщения); imklog(логи ядра); imudp/imtcp(приём по UDP/TCP); $syslogseverity <= 4(warning и выше); & stop(остановка обработки)
</blockquote>

==== Создание каталогов для логов ====

<syntaxhighlight lang="bash">
mkdir -p /opt/client1
mkdir -p /opt/client2                                                                       
mkdir -p /opt/client3                                                                       
</syntaxhighlight>

<blockquote>
создаются каталоги для каждого клиента
</blockquote>

==== Установка прав на каталоги ====

<syntaxhighlight lang="bash">
chown -R root:root /opt                                                                  
chmod -R 755 /opt                                                                           
</syntaxhighlight>

<blockquote>
права для записи логов службой rsyslog
</blockquote>

==== Перезапуск службы на сервере ====

<syntaxhighlight lang="bash">
systemctl restart rsyslog                                                                

</syntaxhighlight>

==== Настройка клиента ====

==== В /etc/rsyslog.conf на клиенте ====

<syntaxhighlight lang="bash">
*.warning action(type="omfwd"                                                            
target="<HQ-SRV_IP>"                                                                    
port="514"                                                                              
protocol="tcp"                                                                          
action.resumeRetryCount="-1"                                                            
queue.type="linkedList"                                                                 
queue.size="10000")                                                                     
</syntaxhighlight>

<blockquote>
*.warning(уровень warning и выше); target(IP сервера логов); protocol(tcp для надежности); resumeRetryCount=-1(бесконечные попытки); queue.size(размер очереди сообщений)
</blockquote>

==== Перезапуск службы на клиенте ====

<syntaxhighlight lang="bash">
systemctl restart rsyslog

</syntaxhighlight>

==== Проверка ====

==== Проверка открытого порта на сервере ====

<syntaxhighlight lang="bash">
ss -tulpn | grep 514                                                                     
</syntaxhighlight>

<blockquote>
должен показать порты 514 TCP и UDP
</blockquote>

==== Проверка каталогов логов на сервере ====

<syntaxhighlight lang="bash">
ls -la /opt/                                                                             
</syntaxhighlight>

<blockquote>
должны появиться каталоги с именами клиентов
</blockquote>

==== Проверка содержимого логов ====

<syntaxhighlight lang="bash">
ls -la /opt/client1/                                                                     
</syntaxhighlight>

<blockquote>
должны появиться файлы логов от клиента
</blockquote>

==== Тестовая отправка сообщения с клиента ====

<syntaxhighlight lang="bash">
logger -p user.warning "Test message from client"                                        
</syntaxhighlight>

<blockquote>
отправляет тестовое сообщение уровня warning
</blockquote>

==== Проверка получения на сервере ====

<syntaxhighlight lang="bash">
tail -f /opt/client1/*.log                                                               
</syntaxhighlight>

<blockquote>
должно появиться тестовое сообщение
</blockquote>

=== Samba_attach_client ===

==== Установка пакетов на клиенте ====

<syntaxhighlight lang="bash">
apt-get update && apt-get install -y task-auth-ad-sssd                                   

</syntaxhighlight>

==== Запуск служб на клиенте ====

<syntaxhighlight lang="bash">
systemctl enable --now smb winbind sssd                                                  

</syntaxhighlight>

==== Содержимое /etc/krb5.conf на клиенте ====

<syntaxhighlight lang="bash">
[libdefaults]                                                                            
default_realm = AD.TEAM                                                                     
dns_lookup_kdc = true
dns_lookup_realm = false                                                                    
ticket_lifetime = 24h                                                                       
renew_lifetime = 7d                                                                         
forwardable = true                                                                          
rdns = false                                                                                
default_ccache_name = KEYRING:persistent:%{uid}                                             

</syntaxhighlight>

==== Установка пакетов на клиенте ====

<syntaxhighlight lang="bash">
apt-get update && apt-get install -y task-auth-ad-sssd                                   
</syntaxhighlight>

<blockquote>
task-auth-ad-sssd(метапакет для аутентификации в Active Directory через SSSD)
</blockquote>

==== Запуск служб на клиенте ====

<syntaxhighlight lang="bash">
systemctl enable --now smb winbind sssd
</syntaxhighlight>

<blockquote>
smb(Samba, интеграция с Windows-сетями); winbind(связь между Linux и AD); sssd(System Security Services Daemon, аутентификация и авторизация)
</blockquote>

==== Содержимое /etc/krb5.conf на клиенте ====

<syntaxhighlight lang="bash">
[libdefaults]
default_realm = AD.TEAM                                                                     
dns_lookup_kdc = true                                                                       
dns_lookup_realm = false                                                                    
ticket_lifetime = 24h                                                                       
renew_lifetime = 7d                                                                         
forwardable = true                                                                          
rdns = false                                                                                
default_ccache_name = KEYRING:persistent:%{uid}                                             

[realms]
AD.TEAM = {                                                                                 
kdc = 192.168.11.67                                                                     
default_domain = ad.team                                                                
admin_server = 192.168.11.67                                                            
}                                                                                           

[domain_realm]                                                                              
.ad.team = AD.TEAM                                                                          
ad.team = AD.TEAM                                                                           
</syntaxhighlight>

<blockquote>
[libdefaults](глобальные настройки Kerberos); default_realm(realm по умолчанию, должен быть в верхнем регистре); dns_lookup_kdc(искать KDC через DNS SRV-записи); dns_lookup_realm(искать realm через DNS TXT-записи); ticket_lifetime(время жизни билета аутентификации, формат: {Ns, Nm, Nh, Nd}); renew_lifetime(максимальное время продления билета без повторного ввода пароля); forwardable(разрешить передачу билета другим службам); rdns(reverse DNS lookup, отключить для избежания проблем с разрешением имён); default_ccache_name(расположение кеша учётных данных: KEYRING сохраняет в ядре, persistent сохраняется между сессиями, %{uid} подставляет UID пользователя)
</blockquote>

<blockquote>
[realms](описание конкретных realm); kdc(IP-адрес или hostname контроллера домена Key Distribution Center); default_domain(доменное имя в нижнем регистре); admin_server(сервер администрирования Kerberos для смены паролей)
</blockquote>

<blockquote>
[domain_realm](маппинг доменных имён на realm); .ad.team(поддомены домена); ad.team(сам домен); оба мапятся на realm AD.TEAM в верхнем регистре
</blockquote>

==== В /etc/resolv.conf на клиенте ====

<syntaxhighlight lang="bash">
domain ad.team
nameserver 192.168.11.67                                                                    
nameserver 192.168.33.67                                                                    
nameserver 8.8.8.8                                                                          
</syntaxhighlight>

<blockquote>
domain(доменный суффикс для поиска); nameserver(DNS-серверы); первым указывать IP контроллера домена для корректной работы DNS-запросов к AD
</blockquote>

==== Проверка Kerberos на клиенте ====

<syntaxhighlight lang="bash">
kinit administrator
klist                                                                                       
</syntaxhighlight>

<blockquote>
kinit(получить Kerberos-билет для пользователя, запросит пароль); klist(показать кешированные билеты с временем жизни и сроком действия)
</blockquote>

==== Присоединение к домену ====

<syntaxhighlight lang="bash">
net ads join -U administrator@AD.TEAM -S 192.168.11.67
</syntaxhighlight>

<blockquote>
net ads join(присоединить машину к домену Active Directory); -U(пользователь с правами присоединения к домену); -S(IP-адрес сервера AD)
</blockquote>

==== Дополнительно в ALT Linux можно воспользоваться GUI ====

<syntaxhighlight lang="bash">
apt-get install admc
</syntaxhighlight>

==== Запуск admc от root(также иметь билет Kerberos для administrator) ====
* Пользователи -> Аутентификация
* Домен Active Directory
** Домен(ad.team)
** Имя компьютера(hostname)
** SSSD(в единственном домене)
* Применить
** Имя пользователя(Administrator)
** Пароль(P@ssw0rd)
** ОК

<blockquote>
При успешном подключении будет уведомление "Добро пожаловать в домен"
</blockquote>

==== Проверка DNS на клиенте ====

<syntaxhighlight lang="bash">
host srv-hq  
host $(hostname)                                                                            
</syntaxhighlight>

<blockquote>
host(проверить разрешение DNS-имени); проверяет разрешение имени сервера и собственного hostname
</blockquote>

==== Перезагрузка клиента ====

<syntaxhighlight lang="bash">
reboot       
</syntaxhighlight>

<blockquote>
Применяет все изменения конфигурации
</blockquote>

==== Вход под доменным пользователем ====

<syntaxhighlight lang="bash">
su - username@AD.TEAM                                                                    
id                                                                                          
</syntaxhighlight>

<blockquote>
su - (переключиться на пользователя с загрузкой его окружения); id(показать UID, GID и группы пользователя) [realms]
</blockquote>

=== SAMBA_INTERNAL_samba ===

==== Установка Samba DC ====

==== Установка пакетов ====

<syntaxhighlight lang="bash">
apt-get update && apt-get install -y task-samba-dc                                       
</syntaxhighlight>

<blockquote>
task-samba-dc(Samba DC на базе Heimdal Kerberos)
</blockquote>

==== Остановка конфликтующих служб ====

<syntaxhighlight lang="bash">
for i in smb nmb krb5kdc slapd bind; do systemctl disable $i --now; done                 
</syntaxhighlight>

<blockquote>
Samba DC использует собственные LDAP и Kerberos
</blockquote>

==== Настройка имени узла и домена ====

==== В /etc/sysconfig/network ====

<syntaxhighlight lang="bash">
HOSTNAME=dc.domain.sample
</syntaxhighlight>

<blockquote>
dc.domain.sample(FQDN сервера); domain.sample(имя домена)
</blockquote>

==== Установка имени узла ====

<syntaxhighlight lang="bash">
hostnamectl set-hostname dc.domain.sample                                                  
exec bash                                                                                   
domainname domain.sample                                                                      
</syntaxhighlight>

<blockquote>
exec bash(перезагрузка оболочки для применения)
</blockquote>

==== В /etc/resolvconf.conf ====

<syntaxhighlight lang="bash">
nameserver 127.0.0.1                                                                     
</syntaxhighlight>

<blockquote>
для корректного распознавания локальных DNS-запросов
</blockquote>

==== Подготовка к созданию домена ====

==== Очистка баз и конфигурации Samba ====

<syntaxhighlight lang="bash">
rm -f /etc/samba/smb.conf
rm -rf /var/lib/samba                                                                       
rm -rf /var/cache/samba                                                                     
mkdir -p /var/lib/samba/sysvol                                                              
</syntaxhighlight>

<blockquote>
удаляет предыдущую конфигурацию домена
</blockquote>

==== Создание домена ====

==== Интерактивное создание домена ====

<syntaxhighlight lang="bash">
samba-tool domain provision
</syntaxhighlight>

<blockquote>
указать: доменное имя, рабочую группу, роль dc, бэкенд SAMBA_INTERNAL, DNS forwarder 77.88.8.8, пароль администратора
</blockquote>

==== Пакетное создание домена ====

<syntaxhighlight lang="bash">
samba-tool domain provision --realm=domain.sample --domain=domain --adminpass='P@ssw0rd'
--dns-backend=SAMBA_INTERNAL --option="dns forwarder=77.88.8.8" --server-role=dc            
--use-rfc2307   
</syntaxhighlight>

<blockquote>
--realm(имя области Kerberos и DNS домена); --domain(имя рабочей группы); --dns-backend(бэкенд DNS); --use-rfc2307(поддержка UID/GID и ACL)
</blockquote>

==== Запуск службы Samba ====

<syntaxhighlight lang="bash">
systemctl enable --now samba

</syntaxhighlight>

==== Копирование конфигурации Kerberos ====

<syntaxhighlight lang="bash">
cp /var/lib/samba/private/krb5.conf /etc/krb5.conf                                       
</syntaxhighlight>

<blockquote>
Samba создает шаблон krb5.conf при создании домена
</blockquote>

==== Проверка ====

==== Проверка статуса службы ====

<syntaxhighlight lang="bash">
systemctl status samba
</syntaxhighlight>

<blockquote>
служба должна быть active (running)
</blockquote>

==== Просмотр информации о домене ====

<syntaxhighlight lang="bash">
samba-tool domain info 127.0.0.1                                                         
</syntaxhighlight>

<blockquote>
показывает общую информацию о домене
</blockquote>

==== Просмотр общих ресурсов ====

<syntaxhighlight lang="bash">
smbclient -L localhost -U administrator                                                  
</syntaxhighlight>

<blockquote>
должны быть netlogon и sysvol
</blockquote>

==== Проверка DNS в /etc/resolv.conf ====

<syntaxhighlight lang="bash">
cat /etc/resolv.conf                                                                     
</syntaxhighlight>

<blockquote>
должен быть nameserver 127.0.0.1
</blockquote>

==== Проверка SRV-записи Kerberos ====

<syntaxhighlight lang="bash">
host -t SRV _kerberos._udp.domain.sample.                                                  
</syntaxhighlight>

<blockquote>
утилита host из пакета bind-utils
</blockquote>

==== Проверка SRV-записи LDAP ====

<syntaxhighlight lang="bash">
host -t SRV _ldap._tcp.domain.sample.                                                      
</syntaxhighlight>

<blockquote>
проверяет доступность LDAP
</blockquote>

==== Проверка A-записи хоста ====

<syntaxhighlight lang="bash">
host -t A dc.domain.sample.                                                                
</syntaxhighlight>

<blockquote>
должен вернуть IP-адрес контроллера домена
</blockquote>

==== Проверка Kerberos ====

<syntaxhighlight lang="bash">
kinit administrator@DOMAIN.SAMPLE                                                          
</syntaxhighlight>

<blockquote>
имя домена в верхнем регистре; запрашивает пароль администратора
</blockquote>

=== samba_share_folder ===

==== Настройка Samba для анонимного доступа ====

==== Создание общей директории ====

<syntaxhighlight lang="bash">
mkdir /opt/data                                                                          
chmod 777 /opt/data                                                                         
</syntaxhighlight>

<blockquote>
777(полные права для всех пользователей)
</blockquote>

==== В /etc/samba/smb.conf добавить секцию ====

<syntaxhighlight lang="bash">
[samba]                                                                                  
path = /opt/data                                                                            
browseable = yes                                                                            
writable = yes                                                                              
guest ok = yes                                                                              
read only = no                                                                              
force user = nobody                                                                         
</syntaxhighlight>

<blockquote>
guest ok = yes(анонимный доступ); force user(все действия от имени nobody)
</blockquote>

==== Перезапуск службы ====

<syntaxhighlight lang="bash">
systemctl restart smbd                                                                   

</syntaxhighlight>

==== Настройка Samba для пользователей домена ====

==== Создание общей директории ====

<syntaxhighlight lang="bash">
mkdir /opt/data
chmod 770 /opt/data                                                                         
chown root:domain_users /opt/data                                                           
</syntaxhighlight>

<blockquote>
770(доступ только владельцу и группе); domain_users(группа домена)
</blockquote>

==== В /etc/samba/smb.conf добавить секцию ====

<syntaxhighlight lang="bash">
[samba]                                                                                  
path = /opt/data                                                                            
browseable = yes                                                                            
writable = yes                                                                              
valid users = @domain_users                                                                 
read only = no                                                                              
create mask = 0660                                                                          
directory mask = 0770                                                                       
</syntaxhighlight>

<blockquote>
valid users = @domain_users(доступ только группе домена); create mask(права на новые файлы); directory mask(права на новые каталоги)
</blockquote>

==== Добавление пользователя Samba ====

<syntaxhighlight lang="bash">
smbpasswd -a username
</syntaxhighlight>

<blockquote>
создает пароль Samba для существующего системного пользователя
</blockquote>

==== Настройка Samba для конкретных пользователей ====

==== В /etc/samba/smb.conf добавить секцию ====

<syntaxhighlight lang="bash">
[samba]      
path = /opt/data                                                                            
browseable = yes                                                                            
writable = yes                                                                              
valid users = user1, user2, user3                                                           
read only = no                                                                              
write list = user1, user2                                                                   
</syntaxhighlight>

<blockquote>
valid users(список разрешенных пользователей); write list(пользователи с правом записи)
</blockquote>

==== Описание основных опций Samba ====

==== Опции доступа ====

<syntaxhighlight lang="bash">
browseable = yes
guest ok = yes                                                                              
valid users = user1, @group1                                                                
invalid users = user2                                                                       
read only = no                                                                              
writable = yes                                                                              
write list = user1, @group1                                                                 
read list = user2                                                                           
</syntaxhighlight>

<blockquote>
browseable(видимость в сети); guest ok(гостевой доступ); valid users(разрешенные пользователи/группы); invalid users(запрещенные); write list(право записи); read list(только чтение)
</blockquote>

==== Опции прав доступа ====

<syntaxhighlight lang="bash">
create mask = 0660
directory mask = 0770                                                                       
force user = nobody                                                                         
force group = nogroup                                                                       
inherit permissions = yes                                                                   
</syntaxhighlight>

<blockquote>
create mask(права на файлы); directory mask(права на каталоги); force user/group(принудительный владелец); inherit permissions(наследование прав)
</blockquote>

==== Опции безопасности ====

<syntaxhighlight lang="bash">
hosts allow = 192.168.1.0/24
hosts deny = 192.168.2.0/24                                                                 
max connections = 10                                                                        
</syntaxhighlight>

<blockquote>
hosts allow(разрешенные сети); hosts deny(запрещенные сети); max connections(лимит подключений)
</blockquote>

==== Проверка ====

==== Проверка конфигурации ====

<syntaxhighlight lang="bash">
testparm     
</syntaxhighlight>

<blockquote>
проверяет синтаксис smb.conf
</blockquote>

==== Просмотр активных подключений ====

<syntaxhighlight lang="bash">
smbstatus                                                                                
</syntaxhighlight>

<blockquote>
показывает подключенных пользователей и открытые файлы
</blockquote>

==== Подключение с клиента Windows ====

<syntaxhighlight lang="bash">
\\192.168.1.1\samba                                                                      
</syntaxhighlight>

<blockquote>
в проводнике Windows
</blockquote>

==== Подключение с клиента Linux ====

<syntaxhighlight lang="bash">
smb://192.168.1.1/samba                                                                  
</syntaxhighlight>

<blockquote>
в файловом менеджере или через smbclient
</blockquote>

=== SQL_install_MariaDB ===

==== Установка ====

==== Установка пакета ====

<syntaxhighlight lang="bash">
apt-get install -y mariadb-server                                                        

</syntaxhighlight>

==== Включение и запуск службы ====

<syntaxhighlight lang="bash">
systemctl enable --now mariadb

</syntaxhighlight>

==== Настройка MariaDB ====

==== Установка пароля root ====

<syntaxhighlight lang="bash">
mariadb -u root
ALTER USER 'root'@'localhost' IDENTIFIED BY 'P@ssw0rd';
EXIT;

</syntaxhighlight>

==== Разрешение доступа из сети в /etc/my.cnf.d/server.cnf ====

<syntaxhighlight lang="bash">
sed -i "s/skip-networking/#skip-networking/g" /etc/my.cnf.d/server.cnf

</syntaxhighlight>

==== Перезапуск службы ====

<syntaxhighlight lang="bash">
systemctl restart mariadb                                                                

</syntaxhighlight>

==== Разрешение доступа для root по сети ====

<syntaxhighlight lang="bash">
mariadb -u root -p                                                                       
GRANT ALL PRIVILEGES ON *.* TO 'root'@'localhost';                                          
UPDATE mysql.user SET host='%' WHERE user='root';                                           
FLUSH PRIVILEGES;                                                                           
EXIT;                                                                                       
</syntaxhighlight>

<blockquote>
host='%' разрешает подключение с любого узла
</blockquote>

==== Перезапуск службы ====

<syntaxhighlight lang="bash">
systemctl restart mariadb                                                                

</syntaxhighlight>

==== Проверка MariaDB ====

==== Проверка пользователей на сервере ====

<syntaxhighlight lang="bash">
mariadb -u root -p                                                                       
SELECT user, HOST FROM mysql.user;                                                          
EXIT;                                                                                       

</syntaxhighlight>

==== Удаленное подключение с клиента ====

<syntaxhighlight lang="bash">
mariadb -h IP_СЕРВЕРА -u root -p

</syntaxhighlight>

==== Создание БД и пользователей ====

==== Создание базы данных ====

<syntaxhighlight lang="bash">
mariadb -u root -p                                                                       
CREATE DATABASE db01;                                                                       
</syntaxhighlight>

<blockquote>
db01 - имя создаваемой БД
</blockquote>

==== Создание пользователя ====

<syntaxhighlight lang="bash">
CREATE USER 'user01'@'%' IDENTIFIED BY 'P@ssw0rd';                                       
</syntaxhighlight>

<blockquote>
'%' означает подключение с любого хоста
</blockquote>

==== Предоставление прав пользователю ====

<syntaxhighlight lang="bash">
GRANT ALL PRIVILEGES ON db01.* TO 'user01'@'%';                                          
FLUSH PRIVILEGES;                                                                           

</syntaxhighlight>

==== Проверка существования БД и пользователей ====

<syntaxhighlight lang="bash">
SHOW DATABASES;                                                                          
SELECT user, HOST FROM mysql.user;                                                          
EXIT;
</syntaxhighlight>

